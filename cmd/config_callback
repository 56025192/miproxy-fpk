#!/bin/bash
# MiProxy 安装回调 v9.1
# 修复 extract_yaml_block 函数，正确处理 YAML 文档分隔符

set -e
TRIM_PKGVAR="${TRIM_APPDEST}/var"
TRIM_PKGETC="${TRIM_APPDEST}/etc"
DEBUG_LOG="${TRIM_PKGVAR}/install_callback.log"

exec 2>>"${DEBUG_LOG}"
echo "===== config_callback v8.1 开始: $(date '+%Y-%m-%d %H:%M:%S') =====" >> "${DEBUG_LOG}"

mkdir -p "${TRIM_PKGVAR}/proxy_providers"

VAR_DIR="${TRIM_PKGVAR}"
UI_TARGET="${VAR_DIR}/ui"
LOG_FILE="${VAR_DIR}/info.log"
CONFIG_FILE="${VAR_DIR}/config.yaml"

HTTP_PORT="${wizard_http_port:-7890}"
API_PORT="${wizard_api_port:-9090}"
TUN_ENABLE="${wizard_tun_enable:-false}"
SUB_TYPE="${wizard_sub_type:-none}"
SUB_URL="${wizard_sub_url:-}"
SUB_PATH="${wizard_sub_path:-}"
REFRESH_INTERVAL_HOURS="${wizard_refresh_interval:-1}"
PROXY_USER="${wizard_proxy_user:-}"
PROXY_PASS="${wizard_proxy_pass:-}"
SECRET="${wizard_secret:-}"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1"
}

log_msg "config_callback v8.1 启动"
log_msg "  HTTP_PORT=${HTTP_PORT}, API_PORT=${API_PORT}"
log_msg "  SUB_TYPE=${SUB_TYPE}, SUB_URL=${SUB_URL}, SUB_PATH=${SUB_PATH}"

# 提取订阅域名
if [ "${SUB_TYPE}" = "remote" ] && [ -n "${SUB_URL}" ]; then
    SUB_DOMAIN=$(echo "${SUB_URL}" | sed -E 's|^https?://||; s|/.*$||; s|:.*$||')
    log_msg "  提取订阅域名: ${SUB_DOMAIN}"
fi

log_msg "复制 mihomo 核心..."
cp -f "${TRIM_APPDEST}/server/mihomo" "${VAR_DIR}/target/" 2>/dev/null || true
chmod +x "${VAR_DIR}/target/mihomo"

SUB_CACHE_PATH="${VAR_DIR}/proxy_providers/subscription.yaml"
[ "${SUB_TYPE}" = "remote" ] && [ -n "${SUB_URL}" ] && {
    log_msg "下载远程订阅: ${SUB_URL}"
    if curl -fsSL --connect-timeout 15 --max-time 60 "${SUB_URL}" -o "${SUB_CACHE_PATH}.tmp" 2>>"${DEBUG_LOG}"; then
        mv "${SUB_CACHE_PATH}.tmp" "${SUB_CACHE_PATH}"
        log_msg "  ✅ 订阅下载成功: $(stat -c%s "${SUB_CACHE_PATH}" 2>/dev/null || wc -c < "${SUB_CACHE_PATH}") bytes"
    else
        log_msg "  ⚠️ 订阅下载失败"
        rm -f "${SUB_CACHE_PATH}.tmp"
    fi
}
[ "${SUB_TYPE}" = "local" ] && [ -n "${SUB_PATH}" ] && [ -f "${SUB_PATH}" ] && cp -f "${SUB_PATH}" "${SUB_CACHE_PATH}"

# ========== 修复版 YAML 块提取函数 ==========
extract_yaml_block() {
    python3 - "$1" "$2" 2>/dev/null <<'PYEOF'
import sys
key = sys.argv[1] + ":"
try:
    with open(sys.argv[2], 'r', encoding='utf-8') as f:
        content = f.read()
except:
    sys.exit(0)

# 清理 YAML 文档分隔符
content = content.replace('\n---\n', '\n').replace('^---', '').lstrip('---').rstrip('---')

lines = content.split('\n')
result = []
found = False
base_indent = None

for line in lines:
    if line.strip().startswith('---'):
        if found:
            break
        continue
    
    if not line.strip():
        if found:
            result.append(line)
        continue
    
    # 确定缩进级别
    indent = len(line) - len(line.lstrip())
    
    if not found:
        if line.strip().startswith(key):
            found = True
            base_indent = indent
            result.append(line)
        continue
    
    # 如果遇到同级或更外层的顶级 key，停止
    if indent <= base_indent and line.strip() and not line.strip().startswith('-'):
        if line.strip().startswith(key.replace(':', '')):
            break
        # 检查是否是顶级 key（不在列表中）
        stripped = line.strip()
        if not stripped.startswith('-') and not stripped.startswith('#'):
            if base_indent is not None and indent <= base_indent:
                break
    
    result.append(line)

sys.stdout.write('\n'.join(result))
PYEOF
}

# 读取订阅配置
SUB_PROXIES=""; SUB_HOSTS=""; SUB_PG=""; SUB_RULES=""; SUB_DNS=""
SUB_BYPASS=""; SUB_PROXY_PROVIDERS=""; SUB_RULE_PROVIDERS=""

if [ -f "${SUB_CACHE_PATH}" ]; then
    SUB_PROXIES=$(extract_yaml_block "proxies" "${SUB_CACHE_PATH}")
    SUB_HOSTS=$(extract_yaml_block "hosts" "${SUB_CACHE_PATH}")
    SUB_PG=$(extract_yaml_block "proxy-groups" "${SUB_CACHE_PATH}")
    SUB_RULES=$(extract_yaml_block "rules" "${SUB_CACHE_PATH}")
    SUB_DNS=$(extract_yaml_block "dns" "${SUB_CACHE_PATH}")
    SUB_BYPASS=$(extract_yaml_block "bypass" "${SUB_CACHE_PATH}")
    SUB_PROXY_PROVIDERS=$(extract_yaml_block "proxy-providers" "${SUB_CACHE_PATH}")
    SUB_RULE_PROVIDERS=$(extract_yaml_block "rule-providers" "${SUB_CACHE_PATH}")
    
    log_msg "  📦 字段同步统计:"
    log_msg "      proxies:$(printf '%s' "${SUB_PROXIES}" | wc -l)行"
    log_msg "      proxy-groups:$(printf '%s' "${SUB_PG}" | wc -l)行"
    log_msg "      rules:$(printf '%s' "${SUB_RULES}" | wc -l)行"
fi

log_msg "生成 config.yaml..."

{
    echo "# MiProxy 主配置"
    echo ""
    echo "mixed-port: ${HTTP_PORT}"
    echo "allow-lan: true"
    echo "mode: rule"
    echo "log-level: info"
    echo "ipv6: false"
    echo "external-controller: 0.0.0.0:${API_PORT}"
    echo "external-ui: ${UI_TARGET}"
    echo "external-ui-name: zashboard"
    [ -n "${SECRET}" ] && echo "secret: \"${SECRET}\""
    echo "external-controller-cors:"
    echo "  allow-private-network: true"
    echo "  allow-origins: [\"*\"]"
    echo "geodata-mode: true"
    echo "geodata-loader: memconservative"
    echo "tun:"
    echo "  enable: ${TUN_ENABLE}"
    echo "  stack: system"
    
    if [ -n "${SUB_PROXIES}" ]; then
        echo "proxies:"
        echo "${SUB_PROXIES}"
    fi
    if [ -n "${SUB_HOSTS}" ]; then
        echo "hosts:"
        echo "${SUB_HOSTS}"
    fi
    if [ -n "${SUB_PG}" ]; then
        echo "proxy-groups:"
        echo "${SUB_PG}"
    else
        echo "proxy-groups:"
        echo "  - name: PROXY; type: select; proxies: [DIRECT]"
    fi
    if [ -n "${SUB_RULES}" ]; then
        echo "rules:"
        echo "${SUB_RULES}"
    else
        echo "rules:"
        echo "  - GEOIP,CN,DIRECT"
        echo "  - MATCH,PROXY"
    fi
    if [ -n "${SUB_DNS}" ]; then
        echo "dns:"
        echo "${SUB_DNS}"
    else
        echo "dns:"
        echo "  enable: true"
        echo "  listen: 0.0.0.0:53"
        echo "  enhanced-mode: fake-ip"
        echo "  fake-ip-range: 198.18.0.1/16"
        echo "  fake-ip-filter:"
        echo "    - \"+.lan\""
        echo "    - \"+.local\""
        echo "  nameserver:"
        echo "    - 223.5.5.5"
        echo "    - 119.29.29.29"
    fi
    if [ -n "${SUB_BYPASS}" ]; then
        echo "bypass:"
        echo "${SUB_BYPASS}"
    fi
    if [ -n "${SUB_PROXY_PROVIDERS}" ]; then
        echo "proxy-providers:"
        echo "${SUB_PROXY_PROVIDERS}"
    fi
    if [ -n "${SUB_RULE_PROVIDERS}" ]; then
        echo "rule-providers:"
        echo "${SUB_RULE_PROVIDERS}"
    fi
} > "${CONFIG_FILE}"

chmod 666 "${CONFIG_FILE}"
log_msg "✅ config.yaml 已生成"

log_msg "启动 miproxy..."
pkill -f "mihomo.*${CONFIG_FILE}" 2>/dev/null || true
sleep 1

if [ -x "${VAR_DIR}/target/mihomo" ]; then
    nohup bash -c "${VAR_DIR}/target/mihomo -d ${VAR_DIR} -f ${CONFIG_FILE}" >> "${LOG_FILE}" 2>&1 &
    sleep 4
    
    if pgrep -f "mihomo.*${CONFIG_FILE}" > /dev/null; then
        log_msg "✅ miproxy 启动成功"
    else
        log_msg "❌ miproxy 启动失败，请检查日志"
    fi
else
    log_msg "⚠️ mihomo 二进制不存在"
fi

log_msg "启动订阅刷新守护进程 (间隔: ${REFRESH_INTERVAL_HOURS} 小时)..."
nohup bash "${TRIM_APP}/cmd/refresh.sh" "${REFRESH_INTERVAL_HOURS}" >> "${LOG_FILE}" 2>&1 &

log_msg "===== config_callback v8.1 完成 ====="
exit 0
