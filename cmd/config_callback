#!/bin/bash

# MiProxy 配置变更回调
# 用户在 fnOS 应用设置面板修改：
#   - 用户验证（wizard_username, wizard_password）
#   - 控制面板选择（wizard_panel）
#   - 远程订阅 URL（wizard_sub_url）
#   - 本地订阅路径（wizard_sub_path）
# 自动应用变更并重启 miproxy

set -e

APP_DEST="${TRIM_APPDEST}"
VAR_DIR="${TRIM_PKGVAR}"
UI_TARGET="${VAR_DIR}/ui"
LOG_FILE="${VAR_DIR}/info.log"

USERNAME="${wizard_username:-}"
PASSWORD="${wizard_password:-}"
PANEL="${wizard_panel:-zashboard}"
SUB_URL="${wizard_sub_url:-}"
SUB_PATH="${wizard_sub_path:-}"
REFRESH_INTERVAL_HOURS="${wizard_refresh_interval:-6}"
if [ "${REFRESH_INTERVAL_HOURS}" = "0" ]; then
    REFRESH_INTERVAL_SEC=0
else
    REFRESH_INTERVAL_SEC=$((REFRESH_INTERVAL_HOURS * 3600))
fi

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

log_msg "config_callback: 收到配置更新请求"
log_msg "  wizard_username=${USERNAME}"
log_msg "  wizard_panel=${PANEL}"
log_msg "  wizard_sub_url=${SUB_URL}"
log_msg "  wizard_sub_path=${SUB_PATH}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

NEED_RESTART=0

# === 1. 处理控制面板切换 ===
if [ -f "${UI_TARGET}/config" ]; then
    CURRENT_PANEL=$(grep -o '"miproxy\.dashboard"' "${UI_TARGET}/config" 2>/dev/null || true)
    # 检查 URL 是否需要更新
    case "${PANEL}" in
    zashboard)
        TARGET_URL="/ui/zashboard/"
        ;;
    metacubexd)
        TARGET_URL="/ui/metacubexd/"
        ;;
    *)
        TARGET_URL="/ui/zashboard/"
        ;;
    esac
    
    # 检查当前配置的 URL
    CURRENT_URL=$(grep -o '"url": "[^"]*"' "${UI_TARGET}/config" 2>/dev/null | sed 's/"url": "//;s/"//' | head -1)
    
    if [ "${CURRENT_URL}" != "${TARGET_URL}" ]; then
        log_msg "切换控制面板: ${CURRENT_URL} -> ${TARGET_URL}"
        # 更新 ui/config 中的 URL
        sed -i "s|\"url\": \"[^\"]*\"|\"url\": \"${TARGET_URL}\"|g" "${UI_TARGET}/config"
        chmod 666 "${UI_TARGET}/config"
        log_msg "控制面板切换完成"
        # 不需要重启 miproxy，只需要刷新桌面入口即可
    fi
fi

# === 2. 处理用户验证更新 ===
if [ -f "${VAR_DIR}/base.yaml" ]; then
    if [ -n "${USERNAME}" ] && [ -n "${PASSWORD}" ]; then
        # 添加/更新验证
        NEW_AUTH_LINE="  - \"${USERNAME}:${PASSWORD}\""
        # 移除旧配置
        sed -i '/^# 用户验证/d' "${VAR_DIR}/base.yaml" 2>/dev/null || true
        sed -i '/^authentication:/d' "${VAR_DIR}/base.yaml" 2>/dev/null || true
        sed -i '/^  - "/d' "${VAR_DIR}/base.yaml" 2>/dev/null || true
        # 添加新配置
        sed -i "/^secret:/a\\
# 用户验证\\
authentication:\\
${NEW_AUTH_LINE}" "${VAR_DIR}/base.yaml"
        log_msg "已更新用户验证: ${USERNAME}"
        NEED_RESTART=1
    elif [ -z "${USERNAME}" ] && [ -z "${PASSWORD}" ]; then
        # 移除验证
        sed -i '/^# 用户验证/d' "${VAR_DIR}/base.yaml" 2>/dev/null || true
        sed -i '/^authentication:/d' "${VAR_DIR}/base.yaml" 2>/dev/null || true
        sed -i '/^  - "/d' "${VAR_DIR}/base.yaml" 2>/dev/null || true
        log_msg "已移除用户验证"
        NEED_RESTART=1
    fi
fi

# === 3. 处理订阅更新 ===
SUB_FILE="${VAR_DIR}/subscription.yaml"
SUB_CHANGED=0

if [ -n "${SUB_URL}" ]; then
    log_msg "下载远程订阅: ${SUB_URL}"
    if curl -fsSL --max-time 30 "${SUB_URL}" -o "${SUB_FILE}.tmp"; then
        mv "${SUB_FILE}.tmp" "${SUB_FILE}"
        log_msg "远程订阅更新成功"
        SUB_CHANGED=1
    else
        rm -f "${SUB_FILE}.tmp"
        log_msg "远程订阅下载失败"
        echo "远程订阅下载失败，请检查 URL 是否正确、网络是否可达" > "${TRIM_TEMP_LOGFILE:-/tmp/miproxy_config_err.log}"
        exit 1
    fi
elif [ -n "${SUB_PATH}" ]; then
    if [ -f "${SUB_PATH}" ]; then
        if [ "${SUB_PATH}" != "${SUB_FILE}" ]; then
            log_msg "复制本地订阅: ${SUB_PATH}"
            if cp -f "${SUB_PATH}" "${SUB_FILE}" 2>>"${LOG_FILE}"; then
                SUB_CHANGED=1
            else
                log_msg "复制订阅失败"
                echo "复制订阅失败: ${SUB_PATH}" > "${TRIM_TEMP_LOGFILE:-/tmp/miproxy_config_err.log}"
                exit 1
            fi
        else
            log_msg "源和目标相同，跳过复制"
        fi
    else
        log_msg "本地订阅文件不存在: ${SUB_PATH}"
        echo "本地订阅文件不存在: ${SUB_PATH}" > "${TRIM_TEMP_LOGFILE:-/tmp/miproxy_config_err.log}"
        exit 1
    fi
fi

if [ "${SUB_CHANGED}" = "1" ]; then
    chmod 666 "${SUB_FILE}"
    NEED_RESTART=1
fi

# === 4. 重新生成主配置 ===
if [ "${NEED_RESTART}" = "1" ]; then
    log_msg "重新生成主配置 config.yaml..."
    python3 "${SCRIPT_DIR}/merge_config.py" "${VAR_DIR}/base.yaml" "${SUB_FILE}" "${VAR_DIR}/config.yaml"
    chmod 666 "${VAR_DIR}/config.yaml"
    log_msg "主配置已更新"

    # === 5. 重启 miproxy ===
    log_msg "重启 miproxy..."
    bash "${SCRIPT_DIR}/main" stop 2>/dev/null || true
    sleep 2
    bash "${SCRIPT_DIR}/main" start
    log_msg "miproxy 重启完成"
else
    log_msg "无变更，跳过重启"
fi

# === 6. 更新守护进程配置 ===
log_msg "更新订阅刷新守护进程配置..."
if [ -n "${SUB_URL}" ]; then
    CURRENT_SUB_TYPE="remote"
elif [ -n "${SUB_PATH}" ]; then
    CURRENT_SUB_TYPE="local"
else
    CURRENT_SUB_TYPE="none"
fi

{
    echo "SUBSCRIPTION_TYPE=${CURRENT_SUB_TYPE}"
    echo "SUBSCRIPTION_URL=${SUB_URL}"
    echo "SUBSCRIPTION_PATH=${SUB_PATH}"
    echo "REFRESH_INTERVAL=${REFRESH_INTERVAL_SEC}"
} > "${VAR_DIR}/refresh_subscription.conf"
chmod 666 "${VAR_DIR}/refresh_subscription.conf"
log_msg "守护进程配置已更新 (interval=${REFRESH_INTERVAL_SEC}s, type=${CURRENT_SUB_TYPE})"

# 重启守护进程
bash "${SCRIPT_DIR}/main" restart-refresh 2>>"${LOG_FILE}" || log_msg "守护进程重启失败（不影响主程序）"

exit 0
