#!/bin/bash
# 配置变更后回调
# 功能：配置变更后重启服务使配置生效
#

set +e

# 路径配置
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "[$(date '+%Y-%m-%d %H:%M:%S')] config_callback: 配置已更新，重启服务..."

# 重启服务
bash "${SCRIPT_DIR}/main" restart 2>/dev/null || true

echo "[$(date '+%Y-%m-%d %H:%M:%S')] config_callback: 配置更新完成"
exit 0
