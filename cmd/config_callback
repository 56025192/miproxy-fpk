#!/bin/bash

# MiProxy 配置变更回调

set -e

APP_DEST="${TRIM_APPDEST}"
VAR_DIR="${TRIM_PKGVAR}"
UI_TARGET="${VAR_DIR}/ui"
LOG_FILE="${VAR_DIR}/info.log"

PROXY_USER="${wizard_proxy_user:-}"
PROXY_PASS="${wizard_proxy_pass:-}"
SECRET="${wizard_secret:-}"
SUB_URL="${wizard_sub_url:-}"
SUB_PATH="${wizard_sub_path:-}"
REFRESH_INTERVAL_HOURS="${wizard_refresh_interval:-6}"
if [ "${REFRESH_INTERVAL_HOURS}" = "0" ]; then
    REFRESH_INTERVAL_SEC=0
else
    REFRESH_INTERVAL_SEC=$((REFRESH_INTERVAL_HOURS * 3600))
fi

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

log_msg "config_callback: 收到配置更新请求"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

NEED_RESTART=0

# === 处理 base.yaml 更新 ===
if [ -f "${VAR_DIR}/base.yaml" ]; then
    # 更新 secret
    sed -i "s/^secret: \"[^\"]*\"/secret: \"${SECRET}\"/" "${VAR_DIR}/base.yaml"
    
    # 更新 authentication
    if [ -n "${PROXY_USER}" ] && [ -n "${PROXY_PASS}" ]; then
        # 移除旧的 authentication
        sed -i '/^authentication:/d' "${VAR_DIR}/base.yaml" 2>/dev/null || true
        sed -i '/^  - "/d' "${VAR_DIR}/base.yaml" 2>/dev/null || true
        # 添加新的 authentication
        sed -i "/^secret:/a\\
authentication:\\
  - \"${PROXY_USER}:${PROXY_PASS}\"" "${VAR_DIR}/base.yaml"
        log_msg "已更新代理用户验证: ${PROXY_USER}"
        NEED_RESTART=1
    fi
fi

# === 处理订阅更新 ===
SUB_FILE="${VAR_DIR}/subscription.yaml"

if [ -n "${SUB_URL}" ]; then
    log_msg "下载远程订阅: ${SUB_URL}"
    if curl -fsSL --max-time 30 "${SUB_URL}" -o "${SUB_FILE}.tmp"; then
        mv "${SUB_FILE}.tmp" "${SUB_FILE}"
        log_msg "远程订阅更新成功"
        chmod 666 "${SUB_FILE}"
        NEED_RESTART=1
    else
        rm -f "${SUB_FILE}.tmp"
        log_msg "远程订阅下载失败"
        echo "远程订阅下载失败" > "${TRIM_TEMP_LOGFILE:-/tmp/miproxy_config_err.log}"
        exit 1
    fi
elif [ -n "${SUB_PATH}" ]; then
    if [ -f "${SUB_PATH}" ]; then
        if [ "${SUB_PATH}" != "${SUB_FILE}" ]; then
            cp -f "${SUB_PATH}" "${SUB_FILE}"
            chmod 666 "${SUB_FILE}"
            log_msg "复制本地订阅: ${SUB_PATH}"
            NEED_RESTART=1
        fi
    else
        log_msg "本地订阅文件不存在: ${SUB_PATH}"
        echo "本地订阅文件不存在" > "${TRIM_TEMP_LOGFILE:-/tmp/miproxy_config_err.log}"
        exit 1
    fi
fi

# === 重新生成主配置 ===
if [ "${NEED_RESTART}" = "1" ]; then
    log_msg "重新生成主配置 config.yaml..."
    python3 "${SCRIPT_DIR}/merge_config.py" "${VAR_DIR}/base.yaml" "${SUB_FILE}" "${VAR_DIR}/config.yaml"
    chmod 666 "${VAR_DIR}/config.yaml"

    log_msg "重启 miproxy..."
    bash "${SCRIPT_DIR}/main" stop 2>/dev/null || true
    sleep 2
    bash "${SCRIPT_DIR}/main" start
    log_msg "miproxy 重启完成"
fi

# === 更新守护进程配置 ===
log_msg "更新订阅刷新守护进程配置..."
if [ -n "${SUB_URL}" ]; then
    CURRENT_SUB_TYPE="remote"
elif [ -n "${SUB_PATH}" ]; then
    CURRENT_SUB_TYPE="local"
else
    CURRENT_SUB_TYPE="none"
fi

{
    echo "SUBSCRIPTION_TYPE=${CURRENT_SUB_TYPE}"
    echo "SUBSCRIPTION_URL=${SUB_URL}"
    echo "SUBSCRIPTION_PATH=${SUB_PATH}"
    echo "REFRESH_INTERVAL=${REFRESH_INTERVAL_SEC}"
} > "${VAR_DIR}/refresh_subscription.conf"
chmod 666 "${VAR_DIR}/refresh_subscription.conf"

bash "${SCRIPT_DIR}/main" restart-refresh 2>>"${LOG_FILE}" || log_msg "守护进程重启失败"

exit 0
