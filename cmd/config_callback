#!/bin/bash

# MiProxy 配置变更回调
# 使用 mihomo proxy-providers 机制：订阅 URL 直接写入配置，mihomo 自动获取和解码

set -e

APP_DEST="${TRIM_APPDEST}"
VAR_DIR="${TRIM_PKGVAR}"
UI_TARGET="${VAR_DIR}/ui"
LOG_FILE="${VAR_DIR}/info.log"

PROXY_USER="${wizard_proxy_user:-}"
PROXY_PASS="${wizard_proxy_pass:-}"
SECRET="${wizard_secret:-}"
SUB_URL="${wizard_sub_url:-}"
SUB_PATH="${wizard_sub_path:-}"
REFRESH_INTERVAL_HOURS="${wizard_refresh_interval:-6}"
TUN_ENABLE="${wizard_tun_enable:-false}"

if [ "${REFRESH_INTERVAL_HOURS}" = "0" ]; then
    REFRESH_INTERVAL_SEC=0
else
    REFRESH_INTERVAL_SEC=$((REFRESH_INTERVAL_HOURS * 3600))
fi

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

log_msg "config_callback: 收到配置更新请求"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

NEED_RESTART=0

# === 处理 base.yaml 更新 ===

remove_auth_block() {
    local file="$1"
    sed -i ':a;N;$!ba;s/\nauthentication:\([[:space:]]*\n[[:space:]]*- "[^"]*"\)\+//g' "${file}" 2>/dev/null || true
}

if [ -f "${VAR_DIR}/base.yaml" ]; then
    # 更新 secret
    if [ -n "${SECRET}" ]; then
        sed -i "s/^secret: \"[^\"]*\"/secret: \"${SECRET}\"/" "${VAR_DIR}/base.yaml"
        log_msg "已更新控制面板密钥"
        NEED_RESTART=1
    else
        sed -i 's/^secret: "[^"]*"/secret: ""/' "${VAR_DIR}/base.yaml"
        log_msg "已清空控制面板密钥"
        NEED_RESTART=1
    fi

    # 处理 authentication
    if [ -z "${PROXY_USER}" ] && [ -z "${PROXY_PASS}" ]; then
        remove_auth_block "${VAR_DIR}/base.yaml"
        log_msg "已清空代理用户验证"
        NEED_RESTART=1
    elif [ -n "${PROXY_USER}" ] && [ -n "${PROXY_PASS}" ]; then
        AUTH_PASS_FILE="${VAR_DIR}/.auth_tmp_$$"
        printf '%s' "${PROXY_PASS}" > "${AUTH_PASS_FILE}"
        chmod 600 "${AUTH_PASS_FILE}"
        remove_auth_block "${VAR_DIR}/base.yaml"
        local auth_val="${PROXY_USER}:$(cat "${AUTH_PASS_FILE}")"
        sed -i "/^secret:/a\\
authentication:\\
  - \"${auth_val}\"" "${VAR_DIR}/base.yaml"
        rm -f "${AUTH_PASS_FILE}"
        log_msg "已更新代理用户验证: ${PROXY_USER}"
        NEED_RESTART=1
    fi

    # 处理 TUN 配置
    if grep -q "^tun:" "${VAR_DIR}/base.yaml"; then
        if grep -q "^  enable:" "${VAR_DIR}/base.yaml"; then
            OLD_TUN=$(grep "^  enable:" "${VAR_DIR}/base.yaml" | awk '{print $2}')
            if [ "${OLD_TUN}" != "${TUN_ENABLE}" ]; then
                sed -i "s/^  enable: .*/  enable: ${TUN_ENABLE}/" "${VAR_DIR}/base.yaml"
                log_msg "已更新 TUN 配置: enable=${TUN_ENABLE}"
                NEED_RESTART=1
            fi
        else
            sed -i "/^tun:/a\  enable: ${TUN_ENABLE}" "${VAR_DIR}/base.yaml"
            log_msg "已添加 TUN 配置: enable=${TUN_ENABLE}"
            NEED_RESTART=1
        fi
    fi
fi

# === 处理订阅配置（使用 proxy-providers + dns）===
SUB_FILE="${VAR_DIR}/subscription.yaml"

log_msg "更新订阅配置..."
log_msg "  SUB_URL: ${SUB_URL:-（未设置）}"
log_msg "  SUB_PATH: ${SUB_PATH:-（未设置）}"
log_msg "  REFRESH_INTERVAL: ${REFRESH_INTERVAL_SEC}s"

# DNS 配置模板
DNS_CONFIG='dns:
  enable: true
  listen: 0.0.0.0:53
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - "+.lan"
    - "+.local"
  nameserver:
    - 223.5.5.5
    - 119.29.29.29
  fallback:
    - 8.8.8.8
    - 1.1.1.1'

# 始终重新生成订阅配置（核心修复）
build_subscription_config() {
    local sub_url="$1"
    local sub_path="$2"
    local refresh_interval="$3"
    
    if [ -n "${sub_url}" ]; then
        # 远程订阅
        log_msg "配置远程订阅: ${sub_url}"
        cat > "${SUB_FILE}" << EOF
# 订阅配置 - 使用 proxy-providers 机制

proxy-providers:
  remote-sub:
    type: http
    url: "${sub_url}"
    path: ./proxy_providers/remote-sub.yaml
    interval: ${refresh_interval}
    health-check:
      enable: true
      url: https://www.gstatic.com/generate_204
      interval: 300

proxy-groups:
  - name: PROXY
    type: select
    proxies:
      - DIRECT
      - provider:remote-sub

rules:
  - MATCH,PROXY

# DNS 配置
${DNS_CONFIG}
EOF
        log_msg "已生成远程订阅配置 (proxy-providers + dns)"
    elif [ -n "${sub_path}" ]; then
        # 本地订阅
        log_msg "配置本地订阅: ${sub_path}"
        if [ -f "${sub_path}" ]; then
            cat > "${SUB_FILE}" << EOF
# 订阅配置 - 本地文件

proxy-providers:
  local-sub:
    type: file
    path: "${sub_path}"
    interval: ${refresh_interval}
    health-check:
      enable: true
      url: https://www.gstatic.com/generate_204
      interval: 300

proxy-groups:
  - name: PROXY
    type: select
    proxies:
      - DIRECT
      - provider:local-sub

rules:
  - MATCH,PROXY

# DNS 配置
${DNS_CONFIG}
EOF
            log_msg "已生成订阅配置 (proxy-providers + dns)"
        else
            log_msg "本地订阅文件不存在，使用空订阅"
            cat > "${SUB_FILE}" << EOF
# 订阅配置 - 本地文件不存在

proxy-providers:
  local-sub:
    type: file
    path: "${sub_path}"
    interval: ${refresh_interval}
    health-check:
      enable: false

proxy-groups:
  - name: PROXY
    type: select
    proxies:
      - DIRECT

rules:
  - MATCH,PROXY

# DNS 配置
${DNS_CONFIG}
EOF
        fi
    else
        # 清空订阅
        log_msg "清空订阅配置"
        cat > "${SUB_FILE}" << EOF
# 订阅配置 - 暂未配置订阅
# 稍后可在控制面板中添加订阅

proxy-providers:
  remote-sub:
    type: http
    url: ""
    path: ./proxy_providers/remote-sub.yaml
    interval: ${refresh_interval}
    health-check:
      enable: false

proxy-groups:
  - name: PROXY
    type: select
    proxies:
      - DIRECT

rules:
  - MATCH,PROXY

# DNS 配置
${DNS_CONFIG}
EOF
    fi
    
    chmod 666 "${SUB_FILE}"
}

# 始终重新生成订阅配置
build_subscription_config "${SUB_URL}" "${SUB_PATH}" "${REFRESH_INTERVAL_SEC}"
NEED_RESTART=1

# === 重新生成主配置 ===
if [ "${NEED_RESTART}" = "1" ]; then
    log_msg "重新生成主配置 config.yaml..."
    
    # 停止守护进程
    log_msg "停止订阅刷新守护进程..."
    bash "${SCRIPT_DIR}/main" stop-refresh 2>>"${LOG_FILE}" || true
    sleep 1
    
    # 合并配置
    python3 "${SCRIPT_DIR}/merge_config.py" "${VAR_DIR}/base.yaml" "${SUB_FILE}" "${VAR_DIR}/config.yaml"
    chmod 666 "${VAR_DIR}/config.yaml"

    log_msg "重启 miproxy..."
    bash "${SCRIPT_DIR}/main" stop 2>/dev/null || true
    sleep 2
    bash "${SCRIPT_DIR}/main" start
    sleep 1
    log_msg "miproxy 重启完成"
fi

# === 更新守护进程配置 ===
log_msg "更新订阅刷新守护进程配置..."
if [ -n "${SUB_URL}" ]; then
    CURRENT_SUB_TYPE="remote"
elif [ -n "${SUB_PATH}" ]; then
    CURRENT_SUB_TYPE="local"
else
    CURRENT_SUB_TYPE="none"
fi

{
    echo "SUBSCRIPTION_TYPE=${CURRENT_SUB_TYPE}"
    echo "SUBSCRIPTION_URL=${SUB_URL}"
    echo "SUBSCRIPTION_PATH=${SUB_PATH}"
    echo "REFRESH_INTERVAL=${REFRESH_INTERVAL_SEC}"
} > "${VAR_DIR}/refresh_subscription.conf"
chmod 666 "${VAR_DIR}/refresh_subscription.conf"

# 启动/重启守护进程
sleep 2
log_msg "启动订阅刷新守护进程..."
bash "${SCRIPT_DIR}/main" start-refresh 2>>"${LOG_FILE}" || log_msg "守护进程启动失败"

log_msg "config_callback 完成"
exit 0