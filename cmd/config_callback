#!/bin/bash

# MiProxy 配置变更回调
# 用户在 fnOS 应用设置面板修改：
#   - 控制面板（wizard_dashboard）
#   - 远程订阅 URL（wizard_sub_url）
#   - 本地订阅路径（wizard_sub_path）
# 自动应用变更并重启 miproxy

set -e

APP_DEST="${TRIM_APPDEST}"
VAR_DIR="${TRIM_PKGVAR}"
UI_TARGET="${VAR_DIR}/ui"
LOG_FILE="${VAR_DIR}/info.log"

DASHBOARD="${wizard_dashboard:-}"
SUB_URL="${wizard_sub_url:-}"
SUB_PATH="${wizard_sub_path:-}"
REFRESH_INTERVAL_HOURS="${wizard_refresh_interval:-6}"
if [ "${REFRESH_INTERVAL_HOURS}" = "0" ]; then
    REFRESH_INTERVAL_SEC=0
else
    REFRESH_INTERVAL_SEC=$((REFRESH_INTERVAL_HOURS * 3600))
fi

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

log_msg "config_callback: 收到配置更新请求"
log_msg "  wizard_dashboard=${DASHBOARD}"
log_msg "  wizard_sub_url=${SUB_URL}"
log_msg "  wizard_sub_path=${SUB_PATH}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

NEED_RESTART=0

# === 1. 处理面板切换 ===
if [ -n "${DASHBOARD}" ]; then
    # 从 base.yaml 读取当前面板名
    CURRENT_DASHBOARD=""
    if [ -f "${VAR_DIR}/base.yaml" ]; then
        CURRENT_DASHBOARD=$(grep -E "^external-ui-name:" "${VAR_DIR}/base.yaml" | awk '{print $2}' | tr -d '"' | tr -d "'")
    fi

    if [ "${DASHBOARD}" != "${CURRENT_DASHBOARD}" ]; then
        log_msg "切换面板: ${CURRENT_DASHBOARD} -> ${DASHBOARD}"
        if [ -d "${APP_DEST}/ui/${DASHBOARD}" ]; then
            # miproxy 通过 external-ui + external-ui-name 组合定位面板
            # 面板文件必须放到 ${UI_TARGET}/${DASHBOARD}/ 子目录下
            rm -rf "${UI_TARGET:?}/${CURRENT_DASHBOARD}" 2>/dev/null || true
            mkdir -p "${UI_TARGET}/${DASHBOARD}"
            cp -rf "${APP_DEST}/ui/${DASHBOARD}/"* "${UI_TARGET}/${DASHBOARD}/"
            log_msg "面板文件已替换为 ${DASHBOARD} (路径: ${UI_TARGET}/${DASHBOARD})"

            # 更新 base.yaml
            sed -i "s|^external-ui-name:.*|external-ui-name: ${DASHBOARD}|" "${VAR_DIR}/base.yaml"
            log_msg "base.yaml 已更新"

            # 更新桌面入口配置 app/ui/config 中的 url 路径
            if [ -f "${UI_TARGET}/config" ]; then
                sed -i "s|\"/ui/${CURRENT_DASHBOARD}/\"|\"/ui/${DASHBOARD}/\"|g" "${UI_TARGET}/config"
                # 也处理不带末尾斜杠的情况
                sed -i "s|\"/ui/${CURRENT_DASHBOARD}\"|\"/ui/${DASHBOARD}\"|g" "${UI_TARGET}/config"
                log_msg "桌面入口已更新为 ${DASHBOARD}"
            fi

            NEED_RESTART=1
        else
            log_msg "错误: FPK 中没有 ui/${DASHBOARD} 目录"
            echo "无效的面板选择：${DASHBOARD}" > "${TRIM_TEMP_LOGFILE:-/tmp/miproxy_config_err.log}"
            exit 1
        fi
    else
        log_msg "面板未变化（${DASHBOARD}）"
    fi
fi

# === 2. 处理订阅更新 ===
SUB_FILE="${VAR_DIR}/subscription.yaml"
SUB_CHANGED=0

if [ -n "${SUB_URL}" ]; then
    log_msg "下载远程订阅: ${SUB_URL}"
    if curl -fsSL --max-time 30 "${SUB_URL}" -o "${SUB_FILE}.tmp"; then
        mv "${SUB_FILE}.tmp" "${SUB_FILE}"
        log_msg "远程订阅更新成功"
        SUB_CHANGED=1
    else
        rm -f "${SUB_FILE}.tmp"
        log_msg "远程订阅下载失败"
        echo "远程订阅下载失败，请检查 URL 是否正确、网络是否可达" > "${TRIM_TEMP_LOGFILE:-/tmp/miproxy_config_err.log}"
        exit 1
    fi
elif [ -n "${SUB_PATH}" ]; then
    if [ -f "${SUB_PATH}" ]; then
        # 避免 cp 同文件报错触发 set -e
        if [ "${SUB_PATH}" != "${SUB_FILE}" ]; then
            log_msg "复制本地订阅: ${SUB_PATH}"
            if cp -f "${SUB_PATH}" "${SUB_FILE}" 2>>"${LOG_FILE}"; then
                SUB_CHANGED=1
            else
                log_msg "复制订阅失败"
                echo "复制订阅失败: ${SUB_PATH}" > "${TRIM_TEMP_LOGFILE:-/tmp/miproxy_config_err.log}"
                exit 1
            fi
        else
            log_msg "源和目标相同，跳过复制"
        fi
    else
        log_msg "本地订阅文件不存在: ${SUB_PATH}"
        echo "本地订阅文件不存在: ${SUB_PATH}" > "${TRIM_TEMP_LOGFILE:-/tmp/miproxy_config_err.log}"
        exit 1
    fi
fi

if [ "${SUB_CHANGED}" = "1" ]; then
    chmod 666 "${SUB_FILE}"
    NEED_RESTART=1
fi

# === 3. 重新生成主配置（如有变更）===
if [ "${NEED_RESTART}" = "1" ]; then
    log_msg "重新生成主配置 config.yaml..."
    python3 "${SCRIPT_DIR}/merge_config.py" "${VAR_DIR}/base.yaml" "${SUB_FILE}" "${VAR_DIR}/config.yaml"
    chmod 666 "${VAR_DIR}/config.yaml"
    log_msg "主配置已更新"

    # === 4. 重启 miproxy ===
    log_msg "重启 miproxy..."
    bash "${SCRIPT_DIR}/main" stop 2>/dev/null || true
    sleep 2
    bash "${SCRIPT_DIR}/main" start
    log_msg "miproxy 重启完成"
else
    log_msg "无变更，跳过重启"
fi

# === 5. 始终更新守护进程配置 + 重启守护进程 ===
# 即使 miproxy 主配置没变，刷新间隔变了也要重启守护进程
log_msg "更新订阅刷新守护进程配置..."
# 从当前订阅来源（已处理）推导出 type
if [ -n "${SUB_URL}" ]; then
    CURRENT_SUB_TYPE="remote"
elif [ -n "${SUB_PATH}" ]; then
    CURRENT_SUB_TYPE="local"
else
    CURRENT_SUB_TYPE="none"
fi

cat > "${VAR_DIR}/refresh_subscription.conf" << EOF
SUBSCRIPTION_TYPE=${CURRENT_SUB_TYPE}
SUBSCRIPTION_URL=${SUB_URL}
SUBSCRIPTION_PATH=${SUB_PATH}
REFRESH_INTERVAL=${REFRESH_INTERVAL_SEC}
EOF
chmod 666 "${VAR_DIR}/refresh_subscription.conf"
log_msg "守护进程配置已更新 (interval=${REFRESH_INTERVAL_SEC}s, type=${CURRENT_SUB_TYPE})"

# 重启守护进程（kill 旧的，启动新的）
bash "${SCRIPT_DIR}/main" restart-refresh 2>>"${LOG_FILE}" || log_msg "守护进程重启失败（不影响主程序）"

exit 0