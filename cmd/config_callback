#!/bin/bash

# MiProxy 配置变更回调
# 修复订阅更新问题：确保停止守护进程后再重启 miproxy，避免竞争条件
# 修复：订阅下载失败时不退出，确保系统处于稳定状态

set -e

APP_DEST="${TRIM_APPDEST}"
VAR_DIR="${TRIM_PKGVAR}"
UI_TARGET="${VAR_DIR}/ui"
LOG_FILE="${VAR_DIR}/info.log"

PROXY_USER="${wizard_proxy_user:-}"
PROXY_PASS="${wizard_proxy_pass:-}"
SECRET="${wizard_secret:-}"
SUB_URL="${wizard_sub_url:-}"
SUB_PATH="${wizard_sub_path:-}"
REFRESH_INTERVAL_HOURS="${wizard_refresh_interval:-6}"
TUN_ENABLE="${wizard_tun_enable:-false}"

if [ "${REFRESH_INTERVAL_HOURS}" = "0" ]; then
    REFRESH_INTERVAL_SEC=0
else
    REFRESH_INTERVAL_SEC=$((REFRESH_INTERVAL_HOURS * 3600))
fi

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

log_msg "config_callback: 收到配置更新请求"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

NEED_RESTART=0
SUBSCRIPTION_CHANGED=0

# === 处理 base.yaml 更新 ===

# 安全改进：若清空了密码（wizard_proxy_user 和 wizard_proxy_pass 均为空），
# 则移除 authentication 配置块
remove_auth_block() {
    local file="$1"
    # 移除 "authentication:" 行及其后续的 "  - ..." 行（最多 5 行）
    sed -i ':a;N;$!ba;s/\nauthentication:\([[:space:]]*\n[[:space:]]*- "[^"]*"\)\+//g' "${file}" 2>/dev/null || true
}

# 处理 TUN 配置
update_tun_config() {
    local file="$1"
    local enable="$2"
    
    if [ -f "${file}" ]; then
        # 检查是否存在 tun 块
        if grep -q "^tun:" "${file}"; then
            # 更新现有 tun 块的 enable 字段
            sed -i "s/^\(tun:\)/\1/" "${file}"
            if grep -q "^  enable:" "${file}"; then
                sed -i "s/^  enable: .*/  enable: ${enable}/" "${file}"
            else
                # 在 tun: 行后插入 enable 字段
                sed -i "/^tun:/a\  enable: ${enable}" "${file}"
            fi
        else
            # 在文件末尾添加 tun 块
            echo "" >> "${file}"
            echo "# TUN 配置" >> "${file}"
            echo "tun:" >> "${file}"
            echo "  enable: ${enable}" >> "${file}"
            echo "  stack: system" >> "${file}"
            echo "  auto-route: true" >> "${file}"
            echo "  auto-redirect: true" >> "${file}"
            echo "  auto-detect-interface: true" >> "${file}"
            echo "  dns-hijack:" >> "${file}"
            echo "    - any:53" >> "${file}"
            echo "    - tcp://any:53" >> "${file}"
        fi
        log_msg "已更新 TUN 配置: enable=${enable}"
    fi
}

if [ -f "${VAR_DIR}/base.yaml" ]; then
    # 更新 secret
    if [ -n "${SECRET}" ]; then
        sed -i "s/^secret: \"[^\"]*\"/secret: \"${SECRET}\"/" "${VAR_DIR}/base.yaml"
        log_msg "已更新控制面板密钥"
        NEED_RESTART=1
    else
        sed -i 's/^secret: "[^"]*"/secret: ""/' "${VAR_DIR}/base.yaml"
        log_msg "已清空控制面板密钥"
        NEED_RESTART=1
    fi

    # 处理 authentication：清空或更新
    if [ -z "${PROXY_USER}" ] && [ -z "${PROXY_PASS}" ]; then
        # 用户清空了用户名/密码 → 移除 authentication 配置
        remove_auth_block "${VAR_DIR}/base.yaml"
        log_msg "已清空代理用户验证"
        NEED_RESTART=1
    elif [ -n "${PROXY_USER}" ] && [ -n "${PROXY_PASS}" ]; then
        # 用户设置了用户名/密码 → 通过临时文件安全更新
        AUTH_PASS_FILE="${VAR_DIR}/.auth_tmp_$$"
        printf '%s' "${PROXY_PASS}" > "${AUTH_PASS_FILE}"
        chmod 600 "${AUTH_PASS_FILE}"

        # 移除旧的 authentication
        remove_auth_block "${VAR_DIR}/base.yaml"

        # 在 secret 行后插入新的 authentication
        local auth_val="${PROXY_USER}:$(cat "${AUTH_PASS_FILE}")"
        sed -i "/^secret:/a\\
authentication:\\
  - \"${auth_val}\"" "${VAR_DIR}/base.yaml"

        rm -f "${AUTH_PASS_FILE}"
        log_msg "已更新代理用户验证: ${PROXY_USER}"
        NEED_RESTART=1
    fi

    # 处理 TUN 配置
    if grep -q "^tun:" "${VAR_DIR}/base.yaml"; then
        # 更新现有 TUN 配置的 enable 字段
        if grep -q "^  enable:" "${VAR_DIR}/base.yaml"; then
            OLD_TUN=$(grep "^  enable:" "${VAR_DIR}/base.yaml" | awk '{print $2}')
            if [ "${OLD_TUN}" != "${TUN_ENABLE}" ]; then
                sed -i "s/^  enable: .*/  enable: ${TUN_ENABLE}/" "${VAR_DIR}/base.yaml"
                log_msg "已更新 TUN 配置: enable=${TUN_ENABLE}"
                NEED_RESTART=1
            fi
        else
            # 在 tun: 行后插入 enable 字段
            sed -i "/^tun:/a\  enable: ${TUN_ENABLE}" "${VAR_DIR}/base.yaml"
            log_msg "已添加 TUN 配置: enable=${TUN_ENABLE}"
            NEED_RESTART=1
        fi
    else
        # 在文件末尾添加 TUN 配置块
        cat >> "${VAR_DIR}/base.yaml" << EOF

# TUN 配置
tun:
  enable: ${TUN_ENABLE}
  stack: system
  auto-route: true
  auto-redirect: true
  auto-detect-interface: true
  dns-hijack:
    - any:53
    - tcp://any:53
EOF
        log_msg "已添加 TUN 配置: enable=${TUN_ENABLE}"
        NEED_RESTART=1
    fi
fi

# === 处理订阅更新 ===
SUB_FILE="${VAR_DIR}/subscription.yaml"

if [ -n "${SUB_URL}" ]; then
    log_msg "下载远程订阅: ${SUB_URL}"
    if curl -fsSL --max-time 30 "${SUB_URL}" -o "${SUB_FILE}.tmp" 2>>"${LOG_FILE}"; then
        # 验证下载的内容是否为有效的 YAML
        if python3 -c "import yaml; yaml.safe_load(open('${SUB_FILE}.tmp', encoding='utf-8'))" 2>/dev/null; then
            mv "${SUB_FILE}.tmp" "${SUB_FILE}"
            chmod 666 "${SUB_FILE}"
            log_msg "远程订阅更新成功"
            SUBSCRIPTION_CHANGED=1
        else
            rm -f "${SUB_FILE}.tmp"
            log_msg "远程订阅内容无效，跳过更新"
            echo "远程订阅内容无效（YAML 格式错误）" >> "${TRIM_TEMP_LOGFILE:-/tmp/miproxy_config_err.log}"
        fi
    else
        rm -f "${SUB_FILE}.tmp"
        log_msg "远程订阅下载失败"
        echo "远程订阅下载失败，请检查 URL 是否正确" >> "${TRIM_TEMP_LOGFILE:-/tmp/miproxy_config_err.log}"
    fi
elif [ -n "${SUB_PATH}" ]; then
    if [ -f "${SUB_PATH}" ]; then
        # 验证本地文件是否为有效的 YAML
        if python3 -c "import yaml; yaml.safe_load(open('${SUB_PATH}', encoding='utf-8'))" 2>/dev/null; then
            if [ "${SUB_PATH}" != "${SUB_FILE}" ]; then
                cp -f "${SUB_PATH}" "${SUB_FILE}"
                chmod 666 "${SUB_FILE}"
                log_msg "复制本地订阅: ${SUB_PATH}"
                SUBSCRIPTION_CHANGED=1
            fi
        else
            log_msg "本地订阅文件格式无效，跳过更新"
            echo "本地订阅文件格式无效（YAML 格式错误）" >> "${TRIM_TEMP_LOGFILE:-/tmp/miproxy_config_err.log}"
        fi
    else
        log_msg "本地订阅文件不存在: ${SUB_PATH}"
        echo "本地订阅文件不存在" >> "${TRIM_TEMP_LOGFILE:-/tmp/miproxy_config_err.log}"
    fi
else
    # 用户清空了订阅，设置空订阅占位
    log_msg "清空订阅配置"
    cat > "${SUB_FILE}" << 'EMPTYEOF'
proxies: []
proxy-groups:
  - name: PROXY
    type: select
    proxies:
      - DIRECT
rules:
  - MATCH,PROXY
EMPTYEOF
    chmod 666 "${SUB_FILE}"
    SUBSCRIPTION_CHANGED=1
fi

# 只有订阅实际变化时才触发重启
if [ "${SUBSCRIPTION_CHANGED}" = "1" ]; then
    NEED_RESTART=1
fi

# === 重新生成主配置 ===
if [ "${NEED_RESTART}" = "1" ]; then
    log_msg "重新生成主配置 config.yaml..."
    
    # 先停止守护进程，避免竞争条件
    log_msg "停止订阅刷新守护进程..."
    bash "${SCRIPT_DIR}/main" stop-refresh 2>>"${LOG_FILE}" || true
    sleep 1
    
    # 合并配置
    if python3 "${SCRIPT_DIR}/merge_config.py" "${VAR_DIR}/base.yaml" "${SUB_FILE}" "${VAR_DIR}/config.yaml" 2>>"${LOG_FILE}"; then
        chmod 666 "${VAR_DIR}/config.yaml"
        log_msg "配置合并成功"
    else
        log_msg "配置合并失败，跳过重启"
        echo "配置合并失败" >> "${TRIM_TEMP_LOGFILE:-/tmp/miproxy_config_err.log}"
        # 即使合并失败，仍更新守护进程配置
    fi

    # 重启 miproxy
    log_msg "重启 miproxy..."
    
    # 检查进程是否已停止
    bash "${SCRIPT_DIR}/main" status 2>/dev/null
    if [ $? -eq 0 ]; then
        # 进程仍在运行，尝试停止
        bash "${SCRIPT_DIR}/main" stop 2>>"${LOG_FILE}" || true
        sleep 2
    fi
    
    # 确保进程已停止
    bash "${SCRIPT_DIR}/main" status 2>/dev/null && {
        log_msg "警告：进程未能停止，强制终止"
        # 获取 PID 并强制终止
        PID_FILE="${VAR_DIR}/app.pid"
        if [ -f "${PID_FILE}" ]; then
            PID=$(cat "${PID_FILE}")
            kill -9 "${PID}" 2>/dev/null || true
            rm -f "${PID_FILE}"
        fi
        sleep 1
    }
    
    # 启动 miproxy
    bash "${SCRIPT_DIR}/main" start 2>>"${LOG_FILE}" || {
        log_msg "miproxy 启动失败"
        echo "miproxy 启动失败，请检查日志" >> "${TRIM_TEMP_LOGFILE:-/tmp/miproxy_config_err.log}"
    }
    sleep 1
    log_msg "miproxy 重启完成"
fi

# === 更新守护进程配置 ===
log_msg "更新订阅刷新守护进程配置..."
if [ -n "${SUB_URL}" ]; then
    CURRENT_SUB_TYPE="remote"
elif [ -n "${SUB_PATH}" ]; then
    CURRENT_SUB_TYPE="local"
else
    CURRENT_SUB_TYPE="none"
fi

{
    echo "SUBSCRIPTION_TYPE=${CURRENT_SUB_TYPE}"
    echo "SUBSCRIPTION_URL=${SUB_URL}"
    echo "SUBSCRIPTION_PATH=${SUB_PATH}"
    echo "REFRESH_INTERVAL=${REFRESH_INTERVAL_SEC}"
} > "${VAR_DIR}/refresh_subscription.conf"
chmod 666 "${VAR_DIR}/refresh_subscription.conf"

# 启动或重启守护进程
if [ "${NEED_RESTART}" = "1" ]; then
    sleep 2
    log_msg "启动订阅刷新守护进程..."
    bash "${SCRIPT_DIR}/main" start-refresh 2>>"${LOG_FILE}" || log_msg "守护进程启动失败"
else
    bash "${SCRIPT_DIR}/main" restart-refresh 2>>"${LOG_FILE}" || log_msg "守护进程重启失败"
fi

exit 0
