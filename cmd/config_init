#!/bin/bash

# $1: extension id

# Get config from request
# Config is passed via stdin in JSON format

read -r config_json

# Update config.yaml
echo "$config_json" | jq -r '.config' > app/data/config.yaml

# Restart miproxy to apply new config
ARCH=$(uname -m)
if [ "$ARCH" = "x86_64" ]; then
    ARCH_NAME="x86_64"
elif [ "$ARCH" = "aarch64" ]; then
    ARCH_NAME="arm64"
else
    ARCH_NAME="$ARCH"
fi

pkill -f miproxy || true
sleep 1
nohup app/server/${ARCH_NAME}/miproxy -c app/data/config.yaml > /dev/null 2>&1 &

echo '{"status": "success"}'
