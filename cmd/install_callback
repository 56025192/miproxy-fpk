#!/bin/bash

# MiProxy 安装后回调脚本
# 拆分基础配置和订阅，订阅可随时通过设置面板更新

set -e

# 目录
APP_DEST="${TRIM_APPDEST}"     # /var/apps/miproxy
TARGET_DIR="${TRIM_PKGVAR}/target"  # /var/appsdata/miproxy/target
VAR_DIR="${TRIM_PKGVAR}"       # /var/appsdata/miproxy
UI_DIR="${VAR_DIR}/ui"          # /var/appsdata/miproxy/ui

log_msg() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"
}

log_msg "========== MiProxy 安装开始 =========="
log_msg "APP_DEST: ${APP_DEST}"
log_msg "TARGET_DIR: ${TARGET_DIR}"
log_msg "VAR_DIR: ${VAR_DIR}"
log_msg "UI_DIR: ${UI_DIR}"

# 创建必要目录
mkdir -p "${TARGET_DIR}"
mkdir -p "${VAR_DIR}"
mkdir -p "${UI_DIR}"

# ==================== 解压 app.tgz ====================
if [ -f "${APP_DEST}/app.tgz" ]; then
    log_msg "解压 app.tgz..."
    tar -xzf "${APP_DEST}/app.tgz" -C "${APP_DEST}/"
    rm -f "${APP_DEST}/app.tgz"
    log_msg "app.tgz 解压完成"
else
    log_msg "app.tgz 不存在，跳过解压"
fi

# 查看 APP_DEST 目录
log_msg "APP_DEST 目录内容:"
ls -la "${APP_DEST}/" 2>&1 || true

# ==================== 向导变量 ====================
DASHBOARD="${wizard_dashboard:-zashboard}"
HTTP_PORT="${wizard_http_port:-7890}"
API_PORT="${wizard_api_port:-9090}"
SUB_TYPE="${wizard_sub_type:-none}"
SUB_URL="${wizard_sub_url:-}"
SUB_PATH="${wizard_sub_path:-}"
REFRESH_INTERVAL_HOURS="${wizard_refresh_interval:-6}"

if [ "${REFRESH_INTERVAL_HOURS}" = "0" ]; then
    REFRESH_INTERVAL_SEC=0
else
    REFRESH_INTERVAL_SEC=$((REFRESH_INTERVAL_HOURS * 3600))
fi

# ==================== 检测保留数据 ====================
PRESERVED_FLAG="${VAR_DIR}/.preserved"
if [ -f "${PRESERVED_FLAG}" ]; then
    log_msg "检测到上次保留的数据"
    PRESERVED=1
    rm -f "${PRESERVED_FLAG}"
else
    PRESERVED=0
fi

# ==================== 复制 mihomo 核心 ====================
log_msg "复制 mihomo 核心..."
if [ -f "${APP_DEST}/server/mihomo" ]; then
    cp -f "${APP_DEST}/server/mihomo" "${TARGET_DIR}/mihomo"
    chmod +x "${TARGET_DIR}/mihomo"
    log_msg "mihomo 核心复制完成"
else
    log_msg "错误: 未找到 mihomo - ${APP_DEST}/server/mihomo"
    ls -la "${APP_DEST}/server/" 2>&1 || true
fi

# ==================== 复制控制面板 ====================
log_msg "复制控制面板: ${DASHBOARD}"

if [ "${DASHBOARD}" = "zashboard" ]; then
    mkdir -p "${UI_DIR}/zashboard"
    
    # 复制所有文件
    cp -rf "${APP_DEST}/ui/zashboard/"* "${UI_DIR}/zashboard/" 2>/dev/null || true
    
    # 解压 zashboard.zip（如果存在）
    if [ -f "${APP_DEST}/ui/zashboard.zip" ]; then
        log_msg "解压 zashboard.zip..."
        unzip -q -o "${APP_DEST}/ui/zashboard.zip" -d "${UI_DIR}/zashboard-tmp"
        mv "${UI_DIR}/zashboard-tmp/"* "${UI_DIR}/zashboard/" 2>/dev/null || true
        rm -rf "${UI_DIR}/zashboard-tmp"
    fi
    
    # 如果有 dist 子目录，把内容提出来
    if [ -d "${APP_DEST}/ui/zashboard/dist" ]; then
        log_msg "复制 dist 目录内容..."
        cp -rf "${APP_DEST}/ui/zashboard/dist/"* "${UI_DIR}/zashboard/" 2>/dev/null || true
    fi
    
    # 最终检查
    log_msg "zashboard 目录内容:"
    ls -la "${UI_DIR}/zashboard/" 2>&1 || true
    
    DASHBOARD_NAME="zashboard"
else
    mkdir -p "${UI_DIR}/metacubexd"
    cp -rf "${APP_DEST}/ui/metacubexd/"* "${UI_DIR}/metacubexd/" 2>/dev/null || true
    
    # 解压 metacubexd.tar.gz（如果存在）
    if [ -f "${APP_DEST}/ui/metacubexd.tar.gz" ]; then
        log_msg "解压 metacubexd.tar.gz..."
        tar -xzf "${APP_DEST}/ui/metacubexd.tar.gz" -C "${UI_DIR}/metacubexd-tmp"
        mv "${UI_DIR}/metacubexd-tmp/"* "${UI_DIR}/metacubexd/" 2>/dev/null || true
        rm -rf "${UI_DIR}/metacubexd-tmp"
    fi
    
    DASHBOARD_NAME="metacubexd"
fi
log_msg "控制面板复制完成: ${DASHBOARD_NAME}"

# ==================== 复制桌面配置和图标 ====================
log_msg "复制桌面入口配置和图标..."
mkdir -p "${UI_DIR}/images"

if [ -f "${APP_DEST}/ui/config" ]; then
    cp -f "${APP_DEST}/ui/config" "${UI_DIR}/config"
    chmod 666 "${UI_DIR}/config"
fi

cp -f "${APP_DEST}/ui/images/"* "${UI_DIR}/images/" 2>/dev/null || true

# ==================== 写入 base.yaml ====================
if [ "${PRESERVED}" = "1" ] && [ -f "${VAR_DIR}/base.yaml" ]; then
    log_msg "复用现有 base.yaml"
else
    log_msg "写入基础配置 base.yaml..."
cat > "${VAR_DIR}/base.yaml" << EOF
# MiProxy 基础配置
mixed-port: ${HTTP_PORT}
allow-lan: true
mode: rule
log-level: info
ipv6: false

external-controller: 0.0.0.0:${API_PORT}
external-ui: ${UI_DIR}
external-ui-name: ${DASHBOARD_NAME}
secret: ""

external-controller-cors:
  allow-private-network: true
  allow-origins:
    - "*"
EOF
fi

log_msg "========== MiProxy 安装完成 =========="
exit 0
