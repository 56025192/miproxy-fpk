#!/bin/bash
# MiProxy 安装后回调脚本（v9 快速安装版）
# 关键功能：支持"卸载后重装"场景的快速安装
# 
# 安装模式：
# - wizard_install_mode=quick: 快速安装，使用保存的配置
# - wizard_install_mode=custom: 完整安装，使用向导提交的配置

DEBUG_LOG="${TRIM_PKGVAR}/install_callback.log"
exec 2>>"${DEBUG_LOG}"
echo "===== install_callback v9 开始: $(date '+%Y-%m-%d %H:%M:%S') =====" >> "${DEBUG_LOG}"

APP_DEST="${TRIM_APPDEST}"
VAR_DIR="${TRIM_PKGVAR}"
TARGET_DIR="${VAR_DIR}/target"
UI_TARGET="${VAR_DIR}/ui"
CONFIG_FILE="${VAR_DIR}/config.yaml"
LOG_FILE="${VAR_DIR}/info.log"
SETTINGS_FILE="${TRIM_PKGETC}/settings.conf"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" | tee -a "${LOG_FILE}" >> "${DEBUG_LOG}"
}

log_msg "install_callback v9 启动"

# ============ 配置恢复 ============
# 从保存的配置中恢复默认值
restore_config_from_file() {
    if [ ! -f "${SETTINGS_FILE}" ]; then
        log_msg "⚠️ settings.conf 不存在，使用向导提供的值"
        return 1
    fi
    
    log_msg "从 settings.conf 恢复配置..."
    
    while IFS='=' read -r key value; do
        [[ "$key" =~ ^# ]] && continue
        [[ -z "$key" ]] && continue
        
        case "$key" in
            wizard_proxy_user) PROXY_USER="${PROXY_USER:-$value}" ;;
            wizard_proxy_pass) PROXY_PASS="${PROXY_PASS:-$value}" ;;
            wizard_secret) SECRET="${SECRET:-$value}" ;;
            wizard_http_port) HTTP_PORT="${HTTP_PORT:-$value}" ;;
            wizard_api_port) API_PORT="${API_PORT:-$value}" ;;
            wizard_sub_type) SUB_TYPE="${SUB_TYPE:-$value}" ;;
            wizard_sub_url) SUB_URL="${SUB_URL:-$value}" ;;
            wizard_sub_path) SUB_PATH="${SUB_PATH:-$value}" ;;
            wizard_refresh_interval) REFRESH_INTERVAL_HOURS="${REFRESH_INTERVAL_HOURS:-$value}" ;;
            wizard_tun_enable) TUN_ENABLE="${TUN_ENABLE:-$value}" ;;
        esac
    done < "${SETTINGS_FILE}"
    
    log_msg "✅ 配置恢复完成"
    return 0
}

# ============ 读取向导变量 ============
INSTALL_MODE="${wizard_install_mode:-custom}"

if [ "${INSTALL_MODE}" = "quick" ]; then
    log_msg "🚀 检测到快速安装模式"
    # 快速安装模式下，需要从保存的配置中恢复
    restore_config_from_file
else
    log_msg "⚙️ 检测到自定义安装模式"
    # 使用向导提交的值（可能为空）
    PROXY_USER="${wizard_proxy_user:-}"
    PROXY_PASS="${wizard_proxy_pass:-}"
    SECRET="${wizard_secret:-}"
    HTTP_PORT="${wizard_http_port:-7890}"
    API_PORT="${wizard_api_port:-9090}"
    SUB_TYPE="${wizard_sub_type:-none}"
    SUB_URL="${wizard_sub_url:-}"
    SUB_PATH="${wizard_sub_path:-}"
    REFRESH_INTERVAL_HOURS="${wizard_refresh_interval:-0}"
    TUN_ENABLE="${wizard_tun_enable:-false}"
fi

log_msg "  HTTP_PORT=${HTTP_PORT}, API_PORT=${API_PORT}"
log_msg "  SUB_TYPE=${SUB_TYPE}, SUB_URL=${SUB_URL:-（空）}, SUB_PATH=${SUB_PATH:-（空）}"
log_msg "  TUN_ENABLE=${TUN_ENABLE}, REFRESH_INTERVAL=${REFRESH_INTERVAL_HOURS}h"

# ============ 检测重装场景 ============
check_reinstall_scenario() {
    local preserved_file="${VAR_DIR}/.preserved"
    
    if [ -f "${preserved_file}" ]; then
        log_msg "🔄 检测到 .preserved 标记：上次卸载时保留了数据"
        return 0
    fi
    
    if [ -f "${VAR_DIR}/config.yaml" ]; then
        log_msg "🔄 检测到 config.yaml：这是重装场景"
        return 0
    fi
    
    return 1
}

# ============ 仅安装程序本体（快速安装） ============
install_binaries_only() {
    log_msg "=== 快速安装：仅安装程序本体 ==="
    
    mkdir -p "${TARGET_DIR}" "${UI_TARGET}" "${TRIM_PKGETC}"
    
    # 复制 mihomo 核心
    log_msg "复制 mihomo 核心..."
    if [ -f "${APP_DEST}/server/mihomo" ]; then
        cp -f "${APP_DEST}/server/mihomo" "${TARGET_DIR}/mihomo" && chmod +x "${TARGET_DIR}/mihomo"
        log_msg "✅ mihomo 已安装"
    else
        log_msg "❌ mihomo 核心文件不存在！"
        return 1
    fi
    
    # 复制 UI 文件
    log_msg "复制 UI 文件..."
    [ -d "${APP_DEST}/ui/zashboard" ] && mkdir -p "${UI_TARGET}/zashboard" && cp -rf "${APP_DEST}/ui/zashboard/"* "${UI_TARGET}/zashboard/" 2>/dev/null
    [ -d "${APP_DEST}/ui/metacubexd" ] && mkdir -p "${UI_TARGET}/metacubexd" && cp -rf "${APP_DEST}/ui/metacubexd/"* "${UI_TARGET}/metacubexd/" 2>/dev/null
    [ -f "${APP_DEST}/ui/config" ] && cp -f "${APP_DEST}/ui/config" "${UI_TARGET}/config"
    [ -f "${APP_DEST}/ui/index.html" ] && cp -f "${APP_DEST}/ui/index.html" "${UI_TARGET}/index.html"
    [ -d "${APP_DEST}/ui/images" ] && mkdir -p "${UI_TARGET}/images" && cp -rf "${APP_DEST}/ui/images/"* "${UI_TARGET}/images/" 2>/dev/null
    chmod 666 "${UI_TARGET}/config" 2>/dev/null
    log_msg "✅ UI 文件已安装"
    
    # 复制 GEO 数据
    log_msg "复制 GEO 数据..."
    [ -d "${APP_DEST}/data" ] && for f in geoip.dat geosite.dat Country.mmdb; do
        [ -f "${APP_DEST}/data/${f}" ] && cp -f "${APP_DEST}/data/${f}" "${VAR_DIR}/${f}" && chmod 666 "${VAR_DIR}/${f}" 2>/dev/null
    done
    log_msg "✅ GEO 数据已安装"
    
    # 清理标记文件
    rm -f "${VAR_DIR}/.preserved" "${VAR_DIR}/.install_env"
    
    log_msg "✅ 快速安装完成：程序已安装，原有配置已保留"
    return 0
}

# ============ 完整安装（首次安装或重新配置） ============
install_full() {
    log_msg "=== 完整安装：初始化所有组件 ==="
    
    # 创建目录
    mkdir -p "${TARGET_DIR}" "${VAR_DIR}/proxy_providers" "${UI_TARGET}" "${TRIM_PKGETC}"
    
    # 复制 mihomo 核心
    log_msg "复制 mihomo 核心..."
    if [ -f "${APP_DEST}/server/mihomo" ]; then
        cp -f "${APP_DEST}/server/mihomo" "${TARGET_DIR}/mihomo" && chmod +x "${TARGET_DIR}/mihomo"
        log_msg "✅ mihomo 已安装"
    fi
    
    # 复制 UI 文件
    [ -d "${APP_DEST}/ui/zashboard" ] && mkdir -p "${UI_TARGET}/zashboard" && cp -rf "${APP_DEST}/ui/zashboard/"* "${UI_TARGET}/zashboard/" 2>/dev/null
    [ -d "${APP_DEST}/ui/metacubexd" ] && mkdir -p "${UI_TARGET}/metacubexd" && cp -rf "${APP_DEST}/ui/metacubexd/"* "${UI_TARGET}/metacubexd/" 2>/dev/null
    [ -f "${APP_DEST}/ui/config" ] && cp -f "${APP_DEST}/ui/config" "${UI_TARGET}/config"
    [ -f "${APP_DEST}/ui/index.html" ] && cp -f "${APP_DEST}/ui/index.html" "${UI_TARGET}/index.html"
    [ -d "${APP_DEST}/ui/images" ] && mkdir -p "${UI_TARGET}/images" && cp -rf "${APP_DEST}/ui/images/"* "${UI_TARGET}/images/" 2>/dev/null
    chmod 666 "${UI_TARGET}/config" 2>/dev/null
    
    # 复制 GEO 数据
    [ -d "${APP_DEST}/data" ] && for f in geoip.dat geosite.dat Country.mmdb; do
        [ -f "${APP_DEST}/data/${f}" ] && cp -f "${APP_DEST}/data/${f}" "${VAR_DIR}/${f}" && chmod 666 "${VAR_DIR}/${f}" 2>/dev/null
    done
    
    # 下载远程订阅
    local sub_cache_path="${VAR_DIR}/proxy_providers/subscription.yaml"
    if [ "${SUB_TYPE}" = "remote" ] && [ -n "${SUB_URL}" ]; then
        log_msg "📡 下载远程订阅: ${SUB_URL}"
        if curl -fsSL --connect-timeout 15 --max-time 60 "${SUB_URL}" -o "${sub_cache_path}.tmp" 2>>"${DEBUG_LOG}"; then
            mv "${sub_cache_path}.tmp" "${sub_cache_path}"
            log_msg "✅ 订阅下载成功: $(wc -c < "${sub_cache_path}") bytes"
        else
            log_msg "⚠️ 订阅下载失败"
            rm -f "${sub_cache_path}.tmp"
        fi
    fi
    
    # 本地订阅
    if [ "${SUB_TYPE}" = "local" ] && [ -n "${SUB_PATH}" ] && [ -f "${SUB_PATH}" ]; then
        cp -f "${SUB_PATH}" "${sub_cache_path}"
        log_msg "✅ 本地订阅已复制"
    fi
    
    # 生成 config.yaml
    generate_config_yaml
    
    # 保存配置
    save_settings
    
    # 清理标记文件
    rm -f "${VAR_DIR}/.preserved" "${VAR_DIR}/.install_env"
    
    log_msg "✅ 完整安装完成"
    return 0
}

# ============ 生成 config.yaml ============
SUB_DOMAIN_FILTER=""
if [ "${SUB_TYPE}" = "remote" ] && [ -n "${SUB_URL}" ]; then
    domain=$(echo "${SUB_URL}" | sed -E 's|^https?://||; s|/.*$||; s|:.*$||')
    [ -n "${domain}" ] && SUB_DOMAIN_FILTER="    - \"${domain}\"\n    - \"*.${domain}\"\n"
fi

generate_config_yaml() {
    log_msg "生成 config.yaml..."
    
    # 提取订阅配置
    local sub_cache_path="${VAR_DIR}/proxy_providers/subscription.yaml"
    
    extract_yaml_block() {
        python3 - "$1" "$2" 2>/dev/null <<'PYEOF'
import sys
key = sys.argv[1] + ":"
try:
    with open(sys.argv[2], 'r', encoding='utf-8') as f:
        lines = f.readlines()
except:
    sys.exit(0)
result = []
found = False
for line in lines:
    stripped = line.rstrip('\n')
    if not stripped.strip():
        if found: result.append(line)
        continue
    is_top = not stripped[0].isspace()
    if is_top:
        if stripped.startswith(key):
            found = True
            result.append(line)
        elif found:
            if stripped.startswith('-'):
                result.append(line)
            else:
                break
    elif found:
        result.append(line)
sys.stdout.write(''.join(result))
PYEOF
    }
    
    local sub_proxies sub_hosts sub_pg sub_rules sub_dns
    local sub_bypass sub_proxy_providers sub_rule_providers
    local sub_sub_rule sub_tunnels sub_listeners sub_sniff sub_ntp sub_script
    
    if [ -f "${sub_cache_path}" ]; then
        sub_proxies=$(extract_yaml_block "proxies" "${sub_cache_path}")
        sub_hosts=$(extract_yaml_block "hosts" "${sub_cache_path}")
        sub_pg=$(extract_yaml_block "proxy-groups" "${sub_cache_path}")
        sub_rules=$(extract_yaml_block "rules" "${sub_cache_path}")
        sub_dns=$(extract_yaml_block "dns" "${sub_cache_path}")
        sub_bypass=$(extract_yaml_block "bypass" "${sub_cache_path}")
        sub_proxy_providers=$(extract_yaml_block "proxy-providers" "${sub_cache_path}")
        sub_rule_providers=$(extract_yaml_block "rule-providers" "${sub_cache_path}")
        sub_sub_rule=$(extract_yaml_block "sub-rule" "${sub_cache_path}")
        sub_tunnels=$(extract_yaml_block "tunnels" "${sub_cache_path}")
        sub_listeners=$(extract_yaml_block "listeners" "${sub_cache_path}")
        sub_sniff=$(extract_yaml_block "sniff" "${sub_cache_path}")
        sub_ntp=$(extract_yaml_block "ntp" "${sub_cache_path}")
        sub_script=$(extract_yaml_block "script" "${sub_cache_path}")
        
        log_msg "📦 订阅配置已加载"
    fi
    
    {
        echo "# MiProxy 主配置（v9）"
        echo ""
        echo "mixed-port: ${HTTP_PORT}"
        echo "allow-lan: true"
        echo "mode: rule"
        echo "log-level: info"
        echo "ipv6: false"
        echo "external-controller: 0.0.0.0:${API_PORT}"
        echo "external-ui: ${UI_TARGET}"
        echo "external-ui-name: zashboard"
        [ -n "${SECRET}" ] && echo "secret: \"${SECRET}\""
        [ -n "${PROXY_USER}" ] && [ -n "${PROXY_PASS}" ] && echo "authentication:" && echo "  - \"${PROXY_USER}:${PROXY_PASS}\""
        echo "external-controller-cors:"
        echo "  allow-private-network: true"
        echo "  allow-origins: [\"*\"]"
        echo "geodata-mode: true"
        echo "geodata-loader: memconservative"
        echo "tun:"
        echo "  enable: ${TUN_ENABLE}"
        echo "  stack: system"
        echo "  auto-route: true"
        echo "  auto-redirect: true"
        echo "  auto-detect-interface: true"
        echo "  dns-hijack: [\"any:53\", \"tcp://any:53\"]"
        
        [ -n "${sub_proxies}" ] && echo "# 节点列表" && echo "${sub_proxies}"
        [ -n "${sub_hosts}" ] && echo "# hosts" && echo "${sub_hosts}"
        
        if [ -n "${sub_pg}" ]; then
            echo "# 代理组"
            echo "${sub_pg}"
        else
            echo "proxy-groups:"
            echo "  - name: PROXY; type: select; proxies: [DIRECT, REJECT]"
        fi
        
        if [ -n "${sub_rules}" ]; then
            echo "# 路由规则"
            echo "${sub_rules}"
        else
            echo "rules: [\"GEOIP,CN,DIRECT\", \"MATCH,PROXY\"]"
        fi
        
        if [ -n "${sub_dns}" ]; then
            echo "# DNS"
            echo "${sub_dns}"
        else
            echo "dns:"
            echo "  enable: true; listen: 0.0.0.0:53"
            echo "  enhanced-mode: fake-ip; fake-ip-range: 198.18.0.1/16"
            echo "  fake-ip-filter: [\"+.lan\", \"+.local\"${SUB_DOMAIN_FILTER:+, \"${domain}\", \"*.${domain}\"}]"
            echo "  nameserver: [223.5.5.5, 119.29.29.29, 8.8.8.8]"
        fi
        
        [ -n "${sub_bypass}" ] && echo "# bypass" && echo "${sub_bypass}"
        [ -n "${sub_proxy_providers}" ] && echo "# proxy-providers" && echo "${sub_proxy_providers}"
        [ -n "${sub_rule_providers}" ] && echo "# rule-providers" && echo "${sub_rule_providers}"
        [ -n "${sub_sub_rule}" ] && echo "# sub-rule" && echo "${sub_sub_rule}"
        [ -n "${sub_tunnels}" ] && echo "# tunnels" && echo "${sub_tunnels}"
        [ -n "${sub_listeners}" ] && echo "# listeners" && echo "${sub_listeners}"
        [ -n "${sub_sniff}" ] && echo "# sniff" && echo "${sub_sniff}"
        [ -n "${sub_ntp}" ] && echo "# ntp" && echo "${sub_ntp}"
        [ -n "${sub_script}" ] && echo "# script" && echo "${sub_script}"
    } > "${CONFIG_FILE}"
    
    chmod 666 "${CONFIG_FILE}"
    log_msg "✅ config.yaml 已生成"
}

# ============ 保存配置到 settings.conf ============
save_settings() {
    log_msg "保存配置到 settings.conf..."
    
    {
        echo "wizard_http_port=${HTTP_PORT}"
        echo "wizard_api_port=${API_PORT}"
        echo "wizard_tun_enable=${TUN_ENABLE}"
        echo "wizard_sub_type=${SUB_TYPE}"
        echo "wizard_refresh_interval=${REFRESH_INTERVAL_HOURS}"
        [ -n "${PROXY_USER}" ] && echo "wizard_proxy_user=${PROXY_USER}"
        [ -n "${PROXY_PASS}" ] && echo "wizard_proxy_pass=${PROXY_PASS}"
        [ -n "${SECRET}" ] && echo "wizard_secret=${SECRET}"
        [ -n "${SUB_URL}" ] && echo "wizard_sub_url=${SUB_URL}"
        [ -n "${SUB_PATH}" ] && echo "wizard_sub_path=${SUB_PATH}"
    } > "${SETTINGS_FILE}"
    
    chmod 666 "${SETTINGS_FILE}" 2>/dev/null
    log_msg "✅ 配置已保存"
}

# ============ 启动 miproxy ============
start_service() {
    log_msg "启动 miproxy..."
    local script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if bash "${script_dir}/main" start 2>>"${DEBUG_LOG}"; then
        log_msg "✅ miproxy 启动成功"
        return 0
    else
        log_msg "⚠️ miproxy 启动失败"
        return 1
    fi
}

# ============ 主流程 ============
main() {
    log_msg "安装模式: ${INSTALL_MODE}"
    
    if [ "${INSTALL_MODE}" = "quick" ]; then
        # 快速安装
        if check_reinstall_scenario; then
            install_binaries_only
            save_settings  # 更新配置文件的可能变化
            start_service
        else
            log_msg "⚠️ 快速安装模式下未检测到保留数据，切换到完整安装"
            install_full
            start_service
        fi
    else
        # 完整安装
        install_full
        start_service
    fi
    
    log_msg "===== install_callback v9 完成 ====="
    exit 0
}

main "$@"
