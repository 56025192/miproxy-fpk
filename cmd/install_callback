#!/bin/bash

# MiProxy 安装后回调脚本
# 职责：安装程序文件，创建默认配置（但不启动服务）
# 服务启动由用户在 Web UI 中完成首次配置后触发

DEBUG_LOG="${TRIM_PKGVAR}/install_callback.log"
exec 2>>"${DEBUG_LOG}"

echo "===== install_callback 开始: $(date '+%Y-%m-%d %H:%M:%S') =====" >> "${DEBUG_LOG}"

APP_DEST="${TRIM_APPDEST}"
VAR_DIR="${TRIM_PKGVAR}"
PKGETC="${TRIM_PKGETC}"
TARGET_DIR="${VAR_DIR}/target"
UI_TARGET="${VAR_DIR}/ui"
CONFIG_FILE="${VAR_DIR}/config.yaml"
LOG_FILE="${VAR_DIR}/info.log"

mkdir -p "${VAR_DIR}" "${PKGETC}" "${TARGET_DIR}" "${UI_TARGET}" 2>/dev/null

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" | tee -a "${LOG_FILE}" >> "${DEBUG_LOG}"
}

log_msg "开始安装程序文件..."

# 1. 复制 mihomo 核心
log_msg "复制 mihomo 核心..."
if [ -f "${APP_DEST}/server/mihomo" ]; then
    cp -f "${APP_DEST}/server/mihomo" "${TARGET_DIR}/mihomo"
    chmod +x "${TARGET_DIR}/mihomo"
    log_msg "  ✅ mihomo 核心已安装"
else
    log_msg "  ⚠️ 未找到 mihomo 核心"
fi

# 2. 复制 UI 文件
log_msg "复制 UI 文件..."
[ -d "${APP_DEST}/ui/zashboard" ] && {
    cp -rf "${APP_DEST}/ui/zashboard/"* "${UI_TARGET}/" 2>/dev/null
    log_msg "  ✅ zashboard UI 已安装"
}
[ -d "${APP_DEST}/ui/metacubexd" ] && {
    mkdir -p "${UI_TARGET}/metacubexd"
    cp -rf "${APP_DEST}/ui/metacubexd/"* "${UI_TARGET}/metacubexd/" 2>/dev/null
    log_msg "  ✅ metacubexd UI 已安装"
}
[ -f "${APP_DEST}/ui/index.html" ] && {
    cp -f "${APP_DEST}/ui/index.html" "${UI_TARGET}/"
    log_msg "  ✅ index.html 已安装"
}
[ -d "${APP_DEST}/ui/images" ] && {
    mkdir -p "${UI_TARGET}/images"
    cp -rf "${APP_DEST}/ui/images/"* "${UI_TARGET}/images/" 2>/dev/null
    log_msg "  ✅ UI 图片已安装"
}

# 3. 复制 CGI 脚本
log_msg "复制 CGI 脚本..."
mkdir -p "${UI_TARGET}/cgi-bin" 2>/dev/null
for cgi in status.cgi config.cgi auth.cgi; do
    if [ -f "${APP_DEST}/cgi-bin/${cgi}" ]; then
        cp -f "${APP_DEST}/cgi-bin/${cgi}" "${UI_TARGET}/cgi-bin/"
        chmod 755 "${UI_TARGET}/cgi-bin/${cgi}"
        log_msg "  ✅ ${cgi} 已安装"
    fi
done

# 4. 复制 GEO 数据
log_msg "复制 GEO 数据..."
[ -d "${APP_DEST}/data" ] && for f in geoip.dat geosite.dat Country.mmdb; do
    if [ -f "${APP_DEST}/data/${f}" ]; then
        cp -f "${APP_DEST}/data/${f}" "${VAR_DIR}/${f}" 2>/dev/null
        chmod 644 "${VAR_DIR}/${f}" 2>/dev/null
        log_msg "  ✅ ${f} 已安装"
    fi
done

# 5. 检查是否已有配置
if [ -f "${CONFIG_FILE}" ] && [ -s "${CONFIG_FILE}" ]; then
    log_msg "检测到已有配置文件，跳过默认配置生成"
    log_msg "  配置文件: ${CONFIG_FILE}"
else
    # 生成默认配置（无订阅）
    log_msg "生成默认配置文件..."
    generate_default_config
fi

# 6. 不启动服务，等待用户在 Web UI 中完成首次配置
log_msg "程序文件安装完成"
log_msg "请在 Web UI 中完成首次配置"

log_msg "===== install_callback 完成 ====="
exit 0

# ========== 生成默认配置函数 ==========
generate_default_config() {
    local http_port="7890"
    local api_port="9090"
    
    # 尝试从向导参数读取
    http_port="${wizard_http_port:-7890}"
    api_port="${wizard_api_port:-9090}"
    
    {
        echo "# MiProxy 默认配置文件"
        echo "# 生成时间: $(date '+%Y-%m-%d %H:%M:%S')"
        echo "# 提示: 请在 Web UI 中完成订阅配置"
        echo ""
        echo "mixed-port: ${http_port}"
        echo "allow-lan: true"
        echo "mode: rule"
        echo "log-level: info"
        echo "ipv6: false"
        echo "external-controller: 0.0.0.0:${api_port}"
        echo "external-ui: ${UI_TARGET}"
        echo "external-ui-name: zashboard"
        [ -n "${wizard_secret}" ] && echo "secret: \"${wizard_secret}\""
        echo "external-controller-cors:"
        echo "  allow-private-network: true"
        echo "  allow-origins: [\"*\"]"
        echo "geodata-mode: true"
        echo "geodata-loader: memconservative"
        echo "tun:"
        echo "  enable: false"
        echo "  stack: system"
        echo "  auto-route: true"
        echo "  auto-detect-interface: true"
        echo "dns:"
        echo "  enable: true; listen: 0.0.0.0:53"
        echo "  enhanced-mode: fake-ip; fake-ip-range: 198.18.0.1/16"
        echo "  fake-ip-filter: [\"+.lan\", \"+.local\"]"
        echo "  nameserver: [223.5.5.5, 119.29.29.29, 8.8.8.8]"
        echo "proxy-groups:"
        echo "  - name: PROXY; type: select; proxies: [DIRECT]"
        echo "rules: [\"GEOIP,CN,DIRECT\", \"MATCH,PROXY\"]"
    } > "${CONFIG_FILE}"
    
    chmod 644 "${CONFIG_FILE}" 2>/dev/null
    log_msg "  ✅ 默认配置已生成"
}
