#!/bin/bash

# MiProxy 安装后回调脚本
# 拆分基础配置和订阅，订阅可随时通过设置面板更新

set -e

# 目录（TRIM_PKGVAR 是 var 目录本身，TRIM_APPDEST 是 app 目录）
APP_DEST="${TRIM_APPDEST}"
TARGET_DIR="${TRIM_PKGVAR}/target"
VAR_DIR="${TRIM_PKGVAR}"
UI_TARGET="${VAR_DIR}/ui"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1"
}

log_msg "========== 开始安装 =========="
log_msg "APP_DEST: ${APP_DEST}"
log_msg "TARGET_DIR: ${TARGET_DIR}"
log_msg "VAR_DIR: ${VAR_DIR}"
log_msg "UI_TARGET: ${UI_TARGET}"

# 查看 APP_DEST 目录内容
log_msg "APP_DEST 目录内容:"
ls -la "${APP_DEST}/" 2>&1 || log_msg "APP_DEST 目录不存在"

# 解压 app.tgz（fnpack 打包时会把 app/ 目录压缩成 app.tgz）
if [ -f "${APP_DEST}/app.tgz" ]; then
    log_msg "发现 app.tgz，开始解压..."
    tar -xzf "${APP_DEST}/app.tgz" -C "${APP_DEST}/"
    rm -f "${APP_DEST}/app.tgz"
    log_msg "app.tgz 解压完成"
    log_msg "解压后 APP_DEST 内容:"
    ls -la "${APP_DEST}/" 2>&1
else
    log_msg "未发现 app.tgz"
fi

# 查看 ui 目录
log_msg "检查 ui 目录:"
ls -la "${APP_DEST}/ui/" 2>&1 || log_msg "ui 目录不存在"

# 向导变量
DASHBOARD="${wizard_dashboard:-zashboard}"
HTTP_PORT="${wizard_http_port:-7890}"
API_PORT="${wizard_api_port:-9090}"
SUB_TYPE="${wizard_sub_type:-none}"
SUB_URL="${wizard_sub_url:-}"
SUB_PATH="${wizard_sub_path:-}"
REFRESH_INTERVAL_HOURS="${wizard_refresh_interval:-6}"
# 把小时转成秒
if [ "${REFRESH_INTERVAL_HOURS}" = "0" ]; then
    REFRESH_INTERVAL_SEC=0
else
    REFRESH_INTERVAL_SEC=$((REFRESH_INTERVAL_HOURS * 3600))
fi

# 创建必要目录
mkdir -p "${TARGET_DIR}"
mkdir -p "${VAR_DIR}"
mkdir -p "${UI_TARGET}"

# 检测是否有上次保留的数据
PRESERVED_FLAG="${VAR_DIR}/.preserved"
if [ -f "${PRESERVED_FLAG}" ]; then
    log_msg "检测到上次保留的数据"
    PRESERVED=1
    rm -f "${PRESERVED_FLAG}"
else
    PRESERVED=0
fi

# 复制 miproxy 核心
log_msg "复制 mihomo 核心..."
if [ -f "${APP_DEST}/server/mihomo" ]; then
    cp -f "${APP_DEST}/server/mihomo" "${TARGET_DIR}/mihomo"
    chmod +x "${TARGET_DIR}/mihomo"
    log_msg "mihomo 核心复制完成"
else
    log_msg "错误: 未找到 mihomo - ${APP_DEST}/server/mihomo"
    ls -la "${APP_DEST}/server/" 2>&1 || true
fi

# 复制控制面板
log_msg "复制控制面板: ${DASHBOARD}"
# miproxy 通过 external-ui + external-ui-name 组合定位面板
# 所以面板文件必须放到 ${UI_TARGET}/${DASHBOARD}/ 子目录下
if [ "${DASHBOARD}" = "zashboard" ]; then
    mkdir -p "${UI_TARGET}/zashboard"
    log_msg "源目录: ${APP_DEST}/ui/zashboard/"
    log_msg "目标目录: ${UI_TARGET}/zashboard/"
    
    # 复制所有文件
    cp -rf "${APP_DEST}/ui/zashboard/"* "${UI_TARGET}/zashboard/"
    
    # zashboard 的 index.html 在 dist 子目录下，需要提出来
    if [ -d "${APP_DEST}/ui/zashboard/dist" ]; then
        log_msg "复制 dist 目录..."
        cp -rf "${APP_DEST}/ui/zashboard/dist/"* "${UI_TARGET}/zashboard/"
    fi
    
    # 解压 zashboard.zip
    if [ -f "${APP_DEST}/ui/zashboard.zip" ]; then
        log_msg "解压 zashboard.zip..."
        unzip -q "${APP_DEST}/ui/zashboard.zip" -d "${UI_TARGET}/zashboard-tmp"
        mv "${UI_TARGET}/zashboard-tmp/"* "${UI_TARGET}/zashboard/"
        rm -rf "${UI_TARGET}/zashboard-tmp"
    fi
    
    DASHBOARD_NAME="zashboard"
else
    mkdir -p "${UI_TARGET}/metacubexd"
    cp -rf "${APP_DEST}/ui/metacubexd/"* "${UI_TARGET}/metacubexd/"
    DASHBOARD_NAME="metacubexd"
fi
log_msg "控制面板复制完成: ${DASHBOARD_NAME} (路径: ${UI_TARGET}/${DASHBOARD_NAME})"

# 复制桌面入口配置和图标
log_msg "复制桌面入口配置和图标..."
mkdir -p "${UI_TARGET}/images"
if [ -f "${APP_DEST}/ui/config" ]; then
    cp -f "${APP_DEST}/ui/config" "${UI_TARGET}/config"
fi
cp -f "${APP_DEST}/ui/images/"* "${UI_TARGET}/images/" 2>/dev/null || true
chmod 666 "${UI_TARGET}/config" 2>/dev/null || true
log_msg "桌面入口配置和图标复制完成"

# 写入 base.yaml
if [ "${PRESERVED}" = "1" ] && [ -f "${VAR_DIR}/base.yaml" ]; then
    log_msg "复用现有 base.yaml"
else
    log_msg "写入基础配置 base.yaml..."
cat > "${VAR_DIR}/base.yaml" << EOF
# MiProxy 基础配置（系统管理，请勿手动修改）
# 订阅相关字段（proxies/proxy-groups/rules/proxy-providers）请在订阅文件中配置

mixed-port: ${HTTP_PORT}
allow-lan: true
mode: rule
log-level: info
ipv6: false

# 控制面板
external-controller: 0.0.0.0:${API_PORT}
external-ui: ${UI_TARGET}
external-ui-name: ${DASHBOARD_NAME}
secret: ""

# 跨域允许
external-controller-cors:
  allow-private-network: true
  allow-origins:
    - "*"
EOF
fi

log_msg "========== 安装完成 =========="
