#!/bin/bash
# MiProxy 安装后回调脚本（v4 重构版）
# 关键变更：从订阅源同步 proxy-groups / rules / dns 三个字段到 config.yaml
# 直接在 bash 中生成完整 config.yaml（不依赖 PyYAML）
# 使用 `use:` 字段引用 proxy-providers（mihomo 标准语法）

# ============ 调试日志 ============
DEBUG_LOG="${TRIM_PKGVAR}/install_callback.log"
exec 2>>"${DEBUG_LOG}"
echo "===== install_callback v4 开始: $(date '+%Y-%m-%d %H:%M:%S') =====" >> "${DEBUG_LOG}"
echo "TRIM_APPDEST=${TRIM_APPDEST}" >> "${DEBUG_LOG}"
echo "TRIM_PKGVAR=${TRIM_PKGVAR}" >> "${DEBUG_LOG}"
echo "TRIM_PKGETC=${TRIM_PKGETC}" >> "${DEBUG_LOG}"

# ============ 路径变量 ============
APP_DEST="${TRIM_APPDEST}"
VAR_DIR="${TRIM_PKGVAR}"
TARGET_DIR="${VAR_DIR}/target"
UI_TARGET="${VAR_DIR}/ui"
CONFIG_FILE="${VAR_DIR}/config.yaml"
LOG_FILE="${VAR_DIR}/info.log"

# ============ 向导变量 ============
PROXY_USER="${wizard_proxy_user:-}"
PROXY_PASS="${wizard_proxy_pass:-}"
SECRET="${wizard_secret:-}"
HTTP_PORT="${wizard_http_port:-7890}"
API_PORT="${wizard_api_port:-9090}"
SUB_TYPE="${wizard_sub_type:-none}"
SUB_URL="${wizard_sub_url:-}"
SUB_PATH="${wizard_sub_path:-}"
REFRESH_INTERVAL_HOURS="${wizard_refresh_interval:-0}"
TUN_ENABLE="${wizard_tun_enable:-false}"

if [ "${REFRESH_INTERVAL_HOURS}" = "0" ]; then
    REFRESH_INTERVAL_SEC=0
else
    REFRESH_INTERVAL_SEC=$((REFRESH_INTERVAL_HOURS * 3600))
fi

log_msg() {
    local msg="$(date '+%Y-%m-%d %H:%M:%S') - $1"
    echo "${msg}" | tee -a "${LOG_FILE}" >> "${DEBUG_LOG}"
}

log_msg "install_callback v4 启动（新增：订阅源 proxy-groups/rules/dns 同步）"
log_msg "  HTTP_PORT=${HTTP_PORT}, API_PORT=${API_PORT}"
log_msg "  SUB_TYPE=${SUB_TYPE}, SUB_URL=${SUB_URL:-（空）}, SUB_PATH=${SUB_PATH:-（空）}"
log_msg "  REFRESH_INTERVAL=${REFRESH_INTERVAL_HOURS}h (${REFRESH_INTERVAL_SEC}s)"
log_msg "  TUN_ENABLE=${TUN_ENABLE}"

# ============ 判断是否有订阅 ============
HAS_SUB=0
case "${SUB_TYPE}" in
remote)
    [ -n "${SUB_URL}" ] && HAS_SUB=1
    ;;
local)
    [ -n "${SUB_PATH}" ] && HAS_SUB=1
    ;;
esac

log_msg "  HAS_SUB=${HAS_SUB}"

# 自动从 SUB_URL 提取订阅源域名，加入 fake-ip-filter（兜底）
SUB_DOMAIN_FILTER=""
if [ "${SUB_TYPE}" = "remote" ] && [ -n "${SUB_URL}" ]; then
    domain=$(echo "${SUB_URL}" | sed -E 's|^https?://||; s|/.*$||; s|:.*$||')
    if [ -n "${domain}" ]; then
        SUB_DOMAIN_FILTER="    - \"${domain}\"
    - \"*.${domain}\"
"
        log_msg "  订阅源域名加入 fake-ip-filter: ${domain}"
    fi
fi

# ============ 创建目录 ============
mkdir -p "${TARGET_DIR}" "${VAR_DIR}/proxy_providers" "${UI_TARGET}"
mkdir -p "${TRIM_PKGETC}" 2>/dev/null || true

# ============ 复制核心 ============
log_msg "复制 mihomo 核心..."
if [ -f "${APP_DEST}/server/mihomo" ]; then
    cp -f "${APP_DEST}/server/mihomo" "${TARGET_DIR}/mihomo"
    chmod +x "${TARGET_DIR}/mihomo"
else
    log_msg "❌ 找不到 mihomo 二进制: ${APP_DEST}/server/mihomo"
fi

# ============ 复制面板 ============
if [ -d "${APP_DEST}/ui/zashboard" ]; then
    mkdir -p "${UI_TARGET}/zashboard"
    cp -rf "${APP_DEST}/ui/zashboard/"* "${UI_TARGET}/zashboard/" 2>/dev/null || true
fi
if [ -d "${APP_DEST}/ui/metacubexd" ]; then
    mkdir -p "${UI_TARGET}/metacubexd"
    cp -rf "${APP_DEST}/ui/metacubexd/"* "${UI_TARGET}/metacubexd/" 2>/dev/null || true
fi
if [ -f "${APP_DEST}/ui/config" ]; then
    cp -f "${APP_DEST}/ui/config" "${UI_TARGET}/config"
fi
if [ -f "${APP_DEST}/ui/index.html" ]; then
    cp -f "${APP_DEST}/ui/index.html" "${UI_TARGET}/index.html"
fi
if [ -d "${APP_DEST}/ui/images" ]; then
    mkdir -p "${UI_TARGET}/images"
    cp -rf "${APP_DEST}/ui/images/"* "${UI_TARGET}/images/" 2>/dev/null || true
fi
chmod 666 "${UI_TARGET}/config" 2>/dev/null || true

# ============ 复制离线 GEO 数据库 ============
if [ -d "${APP_DEST}/data" ]; then
    for f in geoip.dat geosite.dat Country.mmdb; do
        if [ -f "${APP_DEST}/data/${f}" ]; then
            cp -f "${APP_DEST}/data/${f}" "${VAR_DIR}/${f}"
            chmod 666 "${VAR_DIR}/${f}" 2>/dev/null || true
        fi
    done
fi

# ============ 订阅源下载与字段提取（v4 新增核心）============
SUB_CACHE_PATH="${VAR_DIR}/proxy_providers/subscription.yaml"

# 远程订阅：先下载到 cache（这样 mihomo 启动时也能用这份缓存）
if [ "${SUB_TYPE}" = "remote" ] && [ -n "${SUB_URL}" ]; then
    log_msg "下载远程订阅到 cache: ${SUB_URL}"
    if curl -fsSL --connect-timeout 15 --max-time 60 "${SUB_URL}" -o "${SUB_CACHE_PATH}.tmp" 2>>"${DEBUG_LOG}"; then
        if [ -s "${SUB_CACHE_PATH}.tmp" ]; then
            mv "${SUB_CACHE_PATH}.tmp" "${SUB_CACHE_PATH}"
            sub_size=$(stat -c%s "${SUB_CACHE_PATH}" 2>/dev/null || wc -c < "${SUB_CACHE_PATH}")
            log_msg "✅ 订阅下载成功: ${sub_size} bytes"
        else
            log_msg "⚠️ 订阅文件为空"
            rm -f "${SUB_CACHE_PATH}.tmp"
        fi
    else
        log_msg "⚠️ 订阅下载失败，使用本地默认"
        rm -f "${SUB_CACHE_PATH}.tmp"
    fi
fi

# 本地订阅：拷贝到 cache
if [ "${SUB_TYPE}" = "local" ] && [ -n "${SUB_PATH}" ] && [ -f "${SUB_PATH}" ]; then
    cp -f "${SUB_PATH}" "${SUB_CACHE_PATH}"
    log_msg "✅ 本地订阅已拷贝到 cache"
fi

# 用 Python 标准库提取 yaml 顶级块（无需 PyYAML）
extract_yaml_block() {
    local key="$1"
    local file="$2"
    python3 - "${key}" "${file}" 2>/dev/null <<'PYEOF'
import sys
key = sys.argv[1] + ":"
file_path = sys.argv[2]
try:
    with open(file_path, 'r', encoding='utf-8') as f:
        lines = f.readlines()
except Exception:
    sys.exit(0)
result = []
in_block = False
for line in lines:
    stripped = line.rstrip('\n')
    if not stripped.strip():
        if in_block:
            result.append(line)
        continue
    is_top_level = bool(stripped) and not stripped[0].isspace()
    if is_top_level:
        if stripped.startswith(key):
            in_block = True
            result.append(line)
        elif in_block:
            in_block = False
    elif in_block:
        result.append(line)
sys.stdout.write(''.join(result))
PYEOF
}

# 从订阅源 cache 中提取 proxy-groups / rules / dns
SUB_PG=""
SUB_RULES=""
SUB_DNS=""
if [ -f "${SUB_CACHE_PATH}" ]; then
    SUB_PG=$(extract_yaml_block "proxy-groups" "${SUB_CACHE_PATH}")
    SUB_RULES=$(extract_yaml_block "rules" "${SUB_CACHE_PATH}")
    SUB_DNS=$(extract_yaml_block "dns" "${SUB_CACHE_PATH}")

    log_msg "  📦 订阅源 proxy-groups: $(printf '%s' "${SUB_PG}" | wc -l) 行"
    log_msg "  📦 订阅源 rules: $(printf '%s' "${SUB_RULES}" | wc -l) 行"
    log_msg "  📦 订阅源 dns: $(printf '%s' "${SUB_DNS}" | wc -l) 行"

    # 完整性检查：dns 块必须有 nameserver 才算完整
    if [ -n "${SUB_DNS}" ] && ! printf '%s' "${SUB_DNS}" | grep -q "nameserver"; then
        log_msg "  ⚠️ 订阅源 dns 块缺 nameserver，回退到本地默认 DNS"
        SUB_DNS=""
    fi
fi

# ============ 生成完整 config.yaml ============
log_msg "生成 config.yaml..."

{
    echo "# MiProxy 主配置（系统管理，请勿手动修改）"
    echo "# 由 miproxy-fpk 自动生成于 $(date '+%Y-%m-%d %H:%M:%S')"
    echo ""
    echo "mixed-port: ${HTTP_PORT}"
    echo "allow-lan: true"
    echo "mode: rule"
    echo "log-level: info"
    echo "ipv6: false"
    echo ""
    echo "# 控制面板"
    echo "external-controller: 0.0.0.0:${API_PORT}"
    echo "external-ui: ${UI_TARGET}"
    echo "external-ui-name: zashboard"
    echo ""

    # 密钥
    if [ -n "${SECRET}" ]; then
        echo "# 控制面板密钥"
        echo "secret: \"${SECRET}\""
        echo ""
    fi

    # 代理用户验证
    if [ -n "${PROXY_USER}" ] && [ -n "${PROXY_PASS}" ]; then
        echo "# 代理用户验证"
        echo "authentication:"
        echo "  - \"${PROXY_USER}:${PROXY_PASS}\""
        echo ""
    fi

    echo "# 跨域允许"
    echo "external-controller-cors:"
    echo "  allow-private-network: true"
    echo "  allow-origins:"
    echo "    - \"*\""
    echo ""
    echo "# GEO 数据库"
    echo "geodata-mode: true"
    echo "geodata-loader: memconservative"
    echo ""
    echo "# TUN"
    echo "tun:"
    echo "  enable: ${TUN_ENABLE}"
    echo "  stack: system"
    echo "  auto-route: true"
    echo "  auto-redirect: true"
    echo "  auto-detect-interface: true"
    echo "  dns-hijack:"
    echo "    - any:53"
    echo "    - tcp://any:53"
    echo ""

    # proxy-providers（mihomo 标准语法）
    case "${SUB_TYPE}" in
    remote)
        if [ -n "${SUB_URL}" ]; then
            echo "# 远程订阅（type=http，URL 直填）"
            echo "proxy-providers:"
            echo "  subscription:"
            echo "    type: http"
            echo "    url: \"${SUB_URL}\""
            echo "    path: ./proxy_providers/subscription.yaml"
            echo "    interval: ${REFRESH_INTERVAL_SEC}"
            echo "    health-check:"
            echo "      enable: true"
            echo "      url: https://www.gstatic.com/generate_204"
            echo "      interval: 300"
            echo ""
        fi
        ;;
    local)
        if [ -n "${SUB_PATH}" ]; then
            echo "# 本地订阅（type=file）"
            echo "proxy-providers:"
            echo "  subscription:"
            echo "    type: file"
            echo "    path: \"${SUB_PATH}\""
            echo "    interval: ${REFRESH_INTERVAL_SEC}"
            echo "    health-check:"
            echo "      enable: true"
            echo "      url: https://www.gstatic.com/generate_204"
            echo "      interval: 300"
            echo ""
        fi
        ;;
    esac

    # ============ proxy-groups（v4：从订阅源同步）============
    if [ -n "${SUB_PG}" ]; then
        echo "# 代理组（来自订阅源同步）"
        echo "${SUB_PG}"
        echo ""
    else
        echo "# 代理组（本地默认）"
        echo "proxy-groups:"
        echo "  - name: PROXY"
        echo "    type: select"
        if [ "${HAS_SUB}" = "1" ]; then
            echo "    use:"
            echo "      - subscription"
        fi
        echo "    proxies:"
        echo "      - DIRECT"
        echo ""
    fi

    # ============ rules（v4：从订阅源同步）============
    if [ -n "${SUB_RULES}" ]; then
        echo "# 路由规则（来自订阅源同步）"
        echo "${SUB_RULES}"
        echo ""
    else
        echo "# 路由规则（本地默认）"
        echo "rules:"
        echo "  - GEOIP,CN,DIRECT"
        echo "  - MATCH,PROXY"
        echo ""
    fi

    # ============ dns（v4：从订阅源同步）============
    if [ -n "${SUB_DNS}" ]; then
        echo "# DNS（来自订阅源同步）"
        echo "${SUB_DNS}"
        echo ""
    else
        echo "# DNS（本地默认，含订阅域名 fake-ip 白名单）"
        echo "dns:"
        echo "  enable: true"
        echo "  listen: 0.0.0.0:53"
        echo "  enhanced-mode: fake-ip"
        echo "  fake-ip-range: 198.18.0.1/16"
        echo "  fake-ip-filter:"
        echo "    - \"+.lan\""
        echo "    - \"+.local\""
        if [ -n "${SUB_DOMAIN_FILTER}" ]; then
            echo "${SUB_DOMAIN_FILTER}"
        fi
        echo "  nameserver:"
        echo "    - 223.5.5.5"
        echo "    - 119.29.29.29"
        echo "    - 8.8.8.8"
        echo ""
    fi
} > "${CONFIG_FILE}"

chmod 666 "${CONFIG_FILE}"
log_msg "✅ config.yaml 已生成 (${CONFIG_FILE})"

# 删除可能被旧版本遗留的中间文件
rm -f "${VAR_DIR}/base.yaml" "${VAR_DIR}/subscription.yaml" "${VAR_DIR}/subscription.conf" 2>/dev/null

# ============ 写入 settings.conf ============
{
    echo "wizard_http_port=${HTTP_PORT}"
    echo "wizard_api_port=${API_PORT}"
    echo "wizard_tun_enable=${TUN_ENABLE}"
    echo "wizard_sub_type=${SUB_TYPE}"
    echo "wizard_refresh_interval=${REFRESH_INTERVAL_HOURS}"
    [ -n "${PROXY_USER}" ] && echo "wizard_proxy_user=${PROXY_USER}"
    [ -n "${PROXY_PASS}" ] && echo "wizard_proxy_pass=${PROXY_PASS}"
    [ -n "${SECRET}" ] && echo "wizard_secret=${SECRET}"
    [ -n "${SUB_URL}" ] && echo "wizard_sub_url=${SUB_URL}"
    [ -n "${SUB_PATH}" ] && echo "wizard_sub_path=${SUB_PATH}"
} > "${TRIM_PKGETC}/settings.conf"

chmod 666 "${TRIM_PKGETC}/settings.conf" 2>/dev/null || true

# ============ 启动 mihomo ============
log_msg "尝试启动 miproxy..."
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if bash "${SCRIPT_DIR}/main" start 2>>"${DEBUG_LOG}"; then
    log_msg "✅ miproxy 启动成功"
else
    log_msg "⚠️  miproxy 启动失败，配置文件已写入，请到应用中心手动启动"
fi

log_msg "===== install_callback v4 完成 ====="

# 不论 mihomo 启动是否成功，配置已写入则视为安装成功
exit 0
