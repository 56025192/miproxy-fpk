#!/bin/bash

# MiProxy 安装完成后的回调脚本
# 负责复制应用文件、生成配置文件、下载订阅等初始化工作

set -e

APP_DEST="${TRIM_APPDEST}"
TARGET_DIR="${TRIM_PKGVAR}/target"
VAR_DIR="${TRIM_PKGVAR}"
UI_TARGET="${VAR_DIR}/ui"

# 向导变量（来自 wizard/install）
PROXY_USER="${wizard_proxy_user:-}"
PROXY_PASS="${wizard_proxy_pass:-}"
SECRET="${wizard_secret:-}"
HTTP_PORT="${wizard_http_port:-7890}"
API_PORT="${wizard_api_port:-9090}"
SUB_TYPE="${wizard_sub_type:-none}"
SUB_URL="${wizard_sub_url:-}"
SUB_PATH="${wizard_sub_path:-}"
REFRESH_INTERVAL_HOURS="${wizard_refresh_interval:-6}"
if [ "${REFRESH_INTERVAL_HOURS}" = "0" ]; then
    REFRESH_INTERVAL_SEC=0
else
    REFRESH_INTERVAL_SEC=$((REFRESH_INTERVAL_HOURS * 3600))
fi

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1"
}

mkdir -p "${TARGET_DIR}"
mkdir -p "${VAR_DIR}"
mkdir -p "${UI_TARGET}"

# 检查是否保留数据（升级场景）
PRESERVED_FLAG="${VAR_DIR}/.preserved"
if [ -f "${PRESERVED_FLAG}" ]; then
    log_msg "检测到保留数据"
    PRESERVED=1
    rm -f "${PRESERVED_FLAG}"
else
    PRESERVED=0
fi

# 复制 mihomo 二进制文件
log_msg "复制 mihomo 二进制..."
cp -f "${APP_DEST}/server/mihomo" "${TARGET_DIR}/mihomo"
chmod +x "${TARGET_DIR}/mihomo"
log_msg "mihomo 二进制已复制"

# 复制控制面板
log_msg "复制控制面板..."
mkdir -p "${UI_TARGET}/zashboard"
mkdir -p "${UI_TARGET}/metacubexd"
cp -rf "${APP_DEST}/ui/zashboard/"* "${UI_TARGET}/zashboard/" 2>/dev/null || true
cp -rf "${APP_DEST}/ui/metacubexd/"* "${UI_TARGET}/metacubexd/" 2>/dev/null || true
log_msg "控制面板已复制"

# 复制配置和图标
log_msg "复制配置和图标..."
mkdir -p "${UI_TARGET}/images"
cp -f "${APP_DEST}/ui/config" "${UI_TARGET}/config"
cp -f "${APP_DEST}/ui/index.html" "${UI_TARGET}/index.html" 2>/dev/null || true
cp -f "${APP_DEST}/ui/images/"* "${UI_TARGET}/images/" 2>/dev/null || true
chmod 666 "${UI_TARGET}/config"
log_msg "配置和图标已复制"

# 构建认证配置
AUTH_CONFIG=""
if [ -n "${PROXY_USER}" ] && [ -n "${PROXY_PASS}" ]; then
    AUTH_CONFIG="authentication:
  - \"${PROXY_USER}:${PROXY_PASS}\""
    log_msg "代理认证已启用: ${PROXY_USER}"
else
    log_msg "代理认证已禁用"
fi

# 构建密钥配置
if [ -n "${SECRET}" ]; then
    SECRET_CONFIG="secret: \"${SECRET}\""
    log_msg "面板密钥已启用"
else
    SECRET_CONFIG="secret: \"\""
    log_msg "面板密钥已禁用"
fi

# 写入基础配置
if [ "${PRESERVED}" = "1" ] && [ -f "${VAR_DIR}/base.yaml" ]; then
    log_msg "保留现有 base.yaml"
else
    log_msg "写入 base.yaml..."
cat > "${VAR_DIR}/base.yaml" << EOF
mixed-port: ${HTTP_PORT}
allow-lan: true
mode: rule
log-level: info
ipv6: false

external-controller: 0.0.0.0:${API_PORT}
external-ui: ${UI_TARGET}
external-ui-name: zashboard
${SECRET_CONFIG}

${AUTH_CONFIG}

external-controller-cors:
  allow-private-network: true
  allow-origins:
    - "*"

tun:
  enable: false

geodata-mode: true
EOF
fi

# 复制 GEO 数据库
if [ -d "${APP_DEST}/data" ]; then
    log_msg "复制 GEO 数据库..."
    cp -f "${APP_DEST}/data/geoip.dat" "${VAR_DIR}/geoip.dat"
    cp -f "${APP_DEST}/data/geosite.dat" "${VAR_DIR}/geosite.dat"
    cp -f "${APP_DEST}/data/Country.mmdb" "${VAR_DIR}/Country.mmdb"
    chmod 666 "${VAR_DIR}/geoip.dat" "${VAR_DIR}/geosite.dat" "${VAR_DIR}/Country.mmdb"
    log_msg "GEO 数据库已复制"
fi

# 处理订阅配置
log_msg "处理订阅配置 (类型: ${SUB_TYPE})..."
SUB_FILE="${VAR_DIR}/subscription.yaml"

if [ "${PRESERVED}" = "1" ] && [ -f "${SUB_FILE}" ] && [ -z "${SUB_URL}" ] && [ -z "${SUB_PATH}" ]; then
    log_msg "保留现有订阅配置"
elif [ "${PRESERVED}" = "1" ] && [ -f "${SUB_FILE}" ] && [ "${SUB_TYPE}" = "none" ]; then
    log_msg "保留现有订阅配置"
else
    case "${SUB_TYPE}" in
    remote)
        if [ -n "${SUB_URL}" ]; then
            log_msg "下载远程订阅: ${SUB_URL}"
            if curl -fsSL --max-time 30 "${SUB_URL}" -o "${SUB_FILE}"; then
                log_msg "订阅下载成功"
            else
                log_msg "订阅下载失败，使用空配置"
                cat > "${SUB_FILE}" << 'EMPTYEOF'
proxies: []
proxy-groups:
  - name: PROXY
    type: select
    proxies:
      - DIRECT
rules:
  - MATCH,PROXY
EMPTYEOF
            fi
        else
            cat > "${SUB_FILE}" << 'EMPTYEOF'
proxies: []
proxy-groups:
  - name: PROXY
    type: select
    proxies:
      - DIRECT
rules:
  - MATCH,PROXY
EMPTYEOF
        fi
        ;;
    local)
        if [ -n "${SUB_PATH}" ] && [ -f "${SUB_PATH}" ]; then
            log_msg "复制本地订阅: ${SUB_PATH}"
            cp -f "${SUB_PATH}" "${SUB_FILE}"
        else
            cat > "${SUB_FILE}" << 'EMPTYEOF'
proxies: []
proxy-groups:
  - name: PROXY
    type: select
    proxies:
      - DIRECT
rules:
  - MATCH,PROXY
EMPTYEOF
        fi
        ;;
    *)
        cat > "${SUB_FILE}" << 'EMPTYEOF'
proxies: []
proxy-groups:
  - name: PROXY
    type: select
    proxies:
      - DIRECT
rules:
  - MATCH,PROXY
EMPTYEOF
        ;;
    esac
fi

chmod 666 "${SUB_FILE}"

# 合并配置
log_msg "生成 config.yaml..."
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
python3 "${SCRIPT_DIR}/merge_config.py" "${VAR_DIR}/base.yaml" "${SUB_FILE}" "${VAR_DIR}/config.yaml"
chmod 666 "${VAR_DIR}/config.yaml"
log_msg "config.yaml 已生成"

# 写入设置文件
mkdir -p "${TRIM_PKGETC}"
{
    echo "wizard_proxy_user=${PROXY_USER}"
    echo "wizard_proxy_pass=${PROXY_PASS}"
    echo "wizard_secret=${SECRET}"
    echo "wizard_http_port=${HTTP_PORT}"
    echo "wizard_api_port=${API_PORT}"
    echo "wizard_sub_type=${SUB_TYPE}"
    echo "wizard_sub_url=${SUB_URL}"
    echo "wizard_sub_path=${SUB_PATH}"
    echo "wizard_refresh_interval=${REFRESH_INTERVAL_HOURS}"
} > "${TRIM_PKGETC}/settings.conf"

# 写入订阅刷新守护进程配置
log_msg "写入订阅刷新守护进程配置..."
{
    echo "SUBSCRIPTION_TYPE=${SUB_TYPE}"
    echo "SUBSCRIPTION_URL=${SUB_URL}"
    echo "SUBSCRIPTION_PATH=${SUB_PATH}"
    echo "REFRESH_INTERVAL=${REFRESH_INTERVAL_SEC}"
} > "${VAR_DIR}/refresh_subscription.conf"
chmod 666 "${VAR_DIR}/refresh_subscription.conf"
log_msg "订阅刷新配置已写入 (间隔=${REFRESH_INTERVAL_SEC}秒)"

log_msg "安装完成!"
exit 0
