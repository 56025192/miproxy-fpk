#!/bin/bash

# MiProxy 安装后回调脚本
# 拆分基础配置和订阅，订阅可随时通过设置面板更新

set -e

# 目录（TRIM_PKGVAR 是 var 目录本身，TRIM_APPDEST 是 app 目录）
APP_DEST="${TRIM_APPDEST}"
TARGET_DIR="${TRIM_PKGVAR}/target"
VAR_DIR="${TRIM_PKGVAR}"
UI_TARGET="${VAR_DIR}/ui"

# 向导变量
PROXY_USER="${wizard_proxy_user:-}"
PROXY_PASS="${wizard_proxy_pass:-}"
SECRET="${wizard_secret:-}"
HTTP_PORT="${wizard_http_port:-7890}"
API_PORT="${wizard_api_port:-9090}"
SUB_TYPE="${wizard_sub_type:-none}"
SUB_URL="${wizard_sub_url:-}"
SUB_PATH="${wizard_sub_path:-}"
REFRESH_INTERVAL_HOURS="${wizard_refresh_interval:-6}"
if [ "${REFRESH_INTERVAL_HOURS}" = "0" ]; then
    REFRESH_INTERVAL_SEC=0
else
    REFRESH_INTERVAL_SEC=$((REFRESH_INTERVAL_HOURS * 3600))
fi

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1"
}

# 创建必要目录
mkdir -p "${TARGET_DIR}"
mkdir -p "${VAR_DIR}"
mkdir -p "${UI_TARGET}"

# 检测是否有上次保留的数据
PRESERVED_FLAG="${VAR_DIR}/.preserved"
if [ -f "${PRESERVED_FLAG}" ]; then
    log_msg "检测到上次保留的数据"
    PRESERVED=1
    rm -f "${PRESERVED_FLAG}"
else
    PRESERVED=0
fi

# 复制 miproxy 核心
log_msg "复制 mihomo 核心..."
cp -f "${APP_DEST}/server/mihomo" "${TARGET_DIR}/mihomo"
chmod +x "${TARGET_DIR}/mihomo"
log_msg "mihomo 核心复制完成"

# 复制两个面板
log_msg "复制控制面板..."
mkdir -p "${UI_TARGET}/zashboard"
mkdir -p "${UI_TARGET}/metacubexd"
cp -rf "${APP_DEST}/ui/zashboard/"* "${UI_TARGET}/zashboard/" 2>/dev/null || true
cp -rf "${APP_DEST}/ui/metacubexd/"* "${UI_TARGET}/metacubexd/" 2>/dev/null || true
log_msg "控制面板复制完成"

# 复制桌面入口配置、图标和 index.html
log_msg "复制桌面入口配置和图标..."
mkdir -p "${UI_TARGET}/images"
cp -f "${APP_DEST}/ui/config" "${UI_TARGET}/config"
cp -f "${APP_DEST}/ui/index.html" "${UI_TARGET}/index.html" 2>/dev/null || true
cp -f "${APP_DEST}/ui/images/"* "${UI_TARGET}/images/" 2>/dev/null || true
chmod 666 "${UI_TARGET}/config"
log_msg "桌面入口配置和图标复制完成"

# 构建 authentication 配置（代理用户验证）
AUTH_BLOCK=""
if [ -n "${PROXY_USER}" ] && [ -n "${PROXY_PASS}" ]; then
    AUTH_BLOCK="# 代理用户验证（HTTP/SOCKS5/Mixed 连接验证）
authentication:
  - \"${PROXY_USER}:${PROXY_PASS}\""
    log_msg "已启用代理用户验证: ${PROXY_USER}"
else
    AUTH_BLOCK="# 代理用户验证（未配置）"
    log_msg "未设置代理用户验证"
fi

# 构建 secret 配置（控制面板密钥）
if [ -n "${SECRET}" ]; then
    SECRET_LINE="secret: \"${SECRET}\""
    log_msg "已设置控制面板密钥"
else
    SECRET_LINE="secret: \"\""
    log_msg "未设置控制面板密钥"
fi

# 写入 base.yaml
if [ "${PRESERVED}" = "1" ] && [ -f "${VAR_DIR}/base.yaml" ]; then
    log_msg "复用现有 base.yaml"
else
    log_msg "写入基础配置 base.yaml..."
    {
        echo "# MiProxy 基础配置（系统管理，请勿手动修改）"
        echo "# 订阅相关字段（proxies/proxy-groups/rules/proxy-providers）请在订阅文件中配置"
        echo ""
        echo "mixed-port: ${HTTP_PORT}"
        echo "allow-lan: true"
        echo "mode: rule"
        echo "log-level: info"
        echo "ipv6: false"
        echo ""
        echo "# 控制面板"
        echo "external-controller: 0.0.0.0:${API_PORT}"
        echo "external-ui: ${UI_TARGET}"
        echo "external-ui-name: \"/ui\""
        echo "${SECRET_LINE}"
        echo ""
        echo "${AUTH_BLOCK}"
        echo ""
        echo "# 跨域允许"
        echo "external-controller-cors:"
        echo "  allow-private-network: true"
        echo "  allow-origins:"
        echo "    - \"*\""
        echo ""
        echo "# TUN 默认关闭"
        echo "tun:"
        echo "  enable: false"
        echo ""
        echo "# GEO 数据库模式（避免 miproxy 启动时联网下载）"
        echo "geodata-mode: true"
    } > "${VAR_DIR}/base.yaml"
fi

# 复制离线 GEO 数据库
if [ -d "${APP_DEST}/data" ]; then
    log_msg "复制离线 GEO 数据库..."
    cp -f "${APP_DEST}/data/geoip.dat" "${VAR_DIR}/geoip.dat"
    cp -f "${APP_DEST}/data/geosite.dat" "${VAR_DIR}/geosite.dat"
    cp -f "${APP_DEST}/data/Country.mmdb" "${VAR_DIR}/Country.mmdb"
    chmod 666 "${VAR_DIR}/geoip.dat" "${VAR_DIR}/geosite.dat" "${VAR_DIR}/Country.mmdb"
    log_msg "离线 GEO 数据库已就绪"
fi

# 写入 subscription.yaml
log_msg "处理订阅 (类型: ${SUB_TYPE})..."
SUB_FILE="${VAR_DIR}/subscription.yaml"

if [ "${PRESERVED}" = "1" ] && [ -f "${SUB_FILE}" ] && [ -z "${SUB_URL}" ] && [ -z "${SUB_PATH}" ]; then
    log_msg "复用现有 subscription.yaml"
elif [ "${PRESERVED}" = "1" ] && [ -f "${SUB_FILE}" ] && [ "${SUB_TYPE}" = "none" ]; then
    log_msg "复用现有 subscription.yaml（向导未指定订阅）"
else
    case "${SUB_TYPE}" in
    remote)
        if [ -n "${SUB_URL}" ]; then
            log_msg "下载远程订阅: ${SUB_URL}"
            if curl -fsSL --max-time 30 "${SUB_URL}" -o "${SUB_FILE}"; then
                log_msg "远程订阅下载成功"
            else
                log_msg "警告: 远程订阅下载失败，使用空订阅占位"
                {
                    echo "proxies: []"
                    echo "proxy-groups:"
                    echo "  - name: PROXY"
                    echo "    type: select"
                    echo "    proxies:"
                    echo "      - DIRECT"
                    echo "rules:"
                    echo "  - MATCH,PROXY"
                } > "${SUB_FILE}"
            fi
        else
            log_msg "远程订阅 URL 为空，使用空订阅占位"
            {
                echo "proxies: []"
                echo "proxy-groups:"
                echo "  - name: PROXY"
                echo "    type: select"
                echo "    proxies:"
                echo "      - DIRECT"
                echo "rules:"
                echo "  - MATCH,PROXY"
            } > "${SUB_FILE}"
        fi
        ;;
    local)
        if [ -n "${SUB_PATH}" ] && [ -f "${SUB_PATH}" ]; then
            log_msg "复制本地订阅: ${SUB_PATH}"
            cp -f "${SUB_PATH}" "${SUB_FILE}"
        else
            log_msg "警告: 本地订阅文件不存在，使用空订阅占位"
            {
                echo "proxies: []"
                echo "proxy-groups:"
                echo "  - name: PROXY"
                echo "    type: select"
                echo "    proxies:"
                echo "      - DIRECT"
                echo "rules:"
                echo "  - MATCH,PROXY"
            } > "${SUB_FILE}"
        fi
        ;;
    *)
        log_msg "不使用订阅，使用占位"
        {
            echo "# 未配置订阅"
            echo "proxies: []"
            echo "proxy-groups:"
            echo "  - name: PROXY"
            echo "    type: select"
            echo "    proxies:"
            echo "      - DIRECT"
            echo "rules:"
            echo "  - MATCH,PROXY"
        } > "${SUB_FILE}"
        ;;
    esac
fi

chmod 666 "${SUB_FILE}"

# 拼接主配置
log_msg "生成主配置 config.yaml..."
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
python3 "${SCRIPT_DIR}/merge_config.py" "${VAR_DIR}/base.yaml" "${SUB_FILE}" "${VAR_DIR}/config.yaml"
chmod 666 "${VAR_DIR}/config.yaml"
log_msg "主配置已生成"

# 写入 settings.conf
mkdir -p "${TRIM_PKGETC}"
{
    echo "wizard_proxy_user=${PROXY_USER}"
    echo "wizard_proxy_pass=${PROXY_PASS}"
    echo "wizard_secret=${SECRET}"
    echo "wizard_http_port=${HTTP_PORT}"
    echo "wizard_api_port=${API_PORT}"
    echo "wizard_sub_type=${SUB_TYPE}"
    echo "wizard_sub_url=${SUB_URL}"
    echo "wizard_sub_path=${SUB_PATH}"
    echo "wizard_refresh_interval=${REFRESH_INTERVAL_HOURS}"
} > "${TRIM_PKGETC}/settings.conf"

# 写入刷新守护进程配置
log_msg "写入订阅刷新守护进程配置..."
{
    echo "SUBSCRIPTION_TYPE=${SUB_TYPE}"
    echo "SUBSCRIPTION_URL=${SUB_URL}"
    echo "SUBSCRIPTION_PATH=${SUB_PATH}"
    echo "REFRESH_INTERVAL=${REFRESH_INTERVAL_SEC}"
} > "${VAR_DIR}/refresh_subscription.conf"
chmod 666 "${VAR_DIR}/refresh_subscription.conf"
log_msg "守护进程配置已写入 (interval=${REFRESH_INTERVAL_SEC}s)"

log_msg "安装完成!"
exit 0

