#!/bin/bash
# MiProxy 安装后回调脚本（v10）
# 支持两种安装模式：
# 1. 快速安装模式：检测到 .quick_config，使用保存的配置
# 2. 自定义安装模式：使用向导输入的配置
#
# 场景判断逻辑：
# - 场景 A: 保留数据 + 本地/无订阅 → 跳过数据初始化，仅安装程序
# - 场景 B: 保留数据 + 远程订阅 → 跳过 config 生成，但重新下载订阅
# - 场景 C/D: 未保留数据 / 首次安装 → 执行完整安装流程

DEBUG_LOG="${TRIM_PKGVAR}/install_callback.log"
exec 2>>"${DEBUG_LOG}"
echo "===== install_callback v10 开始: $(date '+%Y-%m-%d %H:%M:%S') =====" >> "${DEBUG_LOG}"

APP_DEST="${TRIM_APPDEST}"
VAR_DIR="${TRIM_PKGVAR}"
TARGET_DIR="${VAR_DIR}/target"
UI_TARGET="${VAR_DIR}/ui"
CONFIG_FILE="${VAR_DIR}/config.yaml"
LOG_FILE="${VAR_DIR}/info.log"
QUICK_CONFIG="${VAR_DIR}/.quick_config"

# 从快速配置或向导获取值
load_config() {
    if [ -f "${QUICK_CONFIG}" ]; then
        echo "从快速配置加载: ${QUICK_CONFIG}"
        source "${QUICK_CONFIG}"
        # 快速模式标记
        IS_QUICK_MODE="true"
    else
        echo "从向导配置加载"
        # 向导变量由 fnOS 自动设置
        IS_QUICK_MODE="false"
    fi
    
    # 设置默认值
    PROXY_USER="${wizard_proxy_user:-}"
    PROXY_PASS="${wizard_proxy_pass:-}"
    SECRET="${wizard_secret:-}"
    HTTP_PORT="${wizard_http_port:-7890}"
    API_PORT="${wizard_api_port:-9090}"
    SUB_TYPE="${wizard_sub_type:-none}"
    SUB_URL="${wizard_sub_url:-}"
    SUB_PATH="${wizard_sub_path:-}"
    REFRESH_INTERVAL_HOURS="${wizard_refresh_interval:-0}"
    TUN_ENABLE="${wizard_tun_enable:-false}"
}

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" | tee -a "${LOG_FILE}" >> "${DEBUG_LOG}"
}

# 加载配置
load_config

log_msg "install_callback v10 启动"
log_msg "  安装模式: ${IS_QUICK_MODE}"
log_msg "  HTTP_PORT=${HTTP_PORT}, API_PORT=${API_PORT}"
log_msg "  SUB_TYPE=${SUB_TYPE}, SUB_URL=${SUB_URL:-（空）}"

# 检查是否需要处理重装场景（跳过数据初始化）
check_skip_data_init() {
    local preserved_file="${VAR_DIR}/.preserved"
    
    if [ -f "${preserved_file}" ] && [ "${IS_QUICK_MODE}" = "true" ]; then
        log_msg "🔄 检测到快速安装场景：跳过数据初始化"
        return 0
    fi
    return 1
}

# 场景 A: 仅安装程序，跳过数据处理
handle_scenario_a() {
    log_msg "=== 场景 A 处理：跳过数据初始化 ==="
    
    # 仅安装程序本体
    mkdir -p "${TARGET_DIR}" "${UI_TARGET}" "${TRIM_PKGETC}"
    
    # 复制 mihomo 核心
    log_msg "复制 mihomo 核心..."
    [ -f "${APP_DEST}/server/mihomo" ] && cp -f "${APP_DEST}/server/mihomo" "${TARGET_DIR}/mihomo" && chmod +x "${TARGET_DIR}/mihomo"
    
    # 复制 UI 文件
    [ -d "${APP_DEST}/ui/zashboard" ] && mkdir -p "${UI_TARGET}/zashboard" && cp -rf "${APP_DEST}/ui/zashboard/"* "${UI_TARGET}/zashboard/" 2>/dev/null
    [ -d "${APP_DEST}/ui/metacubexd" ] && mkdir -p "${UI_TARGET}/metacubexd" && cp -rf "${APP_DEST}/ui/metacubexd/"* "${UI_TARGET}/metacubexd/" 2>/dev/null
    [ -f "${APP_DEST}/ui/config" ] && cp -f "${APP_DEST}/ui/config" "${UI_TARGET}/config"
    [ -f "${APP_DEST}/ui/index.html" ] && cp -f "${APP_DEST}/ui/index.html" "${UI_TARGET}/index.html"
    [ -d "${APP_DEST}/ui/images" ] && mkdir -p "${UI_TARGET}/images" && cp -rf "${APP_DEST}/ui/images/"* "${UI_TARGET}/images/" 2>/dev/null
    chmod 666 "${UI_TARGET}/config" 2>/dev/null
    
    # 复制 GEO 数据
    [ -d "${APP_DEST}/data" ] && for f in geoip.dat geosite.dat Country.mmdb; do
        [ -f "${APP_DEST}/data/${f}" ] && cp -f "${APP_DEST}/data/${f}" "${VAR_DIR}/${f}" && chmod 666 "${VAR_DIR}/${f}" 2>/dev/null
    done
    
    # 清理标记文件
    rm -f "${VAR_DIR}/.preserved"
    rm -f "${QUICK_CONFIG}"
    
    # 更新配置（端口、TUN 等可能变化的信息）
    update_partial_config
    
    log_msg "✅ 场景 A 处理完成：程序已安装，数据已保留"
}

# 更新部分配置
update_partial_config() {
    if [ ! -f "${CONFIG_FILE}" ]; then
        log_msg "⚠️ 配置文件不存在，跳过部分更新"
        return
    fi
    
    log_msg "更新部分配置（端口、TUN 等）..."
    
    # 更新 HTTP 端口
    if [ -n "${HTTP_PORT}" ]; then
        sed -i "s/mixed-port: [0-9]*/mixed-port: ${HTTP_PORT}/" "${CONFIG_FILE}"
        log_msg "  更新 HTTP 端口: ${HTTP_PORT}"
    fi
    
    # 更新 API 端口
    if [ -n "${API_PORT}" ]; then
        sed -i "s/external-controller: 0.0.0.0:[0-9]*/external-controller: 0.0.0.0:${API_PORT}/" "${CONFIG_FILE}"
        log_msg "  更新 API 端口: ${API_PORT}"
    fi
    
    # 更新 TUN 设置
    if [ -n "${TUN_ENABLE}" ]; then
        sed -i "s/tun:$/tun:/; s/  enable: .*/  enable: ${TUN_ENABLE}/" "${CONFIG_FILE}"
        log_msg "  更新 TUN: ${TUN_ENABLE}"
    fi
    
    # 更新密钥
    if [ -n "${SECRET}" ]; then
        if grep -q "^secret:" "${CONFIG_FILE}"; then
            sed -i "s/^secret:.*/secret: \"${SECRET}\"/" "${CONFIG_FILE}"
        fi
        log_msg "  更新密钥: 已设置"
    fi
}

# 场景 B: 跳过 config 生成，但重新下载订阅
handle_scenario_b() {
    log_msg "=== 场景 B 处理：跳过 config 生成，重新下载订阅 ==="
    
    # 安装程序本体（与场景 A 相同）
    mkdir -p "${TARGET_DIR}" "${UI_TARGET}" "${TRIM_PKGETC}"
    
    [ -f "${APP_DEST}/server/mihomo" ] && cp -f "${APP_DEST}/server/mihomo" "${TARGET_DIR}/mihomo" && chmod +x "${TARGET_DIR}/mihomo"
    [ -d "${APP_DEST}/ui/zashboard" ] && mkdir -p "${UI_TARGET}/zashboard" && cp -rf "${APP_DEST}/ui/zashboard/"* "${UI_TARGET}/zashboard/" 2>/dev/null
    [ -d "${APP_DEST}/ui/metacubexd" ] && mkdir -p "${UI_TARGET}/metacubexd" && cp -rf "${APP_DEST}/ui/metacubexd/"* "${UI_TARGET}/metacubexd/" 2>/dev/null
    [ -f "${APP_DEST}/ui/config" ] && cp -f "${APP_DEST}/ui/config" "${UI_TARGET}/config"
    [ -f "${APP_DEST}/ui/index.html" ] && cp -f "${APP_DEST}/ui/index.html" "${UI_TARGET}/index.html"
    [ -d "${APP_DEST}/ui/images" ] && mkdir -p "${UI_TARGET}/images" && cp -rf "${APP_DEST}/ui/images/"* "${UI_TARGET}/images/" 2>/dev/null
    chmod 666 "${UI_TARGET}/config" 2>/dev/null
    [ -d "${APP_DEST}/data" ] && for f in geoip.dat geosite.dat Country.mmdb; do
        [ -f "${APP_DEST}/data/${f}" ] && cp -f "${APP_DEST}/data/${f}" "${VAR_DIR}/${f}" && chmod 666 "${VAR_DIR}/${f}" 2>/dev/null
    done
    
    # 清理标记文件
    rm -f "${VAR_DIR}/.preserved"
    rm -f "${QUICK_CONFIG}"
    
    # 重新下载远程订阅
    local sub_cache_path="${VAR_DIR}/proxy_providers/subscription.yaml"
    mkdir -p "${VAR_DIR}/proxy_providers"
    
    log_msg "📡 重新下载远程订阅: ${SUB_URL}"
    if curl -fsSL --connect-timeout 15 --max-time 60 "${SUB_URL}" -o "${sub_cache_path}" 2>>"${DEBUG_LOG}"; then
        log_msg "  ✅ 订阅下载成功"
        generate_config_yaml
    else
        log_msg "  ⚠️ 订阅下载失败，使用现有配置"
        # 如果下载失败，尝试使用现有订阅
        if [ -f "${sub_cache_path}" ]; then
            generate_config_yaml
        fi
    fi
    
    log_msg "✅ 场景 B 处理完成"
}

# 生成 config.yaml
generate_config_yaml() {
    log_msg "生成 config.yaml..."
    
    # 提取订阅字段
    local sub_cache_path="${VAR_DIR}/proxy_providers/subscription.yaml"
    local SUB_PROXIES SUB_HOSTS SUB_PG SUB_RULES SUB_DNS
    local SUB_BYPASS SUB_PROXY_PROVIDERS SUB_RULE_PROVIDERS
    
    extract_yaml_block() {
        python3 - "$1" "$2" 2>/dev/null <<'PYEOF'
import sys
key = sys.argv[1] + ":"
try:
    with open(sys.argv[2], 'r', encoding='utf-8') as f:
        lines = f.readlines()
except:
    sys.exit(0)
result = []
found = False
for line in lines:
    stripped = line.rstrip('\n')
    if not stripped.strip():
        if found: result.append(line)
        continue
    is_top = not stripped[0].isspace()
    if is_top:
        if stripped.startswith(key):
            found = True
            result.append(line)
        elif found:
            if stripped.startswith('-'):
                result.append(line)
            else:
                break
    elif found:
        result.append(line)
sys.stdout.write(''.join(result))
PYEOF
    }
    
    if [ -f "${sub_cache_path}" ]; then
        SUB_PROXIES=$(extract_yaml_block "proxies" "${sub_cache_path}")
        SUB_HOSTS=$(extract_yaml_block "hosts" "${sub_cache_path}")
        SUB_PG=$(extract_yaml_block "proxy-groups" "${sub_cache_path}")
        SUB_RULES=$(extract_yaml_block "rules" "${sub_cache_path}")
        SUB_DNS=$(extract_yaml_block "dns" "${sub_cache_path}")
        SUB_BYPASS=$(extract_yaml_block "bypass" "${sub_cache_path}")
        SUB_PROXY_PROVIDERS=$(extract_yaml_block "proxy-providers" "${sub_cache_path}")
        SUB_RULE_PROVIDERS=$(extract_yaml_block "rule-providers" "${sub_cache_path}")
    fi
    
    local sub_domain_filter=""
    if [ "${SUB_TYPE}" = "remote" ] && [ -n "${SUB_URL}" ]; then
        local domain=$(echo "${SUB_URL}" | sed -E 's|^https?://||; s|/.*$||; s|:.*$||')
        [ -n "${domain}" ] && sub_domain_filter="    - \"${domain}\"\n    - \"*.${domain}\""
    fi
    
    {
        echo "# MiProxy 主配置"
        echo ""
        echo "mixed-port: ${HTTP_PORT}"
        echo "allow-lan: true"
        echo "mode: rule"
        echo "log-level: info"
        echo "ipv6: false"
        echo "external-controller: 0.0.0.0:${API_PORT}"
        echo "external-ui: ${UI_TARGET}"
        echo "external-ui-name: zashboard"
        [ -n "${SECRET}" ] && echo "secret: \"${SECRET}\""
        [ -n "${PROXY_USER}" ] && [ -n "${PROXY_PASS}" ] && echo "authentication:" && echo "  - \"${PROXY_USER}:${PROXY_PASS}\""
        echo "external-controller-cors:"
        echo "  allow-private-network: true"
        echo "  allow-origins: [\"*\"]"
        echo "geodata-mode: true"
        echo "geodata-loader: memconservative"
        echo "tun:"
        echo "  enable: ${TUN_ENABLE}"
        echo "  stack: system"
        echo "  auto-route: true"
        echo "  auto-redirect: true"
        echo "  auto-detect-interface: true"
        echo "  dns-hijack: [\"any:53\", \"tcp://any:53\"]"
        
        [ -n "${SUB_PROXIES}" ] && echo "" && echo "${SUB_PROXIES}"
        [ -n "${SUB_HOSTS}" ] && echo "" && echo "${SUB_HOSTS}"
        [ -n "${SUB_PG}" ] && echo "" && echo "${SUB_PG}" || echo "proxy-groups:" && echo "  - name: PROXY; type: select; proxies: [DIRECT, REJECT]"
        [ -n "${SUB_RULES}" ] && echo "" && echo "${SUB_RULES}" || echo "rules: [\"GEOIP,CN,DIRECT\", \"MATCH,PROXY\"]"
        [ -n "${SUB_DNS}" ] && echo "" && echo "${SUB_DNS}" || echo "dns:" && echo "  enable: true; listen: 0.0.0.0:53" && echo "  enhanced-mode: fake-ip; fake-ip-range: 198.18.0.1/16" && echo "  fake-ip-filter: [\"+.lan\", \"+.local\"${sub_domain_filter:+, \"${domain}\", \"*.${domain}\"}]" && echo "  nameserver: [223.5.5.5, 119.29.29.29, 8.8.8.8]"
        [ -n "${SUB_BYPASS}" ] && echo "" && echo "${SUB_BYPASS}"
        [ -n "${SUB_PROXY_PROVIDERS}" ] && echo "" && echo "${SUB_PROXY_PROVIDERS}"
        [ -n "${SUB_RULE_PROVIDERS}" ] && echo "" && echo "${SUB_RULE_PROVIDERS}"
    } > "${CONFIG_FILE}"
    
    chmod 666 "${CONFIG_FILE}"
    log_msg "✅ config.yaml 已生成"
}

# 完整安装流程（场景 C/D）
handle_full_install() {
    log_msg "=== 场景 C/D 处理：完整安装流程 ==="
    
    mkdir -p "${TARGET_DIR}" "${VAR_DIR}/proxy_providers" "${UI_TARGET}" "${TRIM_PKGETC}"
    
    log_msg "复制 mihomo 核心..."
    [ -f "${APP_DEST}/server/mihomo" ] && cp -f "${APP_DEST}/server/mihomo" "${TARGET_DIR}/mihomo" && chmod +x "${TARGET_DIR}/mihomo"
    
    [ -d "${APP_DEST}/ui/zashboard" ] && mkdir -p "${UI_TARGET}/zashboard" && cp -rf "${APP_DEST}/ui/zashboard/"* "${UI_TARGET}/zashboard/" 2>/dev/null
    [ -d "${APP_DEST}/ui/metacubexd" ] && mkdir -p "${UI_TARGET}/metacubexd" && cp -rf "${APP_DEST}/ui/metacubexd/"* "${UI_TARGET}/metacubexd/" 2>/dev/null
    [ -f "${APP_DEST}/ui/config" ] && cp -f "${APP_DEST}/ui/config" "${UI_TARGET}/config"
    [ -f "${APP_DEST}/ui/index.html" ] && cp -f "${APP_DEST}/ui/index.html" "${UI_TARGET}/index.html"
    [ -d "${APP_DEST}/ui/images" ] && mkdir -p "${UI_TARGET}/images" && cp -rf "${APP_DEST}/ui/images/"* "${UI_TARGET}/images/" 2>/dev/null
    chmod 666 "${UI_TARGET}/config" 2>/dev/null
    
    [ -d "${APP_DEST}/data" ] && for f in geoip.dat geosite.dat Country.mmdb; do
        [ -f "${APP_DEST}/data/${f}" ] && cp -f "${APP_DEST}/data/${f}" "${VAR_DIR}/${f}" && chmod 666 "${VAR_DIR}/${f}" 2>/dev/null
    done
    
    # 下载订阅
    local sub_cache_path="${VAR_DIR}/proxy_providers/subscription.yaml"
    if [ "${SUB_TYPE}" = "remote" ] && [ -n "${SUB_URL}" ]; then
        log_msg "下载远程订阅: ${SUB_URL}"
        curl -fsSL --connect-timeout 15 --max-time 60 "${SUB_URL}" -o "${sub_cache_path}.tmp" 2>>"${DEBUG_LOG}" && mv "${sub_cache_path}.tmp" "${sub_cache_path}" && log_msg "  ✅ 订阅下载成功" || log_msg "  ⚠️ 订阅下载失败"
    elif [ "${SUB_TYPE}" = "local" ] && [ -n "${SUB_PATH}" ] && [ -f "${SUB_PATH}" ]; then
        cp -f "${SUB_PATH}" "${sub_cache_path}"
    fi
    
    # 生成配置
    generate_config_yaml
    
    # 保存设置
    save_settings
    
    log_msg "✅ 完整安装完成"
}

# 保存设置并启动
save_settings_and_start() {
    # 保存设置到配置文件
    {
        echo "wizard_http_port=${HTTP_PORT}; wizard_api_port=${API_PORT}; wizard_tun_enable=${TUN_ENABLE}"
        echo "wizard_sub_type=${SUB_TYPE}; wizard_refresh_interval=${REFRESH_INTERVAL_HOURS}"
        [ -n "${PROXY_USER}" ] && echo "wizard_proxy_user=${PROXY_USER}"
        [ -n "${PROXY_PASS}" ] && echo "wizard_proxy_pass=${PROXY_PASS}"
        [ -n "${SECRET}" ] && echo "wizard_secret=${SECRET}"
        [ -n "${SUB_URL}" ] && echo "wizard_sub_url=${SUB_URL}"
        [ -n "${SUB_PATH}" ] && echo "wizard_sub_path=${SUB_PATH}"
    } > "${TRIM_PKGETC}/settings.conf"
    chmod 666 "${TRIM_PKGETC}/settings.conf" 2>/dev/null
    
    # 启动服务
    local script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    bash "${script_dir}/main" start 2>>"${DEBUG_LOG}" && log_msg "✅ miproxy 启动成功" || log_msg "⚠️  miproxy 启动失败"
}

# 保存设置（仅保存，不启动）
save_settings() {
    {
        echo "wizard_http_port=${HTTP_PORT}; wizard_api_port=${API_PORT}; wizard_tun_enable=${TUN_ENABLE}"
        echo "wizard_sub_type=${SUB_TYPE}; wizard_refresh_interval=${REFRESH_INTERVAL_HOURS}"
        [ -n "${PROXY_USER}" ] && echo "wizard_proxy_user=${PROXY_USER}"
        [ -n "${PROXY_PASS}" ] && echo "wizard_proxy_pass=${PROXY_PASS}"
        [ -n "${SECRET}" ] && echo "wizard_secret=${SECRET}"
        [ -n "${SUB_URL}" ] && echo "wizard_sub_url=${SUB_URL}"
        [ -n "${SUB_PATH}" ] && echo "wizard_sub_path=${SUB_PATH}"
    } > "${TRIM_PKGETC}/settings.conf"
    chmod 666 "${TRIM_PKGETC}/settings.conf" 2>/dev/null
}

# ============ 主流程 ============
if check_skip_data_init; then
    # 判断场景
    if [ "${SUB_TYPE}" = "remote" ] && [ -n "${SUB_URL}" ]; then
        handle_scenario_b
    else
        handle_scenario_a
    fi
    save_settings_and_start
else
    handle_full_install
fi

log_msg "===== install_callback v10 完成 ====="
exit 0
