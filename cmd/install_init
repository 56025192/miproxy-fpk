#!/bin/bash

# MiProxy 安装前回调脚本（v4 持久化检测版）
# 功能：
# 1. 检测是否为重装场景（从持久化路径读取 .preserved）
# 2. 如果是重装场景，直接使用保存的配置完成安装
# 3. 如果是首次安装，使用默认向导
# 
# 关键修复：从 /tmp/miproxy_backup/ 读取，而不是 TRIM_PKGVAR

LOG_FILE="/tmp/miproxy_install_init.log"
exec >>"${LOG_FILE}" 2>&1

echo "===== install_init v4 开始: $(date '+%Y-%m-%d %H:%M:%S') ====="
echo "TRIM_APPDEST=${TRIM_APPDEST:-not set}"
echo "TRIM_PKGVAR=${TRIM_PKGVAR:-not set}"
echo "TRIM_PKGETC=${TRIM_PKGETC:-not set}"

# 持久化备份目录（与 uninstall_callback 保持一致）
BACKUP_DIR="/tmp/miproxy_backup"
PRESERVED_FILE="${BACKUP_DIR}/.preserved"

echo "检查重装场景..."
echo "  PRESERVED_FILE=${PRESERVED_FILE}"

# 检测是否为重装场景
if [ -f "${PRESERVED_FILE}" ]; then
    echo "✅ 检测到重装场景：上次卸载时保留了数据"
    
    # 读取保存的配置
    source "${PRESERVED_FILE}"
    
    # 设置默认值
    HTTP_PORT=${HTTP_PORT:-7890}
    API_PORT=${API_PORT:-9090}
    TUN_ENABLE=${TUN_ENABLE:-false}
    SUB_TYPE=${SUB_TYPE:-none}
    REFRESH_INTERVAL=${REFRESH_INTERVAL:-0}
    
    echo "读取到保存的配置："
    echo "  HTTP_PORT=${HTTP_PORT}, API_PORT=${API_PORT}"
    echo "  TUN_ENABLE=${TUN_ENABLE}, SUB_TYPE=${SUB_TYPE}"
    echo "  SUB_URL=${SUB_URL:-（无）}"
    
    # 将配置写入环境变量文件，供 install_callback 使用
    ENV_FILE="${TRIM_PKGVAR}/.quick_env"
    mkdir -p "${TRIM_PKGVAR}"
    
    cat > "${ENV_FILE}" << EOF
# MiProxy 快速安装环境变量（v4 自动生成）
WIZARD_QUICK_MODE=true
WIZARD_HTTP_PORT=${HTTP_PORT}
WIZARD_API_PORT=${API_PORT}
WIZARD_PROXY_USER=${PROXY_USER:-}
WIZARD_PROXY_PASS=${PROXY_PASS:-}
WIZARD_SECRET=${SECRET:-}
WIZARD_TUN_ENABLE=${TUN_ENABLE}
WIZARD_SUB_TYPE=${SUB_TYPE}
WIZARD_SUB_URL=${SUB_URL:-}
WIZARD_SUB_PATH=${SUB_PATH:-}
WIZARD_REFRESH_INTERVAL=${REFRESH_INTERVAL}
EOF
    chmod 644 "${ENV_FILE}" 2>/dev/null
    echo "✅ 环境变量已保存: ${ENV_FILE}"
    
    # 将备份的数据恢复到 TRIM_PKGVAR
    if [ -d "${BACKUP_DIR}/data" ]; then
        echo "恢复备份数据到 ${TRIM_PKGVAR}..."
        cp -r "${BACKUP_DIR}/data/"* "${TRIM_PKGVAR}/" 2>/dev/null && echo "  ✅ 数据恢复完成" || echo "  ⚠️ 部分数据恢复失败"
    fi
    
    # 将备份的配置复制到 TRIM_PKGETC
    if [ -f "${BACKUP_DIR}/settings.conf.bak" ]; then
        mkdir -p "${TRIM_PKGETC}"
        cp "${BACKUP_DIR}/settings.conf.bak" "${TRIM_PKGETC}/settings.conf"
        chmod 644 "${TRIM_PKGETC}/settings.conf" 2>/dev/null
        echo "  ✅ 配置恢复完成"
    fi
    
    # 清理备份（防止重复使用）
    rm -f "${PRESERVED_FILE}"
    echo "✅ 重装准备完成，install_callback 将使用保存的配置"
    echo "===== install_init 完成（快速模式） ====="
    exit 0
else
    echo "🆕 首次安装或未保留数据，使用完整向导"
    echo "===== install_init 完成（完整模式） ====="
    exit 0
fi
