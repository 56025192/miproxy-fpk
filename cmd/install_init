#!/bin/bash

# MiProxy 安装前初始化脚本（v2 重装感知版）
# 职责：检测重装场景，恢复保存的配置到 wizard 变量

LOG_FILE="/tmp/miproxy_install_init.log"
exec >>"${LOG_FILE}" 2>&1

echo ""
echo "=========================================="
echo "$(date '+%Y-%m-%d %H:%M:%S') install_init: 检测重装场景"
echo "=========================================="

# fnOS 的数据目录（卸载时保留的数据位置）
VAR_DIR="${TRIM_PKGVAR}"
PRESERVED_FILE="${VAR_DIR}/.preserved"
SETTINGS_FILE="${TRIM_PKGETC}/settings.conf"

# 检测是否为重装场景（保留数据）
detect_reinstall() {
    echo "检测重装场景..."
    
    # 检查是否有保留标记
    if [ -f "${PRESERVED_FILE}" ]; then
        echo "✅ 检测到 .preserved 标记：这是重装场景"
        echo "PRESERVED=true" >> "${TRIM_PKGVAR}/.install_env"
        return 0
    fi
    
    # 检查是否有配置文件（也可能是重装场景）
    if [ -f "${SETTINGS_FILE}" ]; then
        echo "✅ 检测到 settings.conf：可能是重装场景"
        echo "PRESERVED=true" >> "${TRIM_PKGVAR}/.install_env"
        return 0
    fi
    
    # 检查是否有 config.yaml
    if [ -f "${VAR_DIR}/config.yaml" ]; then
        echo "✅ 检测到 config.yaml：这是重装场景"
        echo "PRESERVED=true" >> "${TRIM_PKGVAR}/.install_env"
        return 0
    fi
    
    echo "❌ 未检测到保留数据：这是首次安装或未保留数据的安装"
    echo "PRESERVED=false" >> "${TRIM_PKGVAR}/.install_env"
    return 1
}

# 恢复保存的配置到 wizard 变量
restore_settings() {
    echo "恢复保存的配置..."
    
    if [ ! -f "${SETTINGS_FILE}" ]; then
        echo "⚠️ settings.conf 不存在，无法恢复配置"
        return 1
    fi
    
    # 读取并恢复各项配置
    while IFS='=' read -r key value; do
        # 跳过注释和空行
        [[ "$key" =~ ^# ]] && continue
        [[ -z "$key" ]] && continue
        
        # 设置 wizard 变量
        case "$key" in
            wizard_proxy_user)
                wizard_proxy_user="$value"
                echo "已恢复：代理用户 = $value"
                ;;
            wizard_proxy_pass)
                wizard_proxy_pass="$value"
                echo "已恢复：代理密码 = *****"
                ;;
            wizard_secret)
                wizard_secret="$value"
                echo "已恢复：面板密钥 = $value"
                ;;
            wizard_http_port)
                wizard_http_port="$value"
                echo "已恢复：HTTP端口 = $value"
                ;;
            wizard_api_port)
                wizard_api_port="$value"
                echo "已恢复：API端口 = $value"
                ;;
            wizard_tun_enable)
                wizard_tun_enable="$value"
                echo "已恢复：TUN启用 = $value"
                ;;
            wizard_sub_type)
                wizard_sub_type="$value"
                echo "已恢复：订阅类型 = $value"
                ;;
            wizard_sub_url)
                wizard_sub_url="$value"
                echo "已恢复：订阅URL = $value"
                ;;
            wizard_sub_path)
                wizard_sub_path="$value"
                echo "已恢复：订阅路径 = $value"
                ;;
            wizard_refresh_interval)
                wizard_refresh_interval="$value"
                echo "已恢复：刷新间隔 = $value"
                ;;
        esac
    done < "${SETTINGS_FILE}"
    
    echo "✅ 配置恢复完成"
    return 0
}

# 主流程
if detect_reinstall; then
    echo "🎯 重装场景：将跳过向导，直接使用保存的配置"
    # 标记为快速安装模式
    echo "QUICK_INSTALL=true" >> "${TRIM_PKGVAR}/.install_env"
else
    echo "🆕 首次安装：将显示完整安装向导"
fi

echo "=========================================="
exit 0
