#!/bin/bash

# MiProxy 主进程管理脚本
# mihomo 订阅自动刷新由 proxy-providers 内置 interval 功能实现，无需外部守护进程

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

# MiProxy 核心路径
MIHOMO_BIN="${TRIM_PKGVAR}/target/mihomo"
MIHOMO_DIR="${TRIM_PKGVAR}"
MIHOMO_CONFIG="${TRIM_PKGVAR}/config.yaml"

CMD="${MIHOMO_BIN} -d ${MIHOMO_DIR} -f ${MIHOMO_CONFIG}"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> ${LOG_FILE}
}

# ============ 辅助函数 ============

check_process() {
    local pid=$1
    if [ -z "${pid}" ]; then
        return 1
    fi
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

is_running() {
    # 检查 PID 文件中的进程是否仍在运行
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            # 清理过期的 PID 文件
            rm -f "${PID_FILE}"
        fi
    fi
    return 1
}

# ============ miproxy 主进程管理 ============

start_process() {
    if is_running; then
        log_msg "miproxy 已在运行"
        return 0
    fi

    # 启动前先校验二进制和配置文件
    if [ ! -x "${MIHOMO_BIN}" ]; then
        log_msg "错误: mihomo 二进制不存在或不可执行: ${MIHOMO_BIN}"
        return 1
    fi
    if [ ! -f "${MIHOMO_CONFIG}" ]; then
        log_msg "错误: mihomo 配置文件不存在: ${MIHOMO_CONFIG}"
        return 1
    fi

    log_msg "启动 miproxy (cmd: ${CMD})..."
    # 启动 mihomo 到后台，日志写入 LOG_FILE
    bash -c "${CMD}" >> ${LOG_FILE} 2>&1 &
    local pid=$!
    printf "%s" "${pid}" > ${PID_FILE}

    # 等待并验证 mihomo 是否真的启动成功
    sleep 2
    if check_process "${pid}"; then
        log_msg "miproxy 启动完成 (PID: ${pid})"
        return 0
    else
        log_msg "错误: miproxy 启动后立即退出，请检查 ${LOG_FILE}"
        rm -f "${PID_FILE}"
        return 1
    fi
}

stop_process() {
    log_msg "停止 miproxy..."

    local pid=""
    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
    fi

    if [ -z "${pid}" ] || ! check_process "${pid}"; then
        log_msg "进程未运行"
        rm -f "${PID_FILE}"
        return 0
    fi

    log_msg "发送 TERM 信号到 PID:${pid}..."
    kill -TERM ${pid} >> ${LOG_FILE} 2>&1 || true

    local count=0
    while check_process "${pid}" && [ $count -lt 10 ]; do
        sleep 1
        count=$((count + 1))
        log_msg "等待进程退出... (${count}s/10s)"
    done

    if check_process "${pid}"; then
        log_msg "TERM 信号未生效，发送 KILL 信号到 PID:${pid}..."
        kill -KILL "${pid}" 2>/dev/null || true
        sleep 1
    fi
    rm -f "${PID_FILE}"
    log_msg "进程已停止"
    return 0
}

case "$1" in
start)
    if start_process; then
        exit 0
    else
        # 把错误写到 fnOS 能识别的地方
        echo "miproxy 启动失败，请查看 ${LOG_FILE}" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
        exit 1
    fi
    ;;
stop)
    stop_process
    exit $?
    ;;
restart)
    stop_process
    sleep 2
    if start_process; then
        exit 0
    else
        exit 1
    fi
    ;;
status)
    if is_running; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac