#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
REFRESH_PID_FILE="${TRIM_PKGVAR}/refresh_subscription.pid"
REFRESH_CONF="${TRIM_PKGVAR}/refresh_subscription.conf"

# MiProxy 核心路径
MIHOMO_BIN="${TRIM_PKGVAR}/target/mihomo"
# 工作目录应该是 var 目录，不是 target 目录（mihomo 会从这里找 geoip.dat 等）
MIHOMO_DIR="${TRIM_PKGVAR}"
MIHOMO_CONFIG="${TRIM_PKGVAR}/config.yaml"

# 关键：必须用绝对路径
# 使用 nohup 确保进程不被 SIGHUP 影响
CMD="nohup ${MIHOMO_BIN} -d ${MIHOMO_DIR} -f ${MIHOMO_CONFIG}"

# 守护进程脚本路径
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> ${LOG_FILE}
}

# ============ 订阅刷新守护进程管理 ============

start_refresh_daemon() {
    if [ ! -f "${REFRESH_CONF}" ]; then
        log_msg "守护进程配置不存在，跳过"
        return 1
    fi

    local sub_type sub_url sub_path interval
    sub_type=$(grep -E "^SUBSCRIPTION_TYPE=" "${REFRESH_CONF}" | cut -d= -f2)
    sub_url=$(grep -E "^SUBSCRIPTION_URL=" "${REFRESH_CONF}" | cut -d= -f2)
    sub_path=$(grep -E "^SUBSCRIPTION_PATH=" "${REFRESH_CONF}" | cut -d= -f2)
    interval=$(grep -E "^REFRESH_INTERVAL=" "${REFRESH_CONF}" | cut -d= -f2)

    if [ "${interval}" = "0" ] || [ -z "${interval}" ]; then
        log_msg "守护进程禁用（interval=${interval}）"
        return 0
    fi
    if [ "${sub_type}" = "none" ] || { [ -z "${sub_url}" ] && [ -z "${sub_path}" ]; }; then
        log_msg "无订阅源，跳过守护进程"
        return 0
    fi

    if [ ! -f "${SCRIPT_DIR}/refresh_subscription_loop.sh" ]; then
        log_msg "守护进程脚本不存在"
        return 1
    fi

    if [ -f "${REFRESH_PID_FILE}" ]; then
        local existing_pid
        existing_pid=$(head -n 1 "${REFRESH_PID_FILE}" | tr -d '[:space:]')
        if kill -0 "${existing_pid}" 2>/dev/null; then
            log_msg "守护进程已运行（PID=${existing_pid}），跳过启动"
            return 0
        fi
        rm -f "${REFRESH_PID_FILE}"
    fi

    log_msg "启动订阅刷新守护进程 (interval=${interval}s, type=${sub_type})..."
    nohup bash "${SCRIPT_DIR}/refresh_subscription_loop.sh" >> "${TRIM_PKGVAR}/subscription_refresh.log" 2>&1 &
    disown 2>/dev/null || true
    sleep 1
    return 0
}

stop_refresh_daemon() {
    if [ ! -f "${REFRESH_PID_FILE}" ]; then
        return 0
    fi
    local pid
    pid=$(head -n 1 "${REFRESH_PID_FILE}" | tr -d '[:space:]')
    if [ -z "${pid}" ]; then
        rm -f "${REFRESH_PID_FILE}"
        return 0
    fi

    if kill -0 "${pid}" 2>/dev/null; then
        log_msg "停止守护进程 PID=${pid}..."
        kill -TERM "${pid}" 2>>"${LOG_FILE}" || true
        local count=0
        while kill -0 "${pid}" 2>/dev/null && [ $count -lt 5 ]; do
            sleep 1
            count=$((count + 1))
        done
        if kill -0 "${pid}" 2>/dev/null; then
            kill -KILL "${pid}" 2>/dev/null || true
        fi
    fi
    rm -f "${REFRESH_PID_FILE}"
    return 0
}

restart_refresh_daemon() {
    log_msg "重启守护进程..."
    stop_refresh_daemon
    sleep 1
    start_refresh_daemon
    log_msg "守护进程重启完成"
}

# ============ miproxy 主进程管理 ============

start_process() {
    if status; then
        log_msg "进程已在运行"
        return 0
    fi

    log_msg "Starting process..."
    log_msg "MIHOMO_BIN=${MIHOMO_BIN}"
    log_msg "MIHOMO_DIR=${MIHOMO_DIR}"
    log_msg "MIHOMO_CONFIG=${MIHOMO_CONFIG}"
    
    # 检查文件是否存在
    if [ ! -f "${MIHOMO_BIN}" ]; then
        log_msg "错误: mihomo 二进制文件不存在: ${MIHOMO_BIN}"
        return 1
    fi
    if [ ! -f "${MIHOMO_CONFIG}" ]; then
        log_msg "错误: 配置文件不存在: ${MIHOMO_CONFIG}"
        return 1
    fi
    
    # 启动 mihomo
    cd "${MIHOMO_DIR}"
    nohup ${MIHOMO_BIN} -d "${MIHOMO_DIR}" -f "${MIHOMO_CONFIG}" >> ${LOG_FILE} 2>&1 &
    local pid=$!
    printf "%s" "$pid" > ${PID_FILE}
    log_msg "进程已启动 PID=${pid}"
    
    # 等待进程启动
    sleep 2
    
    # 检查进程是否仍在运行
    if kill -0 "${pid}" 2>/dev/null; then
        log_msg "进程启动成功"
        return 0
    else
        log_msg "错误: 进程启动失败"
        rm -f ${PID_FILE}
        return 1
    fi
}

stop_process() {
    log_msg "Stopping process..."

    if [ -r "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')

        if [ -z "${pid}" ]; then
            rm -f "${PID_FILE}"
            log_msg "PID 文件为空"
            return
        fi

        log_msg "pid=${pid}"
        if ! kill -0 "${pid}" 2>/dev/null; then
            rm -f "${PID_FILE}"
            log_msg "进程不存在"
            return
        fi

        log_msg "send TERM signal to PID:${pid}..."
        kill -TERM ${pid} >> ${LOG_FILE} 2>&1

        local count=0
        while kill -0 "${pid}" 2>/dev/null && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
            log_msg "waiting process terminal... (${count}s/10s)"
        done

        if kill -0 "${pid}" 2>/dev/null; then
            log_msg "send KILL signal to PID:${pid}..."
            kill -KILL "${pid}" 2>/dev/null || true
            sleep 1
        fi
        rm -f "${PID_FILE}"
        log_msg "process stopped"
    else
        log_msg "PID 文件不存在"
    fi

    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
            return 0
        else
            rm -f "${PID_FILE}"
        fi
    fi
    return 1
}

start_full() {
    stop_refresh_daemon
    sleep 1
    start_process
    sleep 1
    start_refresh_daemon
}

stop_full() {
    stop_refresh_daemon
    stop_process
}

case $1 in
start)
    start_full
    ;;
stop)
    stop_full
    ;;
restart)
    stop_full
    sleep 2
    start_full
    ;;
start-refresh)
    start_refresh_daemon
    ;;
stop-refresh)
    stop_refresh_daemon
    ;;
restart-refresh)
    restart_refresh_daemon
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
