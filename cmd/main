#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
REFRESH_PID_FILE="${TRIM_PKGVAR}/refresh_subscription.pid"
REFRESH_CONF="${TRIM_PKGVAR}/refresh_subscription.conf"

# MiProxy 核心路径
MIHOMO_BIN="${TRIM_PKGVAR}/target/mihomo"
MIHOMO_DIR="${TRIM_PKGVAR}"
MIHOMO_CONFIG="${TRIM_PKGVAR}/config.yaml"

# 脚本目录
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

# ============ 清理残留进程 ============
cleanup_leftover() {
    log_msg "检查残留进程..."
    # 杀死可能残留的 mihomo 进程
    if pgrep -f "mihomo.*${MIHOMO_CONFIG}" > /dev/null 2>&1; then
        log_msg "发现残留 mihomo 进程，正在清理..."
        pkill -9 -f "mihomo.*${MIHOMO_CONFIG}" 2>/dev/null || true
        sleep 1
    fi
    # 清理端口占用
    for port in 9090 7890; do
        pid=$(lsof -ti:${port} 2>/dev/null || fuser ${port}/tcp 2>/dev/null | head -1)
        if [ -n "${pid}" ]; then
            log_msg "发现端口 ${port} 被占用 (PID: ${pid})，正在清理..."
            kill -9 ${pid} 2>/dev/null || true
            sleep 1
        fi
    done
}

# ============ 订阅刷新守护进程管理 ============

start_refresh_daemon() {
    if [ ! -f "${REFRESH_CONF}" ]; then
        log_msg "守护进程配置不存在，跳过"
        return 0
    fi

    local sub_type sub_url sub_path interval
    sub_type=$(grep -E "^SUBSCRIPTION_TYPE=" "${REFRESH_CONF}" | cut -d= -f2)
    sub_url=$(grep -E "^SUBSCRIPTION_URL=" "${REFRESH_CONF}" | cut -d= -f2)
    sub_path=$(grep -E "^SUBSCRIPTION_PATH=" "${REFRESH_CONF}" | cut -d= -f2)
    interval=$(grep -E "^REFRESH_INTERVAL=" "${REFRESH_CONF}" | cut -d= -f2)

    if [ "${interval}" = "0" ] || [ -z "${interval}" ]; then
        log_msg "守护进程禁用"
        return 0
    fi
    if [ "${sub_type}" = "none" ] || { [ -z "${sub_url}" ] && [ -z "${sub_path}" ]; }; then
        log_msg "无订阅源，跳过守护进程"
        return 0
    fi

    if [ ! -f "${SCRIPT_DIR}/refresh_subscription_loop.sh" ]; then
        log_msg "守护进程脚本不存在"
        return 0
    fi

    # 检查是否已在运行
    if [ -f "${REFRESH_PID_FILE}" ]; then
        local existing_pid
        existing_pid=$(head -n 1 "${REFRESH_PID_FILE}" | tr -d '[:space:]')
        if [ -n "${existing_pid}" ] && kill -0 "${existing_pid}" 2>/dev/null; then
            log_msg "守护进程已在运行 (PID=${existing_pid})"
            return 0
        fi
        rm -f "${REFRESH_PID_FILE}"
    fi

    log_msg "启动订阅刷新守护进程..."
    bash "${SCRIPT_DIR}/refresh_subscription_loop.sh" >> "${TRIM_PKGVAR}/subscription_refresh.log" 2>&1 &
    sleep 1
    return 0
}

stop_refresh_daemon() {
    if [ -f "${REFRESH_PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${REFRESH_PID_FILE}" | tr -d '[:space:]')
        if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
            log_msg "停止守护进程 PID=${pid}..."
            kill -TERM "${pid}" 2>/dev/null || true
            sleep 1
            kill -9 "${pid}" 2>/dev/null || true
        fi
        rm -f "${REFRESH_PID_FILE}"
    fi
    # 也尝试用 pkill
    pkill -f "refresh_subscription_loop" 2>/dev/null || true
    return 0
}

# ============ miproxy 主进程管理 ============

start_process() {
    # 先清理残留
    cleanup_leftover
    
    # 检查文件
    if [ ! -f "${MIHOMO_BIN}" ]; then
        log_msg "错误: mihomo 不存在: ${MIHOMO_BIN}"
        return 1
    fi
    if [ ! -f "${MIHOMO_CONFIG}" ]; then
        log_msg "错误: 配置文件不存在: ${MIHOMO_CONFIG}"
        return 1
    fi
    
    log_msg "启动 mihomo..."
    cd "${MIHOMO_DIR}"
    ${MIHOMO_BIN} -d "${MIHOMO_DIR}" -f "${MIHOMO_CONFIG}" >> "${LOG_FILE}" 2>&1 &
    local pid=$!
    echo "${pid}" > "${PID_FILE}"
    log_msg "mihomo 已启动 PID=${pid}"
    
    sleep 2
    
    if kill -0 "${pid}" 2>/dev/null; then
        log_msg "mihomo 启动成功"
        return 0
    else
        log_msg "mihomo 启动失败"
        rm -f "${PID_FILE}"
        return 1
    fi
}

stop_process() {
    log_msg "停止 mihomo..."
    
    # 方法1: 通过 PID 文件
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "${pid}" ]; then
            if kill -0 "${pid}" 2>/dev/null; then
                log_msg "通过 PID 停止 PID=${pid}"
                kill -TERM "${pid}" 2>/dev/null || true
                sleep 2
                kill -9 "${pid}" 2>/dev/null || true
            fi
        fi
        rm -f "${PID_FILE}"
    fi
    
    # 方法2: 通过端口
    for port in 9090 7890; do
        local pids
        pids=$(lsof -ti:${port} 2>/dev/null || fuser ${port}/tcp 2>/dev/null)
        if [ -n "${pids}" ]; then
            for p in ${pids}; do
                log_msg "通过端口 ${port} 停止 PID=${p}"
                kill -9 "${p}" 2>/dev/null || true
            done
        fi
    done
    
    # 方法3: pkill
    pkill -9 -f "mihomo.*${MIHOMO_CONFIG}" 2>/dev/null || true
    
    sleep 1
    log_msg "mihomo 已停止"
    return 0
}

status() {
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
            return 0
        fi
    fi
    # 也检查端口
    if lsof -ti:9090 > /dev/null 2>&1 || fuser 9090/tcp > /dev/null 2>&1; then
        return 0
    fi
    return 1
}

start_full() {
    log_msg "=== 启动 MiProxy ==="
    stop_refresh_daemon
    stop_process
    sleep 2
    start_process
    sleep 1
    start_refresh_daemon
    log_msg "=== 启动完成 ==="
}

stop_full() {
    log_msg "=== 停止 MiProxy ==="
    stop_refresh_daemon
    stop_process
    log_msg "=== 停止完成 ==="
}

case "$1" in
start)
    start_full
    ;;
stop)
    stop_full
    ;;
restart)
    stop_full
    sleep 2
    start_full
    ;;
start-refresh)
    start_refresh_daemon
    ;;
stop-refresh)
    stop_refresh_daemon
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
