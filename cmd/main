#!/bin/bash

# MiProxy 主进程管理脚本

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
REFRESH_PID_FILE="${TRIM_PKGVAR}/refresh_sub.pid"
MIHOMO_BIN="${TRIM_PKGVAR}/target/mihomo"
MIHOMO_DIR="${TRIM_PKGVAR}"
MIHOMO_CONFIG="${TRIM_PKGVAR}/config.yaml"
CMD="${MIHOMO_BIN} -d ${MIHOMO_DIR} -f ${MIHOMO_CONFIG}"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> ${LOG_FILE}
}

check_process() {
    local pid=$1
    [ -z "${pid}" ] && return 1
    kill -0 "${pid}" 2>/dev/null
}

is_running() {
    if [ -f "${PID_FILE}" ]; then
        local pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then return 0; else rm -f "${PID_FILE}"; fi
    fi
    return 1
}

find_script() {
    local name="$1"
    for p in "/var/packages/miproxy/cmd/${name}" "${TRIM_APPDEST}/cmd/${name}" "${TRIM_APPDEST}/${name}"; do
        [ -f "${p}" ] && echo "${p}" && return
    done
    local dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
    [ -n "${dir}" ] && [ -f "${dir}/${name}" ] && echo "${dir}/${name}"
}

start_refresh_daemon() {
    [ ! -f "${TRIM_PKGETC}/settings.conf" ] && log_msg "配置文件不存在，跳过" && return 0
    
    local sub_type=$(grep '^wizard_sub_type=' "${TRIM_PKGETC}/settings.conf" 2>/dev/null | cut -d= -f2- | tr -d '
')
    local sub_url=$(grep '^wizard_sub_url=' "${TRIM_PKGETC}/settings.conf" 2>/dev/null | cut -d= -f2- | tr -d '
')
    local refresh_interval=$(grep '^wizard_refresh_interval=' "${TRIM_PKGETC}/settings.conf" 2>/dev/null | cut -d= -f2- | tr -d '
')
    
    [ "${sub_type}" != "remote" ] && log_msg "订阅类型为 ${sub_type}，不启动" && return 0
    [ -z "${sub_url}" ] && log_msg "订阅 URL 为空" && return 0
    [ -z "${refresh_interval}" ] || [ "${refresh_interval}" -le 0 ] 2>/dev/null && log_msg "刷新间隔无效" && return 0
    
    [ -f "${REFRESH_PID_FILE}" ] && {
        local epid=$(head -n 1 "${REFRESH_PID_FILE}" | tr -d '[:space:]')
        check_process "${epid}" && log_msg "守护进程已在运行" && return 0
        rm -f "${REFRESH_PID_FILE}"
    }
    
    log_msg "启动订阅刷新守护进程 (间隔: ${refresh_interval} 小时)..."
    local rs=$(find_script "refresh_sub")
    [ -z "${rs}" ] || [ ! -f "${rs}" ] && log_msg "错误: 无法找到 refresh_sub" && return 1
    
    nohup bash "${rs}" >> "${LOG_FILE}" 2>&1 &
    echo "$!" > "${REFRESH_PID_FILE}"
    sleep 1
    check_process "$(head -n 1 "${REFRESH_PID_FILE}" | tr -d '[:space:]')" && log_msg "守护进程已启动" || log_msg "警告：守护进程启动失败"
}

stop_refresh_daemon() {
    [ ! -f "${REFRESH_PID_FILE}" ] && return
    local pid=$(head -n 1 "${REFRESH_PID_FILE}" | tr -d '[:space:]')
    [ -n "${pid}" ] && check_process "${pid}" && kill -TERM "${pid}" >> ${LOG_FILE} 2>&1 || true
    rm -f "${REFRESH_PID_FILE}"
}

start_process() {
    is_running && log_msg "miproxy 已在运行" && return 0
    [ ! -x "${MIHOMO_BIN}" ] && log_msg "错误: mihomo 不存在" && return 1
    [ ! -f "${MIHOMO_CONFIG}" ] && log_msg "错误: 配置文件不存在" && return 1
    
    log_msg "启动 miproxy..."
    bash -c "${CMD}" >> ${LOG_FILE} 2>&1 &
    printf "%s" "$!" > ${PID_FILE}
    sleep 2
    check_process "$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')" && log_msg "miproxy 启动完成" && start_refresh_daemon && return 0
    log_msg "错误: miproxy 启动失败"
    rm -f "${PID_FILE}"
    return 1
}

stop_process() {
    log_msg "停止 miproxy..."
    stop_refresh_daemon
    local pid=""
    [ -r "${PID_FILE}" ] && pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
    [ -z "${pid}" ] || ! check_process "${pid}" && log_msg "进程未运行" && rm -f "${PID_FILE}" && return 0
    kill -TERM "${pid}" >> ${LOG_FILE} 2>&1 || true
    local c=0
    while check_process "${pid}" && [ $c -lt 10 ]; do sleep 1; c=$((c+1)); done
    check_process "${pid}" && kill -KILL "${pid}" 2>/dev/null || true
    rm -f "${PID_FILE}"
    log_msg "进程已停止"
}

case "$1" in
start) start_process; exit $? ;;
stop) stop_process; exit $? ;;
restart) stop_process; sleep 2; start_process; exit $? ;;
status) is_running; exit $? ;;
*) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac

