#!/bin/bash

# MiProxy 主进程管理脚本
# 启动时自动调用 refresh_sub 守护进程实现定时订阅刷新

# ============================================
# 使用 TRIM_* 变量定义路径
# ============================================
LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
REFRESH_PID_FILE="${TRIM_PKGVAR}/refresh_sub.pid"

# MiProxy 核心路径（使用 TRIM_APPDEST）
MIHOMO_BIN="${TRIM_PKGVAR}/target/mihomo"  # 运行时数据目录
MIHOMO_DIR="${TRIM_PKGVAR}"
MIHOMO_CONFIG="${TRIM_PKGVAR}/config.yaml"

# 检查是否启用 TUN 模式
TUN_ENABLED="false"
if [ -f "${TRIM_PKGETC}/settings.conf" ]; then
    TUN_ENABLED=$(grep ^wizard_tun_enable= "${TRIM_PKGETC}/settings.conf" 2>/dev/null | cut -d= -f2- | tr -d '

')
fi

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> ${LOG_FILE}
}

# ============ 辅助函数 ============

check_process() {
    local pid=$1
    if [ -z "${pid}" ]; then
        return 1
    fi
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

is_running() {
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            rm -f "${PID_FILE}"
        fi
    fi
    return 1
}

# ============ 订阅刷新守护进程管理 ============

find_script() {
    local name="$1"
    local script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    local target="${script_dir}/${name}"
    if [ -f "${target}" ]; then
        echo "${target}"
        return 0
    fi
    return 1
}


start_refresh_daemon() {
    if [ ! -f "${TRIM_PKGETC}/settings.conf" ]; then
        log_msg "配置文件不存在，跳过订阅刷新守护进程"
        return 0
    fi
    
    local sub_type sub_url refresh_interval
    sub_type=$(grep '^wizard_sub_type=' "${TRIM_PKGETC}/settings.conf" 2>/dev/null | cut -d= -f2- | tr -d '

')
    sub_url=$(grep '^wizard_sub_url=' "${TRIM_PKGETC}/settings.conf" 2>/dev/null | cut -d= -f2- | tr -d '

')
    refresh_interval=$(grep '^wizard_refresh_interval=' "${TRIM_PKGETC}/settings.conf" 2>/dev/null | cut -d= -f2- | tr -d '

')
    
    if [ "${sub_type}" != "remote" ]; then
        log_msg "订阅类型为 ${sub_type}，不启动刷新守护进程"
        return 0
    fi
    
    if [ -z "${sub_url}" ]; then
        log_msg "订阅 URL 为空，不启动刷新守护进程"
        return 0
    fi
    
    if [ -z "${refresh_interval}" ] || [ "${refresh_interval}" -le 0 ] 2>/dev/null; then
        log_msg "刷新间隔为 ${refresh_interval} 小时，不启动刷新守护进程"
        return 0
    fi
    
    if [ -f "${REFRESH_PID_FILE}" ]; then
        local existing_pid
        existing_pid=$(head -n 1 "${REFRESH_PID_FILE}" | tr -d '[:space:]')
        if check_process "${existing_pid}"; then
            log_msg "订阅刷新守护进程已在运行 (PID: ${existing_pid})"
            return 0
        else
            rm -f "${REFRESH_PID_FILE}"
        fi
    fi
    
    log_msg "启动订阅刷新守护进程 (间隔: ${refresh_interval} 小时)..."
    
    local refresh_sub_script
    refresh_sub_script=$(find_script "refresh_sub")
    
    if [ -z "${refresh_sub_script}" ]; then
        log_msg "错误: 无法找到 refresh_sub 脚本"
        return 1
    fi
    
    nohup env TRIM_PKGVAR="${TRIM_PKGVAR}" TRIM_PKGETC="${TRIM_PKGETC}" TRIM_APPDEST="${TRIM_APPDEST}" bash "${refresh_sub_script}" >> "${LOG_FILE}" 2>&1 &
    local new_pid=$!
    echo "${new_pid}" > "${REFRESH_PID_FILE}"
    
    sleep 1
    if check_process "${new_pid}"; then
        log_msg "订阅刷新守护进程已启动 (PID: ${new_pid})"
    else
        log_msg "警告：订阅刷新守护进程启动失败"
        rm -f "${REFRESH_PID_FILE}"
    fi
}

stop_refresh_daemon() {
    if [ -f "${REFRESH_PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${REFRESH_PID_FILE}" | tr -d '[:space:]')
        if [ -n "${pid}" ] && check_process "${pid}"; then
            log_msg "停止订阅刷新守护进程 (PID: ${pid})..."
            kill -TERM "${pid}" >> ${LOG_FILE} 2>&1 || true
            sleep 1
            if check_process "${pid}"; then
                kill -KILL "${pid}" >> ${LOG_FILE} 2>&1 || true
            fi
        fi
        rm -f "${REFRESH_PID_FILE}"
    fi
}

# ============ miproxy 主进程管理 ============

start_process() {
    if is_running; then
        log_msg "miproxy 已在运行"
        return 0
    fi

    if [ ! -x "${MIHOMO_BIN}" ]; then
        log_msg "错误: mihomo 二进制不存在或不可执行: ${MIHOMO_BIN}"
        return 1
    fi
    if [ ! -f "${MIHOMO_CONFIG}" ]; then
        log_msg "错误: mihomo 配置文件不存在: ${MIHOMO_CONFIG}"
        return 1
    fi

    log_msg "启动 miproxy (TUN: ${TUN_ENABLED}, cmd: ${MIHOMO_BIN} -d ${MIHOMO_DIR} -f ${MIHOMO_CONFIG})..."
    
    # privilege=root 时以 root 启动（TUN 必须），否则降权
    if [ -n "${TRIM_USERNAME}" ]; then
        if [ "${TUN_ENABLED}" = "true" ]; then
            log_msg "TUN 模式已启用，以 root 启动 mihomo..."
            bash -c "${MIHOMO_BIN} -d ${MIHOMO_DIR} -f ${MIHOMO_CONFIG}" >> ${LOG_FILE} 2>&1 &
        else
            log_msg "以降权用户 ${TRIM_USERNAME} 启动..."
            runuser -u "${TRIM_USERNAME}" -- bash -c "${MIHOMO_BIN} -d ${MIHOMO_DIR} -f ${MIHOMO_CONFIG}" >> ${LOG_FILE} 2>&1 &
        fi
    else
        log_msg "启动 mihomo（未降权）..."
        bash -c "${MIHOMO_BIN} -d ${MIHOMO_DIR} -f ${MIHOMO_CONFIG}" >> ${LOG_FILE} 2>&1 &
    fi
        log_msg "以降权用户 ${TRIM_USERNAME} 启动..."
        runuser -u "${TRIM_USERNAME}" -- bash -c "${MIHOMO_BIN} -d ${MIHOMO_DIR} -f ${MIHOMO_CONFIG}" >> ${LOG_FILE} 2>&1 &
    else
        log_msg "启动 mihomo（未降权）..."
        bash -c "${MIHOMO_BIN} -d ${MIHOMO_DIR} -f ${MIHOMO_CONFIG}" >> ${LOG_FILE} 2>&1 &
    fi
    
    local pid=$!
    printf "%s" "${pid}" > ${PID_FILE}

    sleep 2
    if check_process "${pid}"; then
        log_msg "miproxy 启动完成 (PID: ${pid})"
        start_refresh_daemon
        return 0
    else
        log_msg "错误: miproxy 启动后立即退出，请检查 ${LOG_FILE}"
        rm -f "${PID_FILE}"
        return 1
    fi
}

stop_process() {
    log_msg "停止 miproxy..."

    stop_refresh_daemon

    local pid=""
    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
    fi

    if [ -z "${pid}" ] || ! check_process "${pid}"; then
        log_msg "进程未运行"
        rm -f "${PID_FILE}"
        return 0
    fi

    log_msg "发送 TERM 信号到 PID:${pid}..."
    kill -TERM ${pid} >> ${LOG_FILE} 2>&1 || true

    local count=0
    while check_process "${pid}" && [ $count -lt 10 ]; do
        sleep 1
        count=$((count + 1))
        log_msg "等待进程退出... (${count}s/10s)"
    done

    if check_process "${pid}"; then
        log_msg "TERM 信号未生效，发送 KILL 信号到 PID:${pid}..."
        kill -KILL "${pid}" 2>/dev/null || true
        sleep 1
    fi
    rm -f "${PID_FILE}"
    log_msg "进程已停止"
    return 0
}

case "$1" in
start)
    if start_process; then
        exit 0
    else
        echo "miproxy 启动失败，请查看 ${LOG_FILE}" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
        exit 1
    fi
    ;;
stop)
    stop_process
    exit $?
    ;;
restart)
    stop_process
    sleep 2
    if start_process; then
        exit 0
    else
        exit 1
    fi
    ;;
status)
    if is_running; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac