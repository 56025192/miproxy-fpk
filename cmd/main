#!/bin/bash

# MiProxy 服务管理脚本
# 支持：start, stop, restart, status, api

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
CONFIG_FILE="${TRIM_PKGVAR}/config.yaml"
SETTINGS_FILE="${TRIM_PKGETC}/settings.conf"
MIHOMO_BIN="${TRIM_PKGVAR}/target/mihomo"
MIHOMO_DIR="${TRIM_PKGVAR}"
API_PORT=9090

mkdir -p "${TRIM_PKGVAR}" "${TRIM_PKGETC}" "${TRIM_PKGVAR}/target" 2>/dev/null

log_msg() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"; }

check_process() { local pid=$1; [ -z "${pid}" ] && return 1; kill -0 "${pid}" 2>/dev/null; }

is_running() {
    if [ -f "${PID_FILE}" ]; then
        local pid=$(head -n 1 "${PID_FILE}" | tr -d ' \n\r')
        if check_process "${pid}"; then return 0; else rm -f "${PID_FILE}"; fi
    fi
    return 1
}

prepare_binary() {
    if [ ! -x "${MIHOMO_BIN}" ]; then
        mkdir -p "${TRIM_PKGVAR}/target"
        if [ -f "${TRIM_APPDEST}/server/mihomo" ]; then
            cp -f "${TRIM_APPDEST}/server/mihomo" "${MIHOMO_BIN}"
            chmod +x "${MIHOMO_BIN}"
        fi
    fi
}

generate_default_config() {
    local http_port=$(grep '^wizard_http_port=' "${SETTINGS_FILE}" 2>/dev/null | cut -d= -f2- | tr -d ' \n\r')
    http_port=${http_port:-7890}
    local api_port=$(grep '^wizard_api_port=' "${SETTINGS_FILE}" 2>/dev/null | cut -d= -f2- | tr -d ' \n\r')
    api_port=${api_port:-${API_PORT}}
    local secret=$(grep '^wizard_secret=' "${SETTINGS_FILE}" 2>/dev/null | cut -d= -f2- | tr -d ' \n\r')
    local sub_type=$(grep '^wizard_sub_type=' "${SETTINGS_FILE}" 2>/dev/null | cut -d= -f2- | tr -d ' \n\r')
    sub_type=${sub_type:-none}
    local sub_url=$(grep '^wizard_sub_url=' "${SETTINGS_FILE}" 2>/dev/null | cut -d= -f2- | tr -d ' \n\r')
    local mode=$(grep '^wizard_mode=' "${SETTINGS_FILE}" 2>/dev/null | cut -d= -f2- | tr -d ' \n\r')
    mode=${mode:-rule}
    local allow_lan=$(grep '^wizard_allow_lan=' "${SETTINGS_FILE}" 2>/dev/null | cut -d= -f2- | tr -d ' \n\r')
    allow_lan=${allow_lan:-true}
    local log_level=$(grep '^wizard_log_level=' "${SETTINGS_FILE}" 2>/dev/null | cut -d= -f2- | tr -d ' \n\r')
    log_level=${log_level:-info}
    
    cat > "${CONFIG_FILE}" << 'EOFCONFIG'
# MiProxy 配置文件
mixed-port: MIXED_PORT
allow-lan: ALLOW_LAN
mode: MODE
log-level: LOG_LEVEL
ipv6: false
external-controller: 0.0.0.0:API_PORT
external-ui: UI_TARGET
external-ui-name: zashboard
SECRET_LINE
external-controller-cors:
  allow-private-network: true
  allow-origins: ["*"]
geodata-mode: true
geodata-loader: memconservative
tun:
  enable: false
dns:
  enable: true
  listen: 0.0.0.0:53
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - +.lan
    - +.local
  nameserver:
    - 223.5.5.5
    - 119.29.29.29
proxy-groups:
  - name: PROXY
    type: select
    proxies:
      - DIRECT
rules:
  - GEOIP,CN,DIRECT
  - MATCH,PROXY
EOFCONFIG

    # 替换变量
    sed -i "s/MIXED_PORT/${http_port}/" "${CONFIG_FILE}"
    sed -i "s/API_PORT/${api_port}/" "${CONFIG_FILE}"
    sed -i "s/ALLOW_LAN/${allow_lan}/" "${CONFIG_FILE}"
    sed -i "s/MODE/${mode}/" "${CONFIG_FILE}"
    sed -i "s/LOG_LEVEL/${log_level}/" "${CONFIG_FILE}"
    sed -i "s|UI_TARGET|${TRIM_PKGVAR}/ui|" "${CONFIG_FILE}"
    
    if [ -n "$secret" ]; then
        sed -i "s|SECRET_LINE|secret: \"${secret}\"|" "${CONFIG_FILE}"
    else
        sed -i "s/SECRET_LINE//" "${CONFIG_FILE}"
    fi
    
    chmod 644 "${CONFIG_FILE}" 2>/dev/null
    log_msg "配置已生成: ${CONFIG_FILE}"
}

do_start() {
    log_msg "启动 miproxy..."
    prepare_binary
    [ ! -x "${MIHOMO_BIN}" ] && { log_msg "错误: mihomo 二进制不存在"; return 1; }
    [ ! -f "${CONFIG_FILE}" ] && generate_default_config
    is_running && { log_msg "服务已在运行"; return 0; }
    bash -c "${MIHOMO_BIN} -d ${MIHOMO_DIR} -f ${CONFIG_FILE}" >> "${LOG_FILE}" 2>&1 &
    local pid=$!
    sleep 2
    if check_process "${pid}"; then
        echo "${pid}" > "${PID_FILE}"
        log_msg "启动成功 (PID: ${pid})"
        return 0
    fi
    log_msg "启动失败"
    return 1
}

do_stop() {
    log_msg "停止 miproxy..."
    local pid=""
    [ -f "${PID_FILE}" ] && pid=$(head -n 1 "${PID_FILE}" | tr -d ' \n\r')
    [ -z "${pid}" ] || ! check_process "${pid}" && { log_msg "服务未运行"; rm -f "${PID_FILE}"; return 0; }
    kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1 || true
    local count=0
    while check_process "${pid}" && [ $count -lt 10 ]; do
        sleep 1
        count=$((count + 1))
    done
    check_process "${pid}" && kill -KILL "${pid}" 2>/dev/null || true
    rm -f "${PID_FILE}"
    log_msg "服务已停止"
    return 0
}

do_status() {
    if is_running; then
        local pid=$(head -n 1 "${PID_FILE}" | tr -d ' \n\r')
        log_msg "运行中 (PID: ${pid})"
        exit 0
    fi
    log_msg "未运行"
    exit 3
}

write_settings() {
    local key=$1 value=$2
    [ ! -f "${SETTINGS_FILE}" ] && touch "${SETTINGS_FILE}"
    grep -q "^wizard_${key}=" "${SETTINGS_FILE}" &&         sed -i "s/^wizard_${key}=.*/wizard_${key}=${value}/" "${SETTINGS_FILE}" ||         echo "wizard_${key}=${value}" >> "${SETTINGS_FILE}"
}

do_api() {
    case "${PATH_INFO:-/}" in
    /init)
        if [ "${REQUEST_METHOD}" = "POST" ]; then
            write_settings "http_port" "7890"
            write_settings "api_port" "${API_PORT}"
            generate_default_config
            do_start
            echo "{"success": true}"
        else
            if [ -f "${CONFIG_FILE}" ]; then
                cat "${CONFIG_FILE}"
            else
                echo "{"error": "not_found"}"
            fi
        fi
        ;;
    /status)
        if is_running; then
            local pid=$(head -n 1 "${PID_FILE}" | tr -d ' \n\r')
            echo "{"running": true, "pid": "${pid}"}"
        else
            echo "{"running": false, "pid": ""}"
        fi
        ;;
    /config/current)
        http_port=$(grep '^wizard_http_port=' "${SETTINGS_FILE}" 2>/dev/null | cut -d= -f2- | tr -d ' \n\r' || echo 7890)
        api_port=$(grep '^wizard_api_port=' "${SETTINGS_FILE}" 2>/dev/null | cut -d= -f2- | tr -d ' \n\r' || echo ${API_PORT})
        sub_type=$(grep '^wizard_sub_type=' "${SETTINGS_FILE}" 2>/dev/null | cut -d= -f2- | tr -d ' \n\r' || echo none)
        mode=$(grep '^wizard_mode=' "${SETTINGS_FILE}" 2>/dev/null | cut -d= -f2- | tr -d ' \n\r' || echo rule)
        echo "{"httpPort": ${http_port}, "apiPort": ${api_port}, "subType": "${sub_type}", "mode": "${mode}"}"
        ;;
    /config/preview)
        [ -f "${CONFIG_FILE}" ] && cat "${CONFIG_FILE}" || echo "# 无配置"
        ;;
    *)
        echo "{"error": "not_found"}"
        ;;
    esac
}

case "$1" in
start) do_start; exit $? ;;
stop) do_stop; exit $? ;;
restart) do_stop; sleep 1; do_start; exit $? ;;
status) do_status ;;
api) do_api ;;
*) echo "Usage: $0 {start|stop|restart|status|api}"; exit 1 ;;
esac
