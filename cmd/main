#!/bin/bash
#
# MiProxy 服务管理脚本
# 功能：启动、停止、重启 mihomo 服务
#

set +e

# 路径配置
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="$(dirname "$SCRIPT_DIR")"
VAR_DIR="${TRIM_PKGVAR:-/var/packages/miproxy/var}"
LOG_DIR="${VAR_DIR}/logs"
DATA_DIR="${VAR_DIR}/data"
CONF_DIR="${VAR_DIR}/config"

# 二进制文件路径（根据架构选择）
ARCH=$(uname -m)
if [ "$ARCH" = "x86_64" ]; then
    MIHOMO_BIN="${APP_DIR}/app/server/x86_64/mihomo"
elif [ "$ARCH" = "aarch64" ] || [ "$ARCH" = "arm64" ]; then
    MIHOMO_BIN="${APP_DIR}/app/server/arm64/mihomo"
else
    log "警告：不支持的架构 $ARCH，尝试使用 x86_64"
    MIHOMO_BIN="${APP_DIR}/app/server/x86_64/mihomo"
fi

# 配置文件路径
MIHOMO_CONFIG="${CONF_DIR}/config.yaml"
MIHOMO_PID="${VAR_DIR}/miproxy.pid"

# 日志函数
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "${LOG_DIR}/miproxy.log" 2>/dev/null || echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"
}

# 检查服务是否运行
is_running() {
    if [ -f "$MIHOMO_PID" ]; then
        local pid=$(cat "$MIHOMO_PID")
        if kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
        rm -f "$MIHOMO_PID"
    fi
    return 1
}

# 创建默认配置
create_default_config() {
    mkdir -p "${CONF_DIR}" 2>/dev/null
    cat > "$MIHOMO_CONFIG" << 'CONFIG'
port: 7890
socks-port: 7891
allow-lan: true
mode: rule
log-level: info
external-controller: 0.0.0.0:9090

dns:
  enable: true
  enhanced-mode: fake-ip
  nameserver:
    - 223.5.5.5
    - 119.29.29.29

proxies: []
proxy-groups: []
rules: []
CONFIG
    log "默认配置文件已创建: $MIHOMO_CONFIG"
}

# 启动服务
start() {
    log "正在启动 MiProxy 服务..."
    
    # 检查二进制文件
    if [ ! -f "$MIHOMO_BIN" ]; then
        log "错误：找不到 mihomo 二进制文件: $MIHOMO_BIN"
        return 1
    fi
    
    # 检查配置文件
    if [ ! -f "$MIHOMO_CONFIG" ]; then
        log "配置文件不存在，创建默认配置"
        create_default_config
    fi
    
    # 创建日志目录
    mkdir -p "${LOG_DIR}" 2>/dev/null
    
    # 启动 mihomo
    log "启动 mihomo..."
    nohup "$MIHOMO_BIN" -d "$DATA_DIR" -f "$MIHOMO_CONFIG" > "${LOG_DIR}/mihomo.log" 2>&1 &
    local pid=$!
    echo $pid > "$MIHOMO_PID"
    
    # 等待服务启动
    sleep 2
    
    if is_running; then
        log "MiProxy 服务启动成功 (PID: $pid)"
        return 0
    else
        log "警告：MiProxy 服务启动失败，请查看日志 ${LOG_DIR}/mihomo.log"
        return 1
    fi
}

# 停止服务
stop() {
    log "正在停止 MiProxy 服务..."
    
    if [ -f "$MIHOMO_PID" ]; then
        local pid=$(cat "$MIHOMO_PID")
        if kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null || true
            sleep 2
            if kill -0 "$pid" 2>/dev/null; then
                kill -9 "$pid" 2>/dev/null || true
            fi
        fi
        rm -f "$MIHOMO_PID"
    fi
    
    log "MiProxy 服务已停止"
    return 0
}

# 重启服务
restart() {
    stop
    sleep 1
    start
}

# 处理命令
case "$1" in
    start)
        if is_running; then
            log "MiProxy 服务已在运行"
            exit 0
        fi
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    status)
        if is_running; then
            echo "MiProxy 服务正在运行 (PID: $(cat $MIHOMO_PID))"
            exit 0
        else
            echo "MiProxy 服务已停止"
            exit 1
        fi
        ;;
    *)
        echo "用法: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
