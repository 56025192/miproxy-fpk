#!/bin/bash
# MiProxy 订阅刷新守护进程 v2
# 直接管理 mihomo 进程，不依赖外部脚本路径

DEBUG_LOG="${TRIM_PKGVAR}/refresh_sub.log"
LOCK_FILE="${TRIM_PKGVAR}/refresh_sub.lock"
PID_FILE="${TRIM_PKGVAR}/app.pid"
MIHOMO_BIN="${TRIM_PKGVAR}/target/mihomo"
MIHOMO_CONFIG="${TRIM_PKGVAR}/config.yaml"
MIHOMO_DIR="${TRIM_PKGVAR}"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${DEBUG_LOG}"
}

is_mihomo_running() {
    if [ -f "${PID_FILE}" ]; then
        local pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null && return 0
    fi
    return 1
}

stop_mihomo() {
    log_msg "停止 mihomo..."
    if [ -f "${PID_FILE}" ]; then
        local pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "${pid}" ]; then
            kill -TERM "${pid}" 2>/dev/null || true
            sleep 2
            kill -KILL "${pid}" 2>/dev/null || true
        fi
    fi
    rm -f "${PID_FILE}"
}

start_mihomo() {
    log_msg "启动 mihomo..."
    if [ ! -x "${MIHOMO_BIN}" ]; then
        log_msg "错误: mihomo 不存在"
        return 1
    fi
    if [ ! -f "${MIHOMO_CONFIG}" ]; then
        log_msg "错误: 配置文件不存在"
        return 1
    fi
    
    bash -c "${MIHOMO_BIN} -d ${MIHOMO_DIR} -f ${MIHOMO_CONFIG}" >> "${DEBUG_LOG}" 2>&1 &
    local new_pid=$!
    echo "${new_pid}" > "${PID_FILE}"
    sleep 2
    
    if kill -0 "${new_pid}" 2>/dev/null; then
        log_msg "mihomo 启动成功 (PID: ${new_pid})"
        return 0
    else
        log_msg "mihomo 启动失败"
        rm -f "${PID_FILE}"
        return 1
    fi
}

restart_mihomo() {
    stop_mihomo
    sleep 1
    start_mihomo
}

check_should_run() {
    [ ! -f "${TRIM_PKGETC}/settings.conf" ] && return 1
    local sub_type=$(grep '^wizard_sub_type=' "${TRIM_PKGETC}/settings.conf" 2>/dev/null | cut -d= -f2- | tr -d '\n')
    local sub_url=$(grep '^wizard_sub_url=' "${TRIM_PKGETC}/settings.conf" 2>/dev/null | cut -d= -f2- | tr -d '\n')
    local refresh_interval=$(grep '^wizard_refresh_interval=' "${TRIM_PKGETC}/settings.conf" 2>/dev/null | cut -d= -f2- | tr -d '\n')
    
    [ "${sub_type}" = "remote" ] && [ -n "${sub_url}" ] && [ "${refresh_interval}" -gt 0 ] 2>/dev/null
}

get_interval_seconds() {
    local refresh_interval=$(grep '^wizard_refresh_interval=' "${TRIM_PKGETC}/settings.conf" 2>/dev/null | cut -d= -f2- | tr -d '\n')
    echo $((refresh_interval * 3600))
}

do_refresh() {
    [ -f "${LOCK_FILE}" ] && log_msg "上次刷新尚未完成，跳过" && return 0
    touch "${LOCK_FILE}"
    
    local sub_url=$(grep '^wizard_sub_url=' "${TRIM_PKGETC}/settings.conf" 2>/dev/null | cut -d= -f2- | tr -d '\n')
    local sub_cache_path="${TRIM_PKGVAR}/proxy_providers/subscription.yaml"
    
    [ -z "${sub_url}" ] && log_msg "订阅 URL 为空" && rm -f "${LOCK_FILE}" && return 1
    
    log_msg "开始刷新订阅: ${sub_url}"
    
    if curl -fsSL --connect-timeout 15 --max-time 60 "${sub_url}" -o "${sub_cache_path}.tmp" 2>>"${DEBUG_LOG}"; then
        if [ -s "${sub_cache_path}.tmp" ] && grep -qE "^[[:space:]]*proxies:|^[[:space:]]*proxy-providers:" "${sub_cache_path}.tmp" 2>/dev/null; then
            mv "${sub_cache_path}.tmp" "${sub_cache_path}"
            log_msg "订阅下载成功: $(stat -c%s "${sub_cache_path}" 2>/dev/null || wc -c < "${sub_cache_path}") bytes"
            
            # 直接重启 mihomo，不依赖外部脚本
            restart_mihomo
            log_msg "mihomo 已重启以应用新订阅"
            
            rm -f "${LOCK_FILE}"
            return 0
        fi
        log_msg "订阅文件无效"
        rm -f "${sub_cache_path}.tmp"
    else
        log_msg "订阅下载失败"
        rm -f "${sub_cache_path}.tmp"
    fi
    rm -f "${LOCK_FILE}"
    return 1
}

main_loop() {
    log_msg "refresh_sub 守护进程 v2 启动"
    log_msg "数据目录: ${TRIM_PKGVAR}"
    log_msg "配置目录: ${TRIM_PKGETC}"
    
    while true; do
        if check_should_run; then
            do_refresh
        else
            log_msg "不满足运行条件（需远程订阅且刷新间隔>0）"
        fi
        sleep "$(get_interval_seconds)"
    done
}

trap 'log_msg "收到退出信号"; rm -f "${LOCK_FILE}"; exit 0' TERM INT
main_loop
