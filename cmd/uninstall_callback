#!/bin/bash

# MiProxy 卸载完成后的回调脚本
# 负责停止服务、清理进程等清理工作

set -e

VAR_DIR="${TRIM_PKGVAR}"
LOG_FILE="${VAR_DIR}/info.log"
PID_FILE="${VAR_DIR}/app.pid"
REFRESH_PID_FILE="${VAR_DIR}/refresh_subscription.pid"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

# 停止订阅刷新守护进程
if [ -f "${REFRESH_PID_FILE}" ]; then
    pid=$(head -n 1 "${REFRESH_PID_FILE}" | tr -d '[:space:]')
    if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
        kill -9 "${pid}" 2>/dev/null || true
    fi
    rm -f "${REFRESH_PID_FILE}"
fi

# 停止 miproxy 主进程
if [ -f "${PID_FILE}" ]; then
    pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
    if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
        kill -TERM "${pid}" 2>/dev/null || true
        sleep 1
        kill -9 "${pid}" 2>/dev/null || true
    fi
    rm -f "${PID_FILE}"
fi

# 清理 socket 文件
SOCKET_PATH="${TRIM_APPDEST}/miproxy.sock"
rm -f "${SOCKET_PATH}"

log_msg "卸载完成"
exit 0
