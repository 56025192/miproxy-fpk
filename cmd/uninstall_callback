#!/bin/bash
#
# MiProxy 卸载回调
# 功能：根据 wizard_data_action 决定是否保留数据
#

set +e

echo "[$(date "+%Y-%m-%d %H:%M:%S")] uninstall_callback: 开始卸载..."

# 获取卸载选项
DATA_ACTION="${wizard_data_action:-keep}"

if [ "$DATA_ACTION" = "delete" ]; then
    echo "[$(date "+%Y-%m-%d %H:%M:%S")] uninstall_callback: 选择删除全部数据"
    
    # 停止服务
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    bash "${SCRIPT_DIR}/main" stop 2>/dev/null || true
    
    # ============================================
    # 使用 TRIM_* 变量清理所有应用目录
    # ============================================
    
    # 1. TRIM_APPDEST - 已安装的 target 目录
    # 对应: /var/apps/miproxy/target -> /vol*/@appcenter/miproxy
    if [ -n "${TRIM_APPDEST}" ] && [ -d "${TRIM_APPDEST}" ]; then
        echo "[$(date "+%Y-%m-%d %H:%M:%S")] 删除应用目录: ${TRIM_APPDEST}"
        rm -rf "${TRIM_APPDEST:?}"/* 2>/dev/null || true
    fi
    
    # 2. TRIM_PKGETC - 应用配置目录
    # 对应: /var/apps/miproxy/etc -> /vol*/@appconf/miproxy
    if [ -n "${TRIM_PKGETC}" ] && [ -d "${TRIM_PKGETC}" ]; then
        echo "[$(date "+%Y-%m-%d %H:%M:%S")] 删除配置目录: ${TRIM_PKGETC}"
        rm -rf "${TRIM_PKGETC:?}"/* 2>/dev/null || true
        rm -rf "${TRIM_PKGETC:?}"/.* 2>/dev/null || true
    fi
    
    # 3. TRIM_PKGVAR - 运行时数据目录
    # 对应: /var/apps/miproxy/var -> /vol*/@appdata/miproxy
    if [ -n "${TRIM_PKGVAR}" ] && [ -d "${TRIM_PKGVAR}" ]; then
        echo "[$(date "+%Y-%m-%d %H:%M:%S")] 删除数据目录: ${TRIM_PKGVAR}"
        rm -rf "${TRIM_PKGVAR:?}"/* 2>/dev/null || true
        rm -rf "${TRIM_PKGVAR:?}"/.* 2>/dev/null || true
    fi
    
    # 4. TRIM_PKGTMP - 临时目录
    # 对应: /var/apps/miproxy/tmp -> /vol*/@apptemp/miproxy
    if [ -n "${TRIM_PKGTMP}" ] && [ -d "${TRIM_PKGTMP}" ]; then
        echo "[$(date "+%Y-%m-%d %H:%M:%S")] 删除临时目录: ${TRIM_PKGTMP}"
        rm -rf "${TRIM_PKGTMP:?}"/* 2>/dev/null || true
        rm -rf "${TRIM_PKGTMP:?}"/.* 2>/dev/null || true
    fi
    
    # 5. TRIM_PKGHOME - 应用用户数据目录
    # 对应: /var/apps/miproxy/home -> /vol*/@apphome/miproxy
    if [ -n "${TRIM_PKGHOME}" ] && [ -d "${TRIM_PKGHOME}" ]; then
        echo "[$(date "+%Y-%m-%d %H:%M:%S")] 删除用户数据目录: ${TRIM_PKGHOME}"
        rm -rf "${TRIM_PKGHOME:?}"/* 2>/dev/null || true
        rm -rf "${TRIM_PKGHOME:?}"/.* 2>/dev/null || true
    fi
    
    # 6. TRIM_PKGMETA - 元数据目录
    # 对应: /var/apps/miproxy/meta
    if [ -n "${TRIM_PKGMETA}" ] && [ -d "${TRIM_PKGMETA}" ]; then
        echo "[$(date "+%Y-%m-%d %H:%M:%S")] 删除元数据目录: ${TRIM_PKGMETA}"
        rm -rf "${TRIM_PKGMETA:?}"/* 2>/dev/null || true
        rm -rf "${TRIM_PKGMETA:?}"/.* 2>/dev/null || true
    fi
    
    # 7. 清理 PID 文件
    rm -f "${TRIM_PKGVAR}/app.pid" 2>/dev/null || true
    rm -f "${TRIM_PKGVAR}/refresh_sub.pid" 2>/dev/null || true
    rm -f "${TRIM_PKGVAR}/refresh_sub.lock" 2>/dev/null || true
    
    echo "[$(date "+%Y-%m-%d %H:%M:%S")] uninstall_callback: 所有数据已删除"
else
    echo "[$(date "+%Y-%m-%d %H:%M:%S")] uninstall_callback: 保留数据"
fi

echo "[$(date "+%Y-%m-%d %H:%M:%S")] uninstall_callback: 卸载完成"
exit 0

