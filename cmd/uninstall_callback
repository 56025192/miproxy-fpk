#!/bin/bash
#
# MiProxy 卸载回调
# 功能：根据 wizard_data_action 决定是否保留数据
#

set +e

# 路径配置
VAR_DIR="${TRIM_PKGVAR:-/var/packages/miproxy/var}"

echo "[$(date '+%Y-%m-%d %H:%M:%S')] uninstall_callback: 开始卸载..."

# 获取卸载选项（默认保留数据）
DATA_ACTION="${wizard_data_action:-keep}"

if [ "$DATA_ACTION" = "delete" ]; then
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] uninstall_callback: 删除全部数据"
    
    # 删除所有数据目录内容
    if [ -d "$VAR_DIR" ]; then
        rm -rf "$VAR_DIR"/*
    fi
    
    # 尝试删除数据备份目录（如果存在）
    for backup_dir in /var/packages/miproxy/var_backup /tmp/miproxy_backup; do
        if [ -d "$backup_dir" ]; then
            rm -rf "$backup_dir" 2>/dev/null || true
        fi
    done
    
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] uninstall_callback: 所有数据已删除"
else
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] uninstall_callback: 保留数据（下次安装可继续使用）"
fi

echo "[$(date '+%Y-%m-%d %H:%M:%S')] uninstall_callback: 卸载完成"
exit 0
