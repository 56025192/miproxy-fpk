#!/bin/bash

# MiProxy 卸载后回调脚本
# 职责：清理残留文件（默认不保留数据）

DATA_ACTION="${wizard_data_action:-delete}"
LOG_FILE="/tmp/miproxy_uninstall.log"
exec >>"${LOG_FILE}" 2>&1

echo ""
echo "$(date '+%Y-%m-%d %H:%M:%S') uninstall_callback: 用户选择=${DATA_ACTION}"

# 收集需要清理的路径
CLEAN_PATHS=(
    "${TRIM_PKGVAR}"
    "${TRIM_PKGETC}"
)

if [ "${DATA_ACTION}" = "delete" ]; then
    echo "删除模式：清理所有数据..."
    for path in "${CLEAN_PATHS[@]}"; do
        [ -e "${path}" ] && rm -rf "${path}" 2>/dev/null && echo "已删除: ${path}"
    done
    
    # 清理进程
    pkill -KILL -x mihomo 2>/dev/null || true
    echo "删除完成"
else
    echo "保留模式：不清理数据"
fi

exit 0
