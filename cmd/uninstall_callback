#!/bin/bash
#
# MiProxy 卸载回调
# 功能：根据 wizard_data_action 决定是否保留数据
#

set +e

# 路径配置
VAR_DIR="/var/packages/miproxy/var"

echo "[$(date '+%Y-%m-%d %H:%M:%S')] uninstall_callback: 开始卸载..."

# 获取卸载选项（默认保留数据）
DATA_ACTION="${wizard_data_action:-keep}"
CONFIRM_DELETE="${wizard_confirm_delete:-}"

if [ "$DATA_ACTION" = "delete" ]; then
    # 如果选择删除，需要确认用户输入了 DELETE
    if [ -n "$CONFIRM_DELETE" ] && [ "$CONFIRM_DELETE" = "DELETE" ]; then
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] uninstall_callback: 确认删除全部数据"
        
        # 删除主数据目录
        if [ -d "$VAR_DIR" ]; then
            rm -rf "$VAR_DIR"/* 2>/dev/null || true
            rm -rf "$VAR_DIR"/.* 2>/dev/null || true
        fi
        
        # 删除备份目录（如果存在）
        rm -rf /var/packages/miproxy/var_backup 2>/dev/null || true
        rm -rf /tmp/miproxy_backup 2>/dev/null || true
        
        # 删除整个 VAR_DIR 目录（如果为空）
        rmdir "$VAR_DIR" 2>/dev/null || true
        
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] uninstall_callback: 所有数据已删除"
    else
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] uninstall_callback: 未确认删除，保留数据"
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] uninstall_callback: 如需删除，请输入 DELETE 确认"
    fi
else
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] uninstall_callback: 保留数据（下次安装可继续使用）"
fi

echo "[$(date '+%Y-%m-%d %H:%M:%S')] uninstall_callback: 卸载完成"
exit 0
