#!/bin/bash
# MiProxy 卸载回调脚本

TRIM_PKGVAR="${TRIM_PKGVAR:-/mnt/sysdata/appdata/miproxy}"
TRIM_PKGETC="${TRIM_PKGETC:-/mnt/sysdata/config/miproxy}"
PID_FILE="${TRIM_PKGVAR}/app.pid"
CONFIG_FILE="${TRIM_PKGVAR}/config.yaml"
SETTINGS_FILE="${TRIM_PKGETC}/settings.conf"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1"
}

# 获取卸载模式 (data_action: keep=保留数据, delete=删除全部)
DATA_ACTION=$(grep '^data_action=' "${SETTINGS_FILE}" 2>/dev/null | cut -d= -f2 | tr -d ' \n')
DATA_ACTION="${DATA_ACTION:-keep}"

log_msg "开始卸载 MiProxy (模式: ${DATA_ACTION})"

# 停止服务
if [ -f "${PID_FILE}" ]; then
    pid=$(cat "${PID_FILE}" 2>/dev/null)
    if [ -n "${pid}" ]; then
        kill "${pid}" 2>/dev/null
        log_msg "已停止服务 (PID: ${pid})"
    fi
    rm -f "${PID_FILE}"
fi

# 根据卸载模式处理数据
case "${DATA_ACTION}" in
    delete)
        log_msg "执行完全删除模式..."
        
        # 删除所有数据
        rm -rf "${TRIM_PKGVAR}" 2>/dev/null
        rm -rf "${TRIM_PKGETC}" 2>/dev/null
        
        log_msg "已删除全部数据"
        ;;
    keep|*)
        log_msg "执行保留数据模式..."
        
        # 只删除运行时数据，保留配置
        rm -f "${PID_FILE}" 2>/dev/null
        rm -f "${CONFIG_FILE}" 2>/dev/null
        rm -f "${TRIM_PKGVAR}/info.log" 2>/dev/null
        
        # 保留 settings.conf 和 ui 目录
        log_msg "配置文件已保留在 ${TRIM_PKGETC}"
        ;;
esac

log_msg "卸载完成"
exit 0
