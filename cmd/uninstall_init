#!/bin/bash
#
# MiProxy 卸载前回调
# 功能：停止服务，确保可以安全卸载
#

set +e

# 路径配置
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "[$(date '+%Y-%m-%d %H:%M:%S')] uninstall_init: 停止服务..."

# 停止主服务
bash "${SCRIPT_DIR}/main" stop 2>/dev/null || true

echo "[$(date '+%Y-%m-%d %H:%M:%S')] uninstall_init: 服务已停止"
exit 0
