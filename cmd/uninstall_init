#!/bin/bash
#
# MiProxy 卸载前回调
# 功能：停止服务，确保可以安全卸载
#

set +e

echo "[$(date "+%Y-%m-%d %H:%M:%S")] uninstall_init: 开始卸载前准备..."

# 获取卸载选项
DATA_ACTION="${wizard_data_action:-keep}"

# 停止主服务
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
bash "${SCRIPT_DIR}/main" stop 2>/dev/null || true

# 强制终止可能的残留进程
pkill -f mihomo 2>/dev/null || true

echo "[$(date "+%Y-%m-%d %H:%M:%S")] uninstall_init: 服务已停止"
echo "[$(date "+%Y-%m-%d %H:%M:%S")] uninstall_init: 卸载准备完成"
exit 0

