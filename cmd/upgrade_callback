#!/bin/bash
#
# MiProxy 升级后回调
# 功能：升级完成后启动服务
#

set +e

LOG_FILE="${TRIM_PKGVAR}/upgrade_callback.log"
mkdir -p "$(dirname "${LOG_FILE}")"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

log_msg "upgrade_callback: 升级完成，启动服务..."

bash "${SCRIPT_DIR}/main" start 2>>"${LOG_FILE}" || true

log_msg "upgrade_callback: 升级完成，服务已启动"
exit 0
