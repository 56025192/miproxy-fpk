#!/bin/bash
#
# MiProxy 升级后回调
# 功能：升级完成后启动服务
#

set +e

# 路径配置
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "[$(date '+%Y-%m-%d %H:%M:%S')] upgrade_callback: 升级完成，启动服务..."

# 启动服务
bash "${SCRIPT_DIR}/main" start 2>/dev/null || true

echo "[$(date '+%Y-%m-%d %H:%M:%S')] upgrade_callback: 升级完成"
exit 0
