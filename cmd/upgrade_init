#!/bin/bash
#
# MiProxy 升级前回调
# 功能：平滑停止服务，为升级做准备
#

set +e

# 路径配置
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "[$(date '+%Y-%m-%d %H:%M:%S')] upgrade_init: 升级前准备..."

# 停止服务
bash "${SCRIPT_DIR}/main" stop 2>/dev/null || true

echo "[$(date '+%Y-%m-%d %H:%M:%S')] upgrade_init: 服务已停止，准备升级"
exit 0
