#!/bin/bash
#
# MiProxy 升级前回调
# 功能：平滑停止服务，为升级做准备
#

set +e

LOG_FILE="${TRIM_PKGVAR}/upgrade_init.log"
mkdir -p "$(dirname "${LOG_FILE}")"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

log_msg "upgrade_init: 升级前准备，停止服务..."

bash "${SCRIPT_DIR}/main" stop 2>>"${LOG_FILE}" || true

log_msg "upgrade_init: 服务已停止，准备升级"
exit 0
