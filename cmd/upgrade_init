#!/bin/bash
#
# MiProxy 升级前回调
# 功能：平滑停止服务，为升级做准备
#

set +e

LOG_FILE="${TRIM_PKGVAR}/log/upgrade_init.log"
mkdir -p "${TRIM_PKGVAR}/log"

# 迁移旧日志文件（v2.6.38+ 统一归档到 log/）
[ -f "${TRIM_PKGVAR}/upgrade_init.log" ] && cat "${TRIM_PKGVAR}/upgrade_init.log" >> "${TRIM_PKGVAR}/log/upgrade_init.log" 2>/dev/null && rm -f "${TRIM_PKGVAR}/upgrade_init.log"
[ -f "${TRIM_PKGVAR}/upgrade_callback.log" ] && cat "${TRIM_PKGVAR}/upgrade_callback.log" >> "${TRIM_PKGVAR}/log/upgrade_callback.log" 2>/dev/null && rm -f "${TRIM_PKGVAR}/upgrade_callback.log"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

log_msg "upgrade_init: 升级前准备，停止服务..."

bash "${SCRIPT_DIR}/main" stop 2>>"${LOG_FILE}" || true

log_msg "upgrade_init: 服务已停止，准备升级"
exit 0
