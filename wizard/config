[
  {
    "stepTitle": "用户验证",
    "items": [
      {
        "type": "tips",
        "helpText": "设置面板访问的用户名和密码。不设置则无需验证即可访问控制面板。"
      },
      {
        "type": "text",
        "field": "wizard_username",
        "label": "用户名",
        "initValue": "",
        "placeholder": "留空则不启用验证",
        "rules": [
          { "min": 0, "message": "" }
        ]
      },
      {
        "type": "text",
        "field": "wizard_password",
        "label": "密码",
        "initValue": "",
        "placeholder": "留空则不启用验证",
        "rules": [
          { "min": 0, "message": "" }
        ]
      }
    ]
  },
  {
    "stepTitle": "订阅管理",
    "items": [
      {
        "type": "tips",
        "helpText": "修改订阅后点击保存，代理会自动重新拉取并重启。"
      },
      {
        "type": "text",
        "field": "wizard_sub_url",
        "label": "远程订阅 URL",
        "initValue": "",
        "rules": [
          { "pattern": "^https?://.*|^$", "message": "请输入正确的 URL 格式" }
        ]
      },
      {
        "type": "text",
        "field": "wizard_sub_path",
        "label": "本地订阅文件路径",
        "initValue": "",
        "rules": [
          { "min": 0, "message": "请输入文件路径" }
        ]
      },
      {
        "type": "radio",
        "field": "wizard_refresh_interval",
        "label": "自动刷新订阅",
        "defaultValue": "6",
        "options": [
          { "value": "0",  "label": "禁用 — 仅手动刷新" },
          { "value": "1",  "label": "每 1 小时" },
          { "value": "6",  "label": "每 6 小时" },
          { "value": "12", "label": "每 12 小时" },
          { "value": "24", "label": "每 24 小时" }
        ],
        "rules": [{ "required": true, "message": "请选择刷新间隔" }]
      }
    ]
  },
  {
    "stepTitle": "关于",
    "items": [
      {
        "type": "tips",
        "helpText": "📂 配置文件目录: /vol1/@appdata/miproxy/\n\n📄 主配置: config.yaml\n📄 订阅: subscription.yaml\n📄 日志: info.log\n\n🎯 桌面入口点击后选择控制面板打开\n   - Zashboard（推荐）\n   - MetaCubeXD\n\n版本: v2.5.1 | MiProxy"
      }
    ]
  }
]
