[
  {
    "stepTitle": "代理用户验证",
    "items": [
      {
        "type": "tips",
        "helpText": "设置 HTTP/SOCKS5/Mixed 代理连接的用户名和密码。"
      },
      {
        "type": "text",
        "field": "wizard_proxy_user",
        "label": "代理用户名",
        "initValue": "",
        "placeholder": "留空则不启用代理验证",
        "rules": [
          { "min": 0, "message": "" }
        ]
      },
      {
        "type": "text",
        "field": "wizard_proxy_pass",
        "label": "代理密码",
        "initValue": "",
        "placeholder": "留空则不启用代理验证",
        "rules": [
          { "min": 0, "message": "" }
        ]
      }
    ]
  },
  {
    "stepTitle": "控制面板密钥",
    "items": [
      {
        "type": "tips",
        "helpText": "设置控制面板（Dashboard）的访问密钥。用于 API 调用时的身份验证。"
      },
      {
        "type": "text",
        "field": "wizard_secret",
        "label": "面板密钥",
        "initValue": "",
        "placeholder": "留空则不启用密钥验证",
        "rules": [
          { "min": 0, "message": "" }
        ]
      }
    ]
  },
  {
    "stepTitle": "订阅管理",
    "items": [
      {
        "type": "tips",
        "helpText": "修改订阅后点击保存，代理会自动重新拉取并重启。"
      },
      {
        "type": "text",
        "field": "wizard_sub_url",
        "label": "远程订阅 URL",
        "initValue": "",
        "rules": [
          { "pattern": "^https?://.*|^$", "message": "请输入正确的 URL 格式" }
        ]
      },
      {
        "type": "text",
        "field": "wizard_sub_path",
        "label": "本地订阅文件路径",
        "initValue": "",
        "rules": [
          { "min": 0, "message": "请输入文件路径" }
        ]
      },
      {
        "type": "radio",
        "field": "wizard_refresh_interval",
        "label": "自动刷新订阅",
        "defaultValue": "6",
        "options": [
          { "value": "0",  "label": "禁用 — 仅手动刷新" },
          { "value": "1",  "label": "每 1 小时" },
          { "value": "6",  "label": "每 6 小时" },
          { "value": "12", "label": "每 12 小时" },
          { "value": "24", "label": "每 24 小时" }
        ],
        "rules": [{ "required": true, "message": "请选择刷新间隔" }]
      }
    ]
  },
  {
    "stepTitle": "关于",
    "items": [
      {
        "type": "tips",
        "helpText": "📂 配置文件目录: /vol1/@appdata/miproxy/\n\n📄 主配置: config.yaml\n📄 订阅: subscription.yaml\n📄 日志: info.log\n\n🎯 默认打开 Zashboard 控制面板\n\n版本: v2.6.10 | MiProxy"
      }
    ]
  }
]
